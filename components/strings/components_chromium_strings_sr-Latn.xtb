<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sr-Latn">
<translation id="130631256467250065">Promene će stupiti na snagu kada sledeći put ponovo pokrenete uređaj.</translation>
<translation id="275588974610408078">Izveštavanje o otkazivanjima nije dostupno u Taktak-u.</translation>
<translation id="3064346599913645280">Gledate bezbednu Taktak stranicu.</translation>
<translation id="3255926992597692024">Taktak pokušava da izmeni podešavanja za popunjavanje načina plaćanja.</translation>
<translation id="358997566136285270">Taktak logotip</translation>
<translation id="4050599136622776556">Taktak pokušava da izmeni načine plaćanja.</translation>
<translation id="4365115785552740256">Taktak omogućavaju <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> projekat otvorenog koda i drugi <ph name="BEGIN_LINK_OSS" />softver otvorenog koda<ph name="END_LINK_OSS" />.</translation>
<translation id="4559775032954821361">Idite u
          Taktak meni &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          LAN Settings (Podešavanja lokalne mreže)
          i opozovite izbor u polju za potvrdu „Use a proxy server for your LAN“ (Koristi proksi server za lokalnu mrežu).</translation>
<translation id="4622039161600275920">Taktak blokira ovu stranicu</translation>
<translation id="48558539577516920">Dozvolite Taktak-u da pristupa mreži u zaštitnom zidu ili antivirusnim
          podešavanjima.</translation>
<translation id="4949828774841497663">Idite u Applications (Aplikacije) &gt; System Settings (Podešavanja sistema) &gt; Network (Mreža), pa izaberite
          aktivnu mrežu, kliknite na dugme Details... (Detalji), a zatim poništite izbor svih proksija
          koji su izabrani.</translation>
<translation id="580822234363523061">Idite u
          Taktak meni &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          i proverite da li je konfiguracija podešena na „no proxy“ (bez proksija) ili „direct“ (direktno).</translation>
<translation id="648062525172759633">Ove stranice su namenjene programerima Taktak-a i možda se ne održavaju niti testiraju aktivno. Da biste ih omogućili, idite na <ph name="BEGIN_LINK" />Taktak://Taktak-urls<ph name="LINK_END" />, kliknite na dugme da biste omogućili stranice za otklanjanje grešaka, pa ponovo idite na ovu stranicu.</translation>
<translation id="6549378540556750549">Taktak omogućava i drugi <ph name="BEGIN_LINK_OSS" />softver otvorenog koda<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Promene će stupiti na snagu kada sledeći put ponovo pokrenete Taktak.</translation>
<translation id="691026815377248078">Taktak zahteva pristup Bluetooth-u radi nastavljanja sa 
 uparivanjem. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Taktak omogućava <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> projekat otvorenog koda.</translation>
<translation id="7861509383340276692">Otvorite
          Taktak meni &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          i opozovite izbor opcije „<ph name="NO_PREFETCH_DESCRIPTION" />“.
          Ako vam to ne reši problem, preporučujemo da ponovo izaberete
          ovu opciju radi boljih performansi.</translation>
<translation id="8597726643333341451">Pregledate bezbednu Taktak for Testing stranicu</translation>
<translation id="8684913864886094367">Taktak se nije ispravno zatvorio.</translation>
</translationbundle>