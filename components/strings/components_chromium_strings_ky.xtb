<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ky">
<translation id="130631256467250065">Өзгөртүүлөрүңүз түзмөгүңүз өчүп күйгөндөн кийин күчүнө кирет.</translation>
<translation id="275588974610408078">Taktak'да каталар жөнүндө кабар берүү мүмкүн эмес.</translation>
<translation id="3064346599913645280">Коопсуз Taktak баракчасын карап жатасыз</translation>
<translation id="3255926992597692024">Taktak төлөм ыкмаларын толтуруу параметрлерин өзгөртүүгө аракет кылууда.</translation>
<translation id="358997566136285270">Taktak логотиби</translation>
<translation id="4050599136622776556">Taktak төлөм ыкмаларын түзөтүүгө аракет кылууда.</translation>
<translation id="4365115785552740256">Taktak <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> ачык булак долбоору жана башка <ph name="BEGIN_LINK_OSS" />ачык программа<ph name="END_LINK_OSS" /> аркылуу мүмкүн болду.</translation>
<translation id="4559775032954821361">Төмөнкүгө өтүп, 
          Taktak меню &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          LAN параметрлери
          жана "LAN үчүн прокси сервер колдонулсун" белгиленме кутусун тандоодон чыгарыңыз.</translation>
<translation id="4622039161600275920">Бул баракты Taktak бөгөттөп койду</translation>
<translation id="48558539577516920">Taktak'га коргоо системасында тармакка же антивирус параметрлерине кирүүгө уруксат
          бериңиз.</translation>
<translation id="4949828774841497663">Төмөнкүгө өтүңүз Колдонмолор &gt; Тутумдун параметрлери &gt; Тармак, 
          жигердүү тармакты тандап, Чоо-жайы... баскычын чыкылдатып, колдонулган проксилерди
          тандоодон чыгарыңыз.</translation>
<translation id="580822234363523061">Төмөнкүгө өтүп:
          Taktak менюсу &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          "прокси жок" же "түздөн-түз" деген жөндөөлөр коюлгандыгын текшериңиз.</translation>
<translation id="648062525172759633">Бул беттер Taktak иштеп чыгуучуларына арналган жана жигердүү түрдө иштетилип же сыналбашы мүмкүн. Аларды иштетүү үчүн <ph name="BEGIN_LINK" />Taktak://Taktak-urls<ph name="LINK_END" /> бөлүмүнө өтүп, мүчүлүштүктөрдү оңдоо беттерин иштетүү үчүн баскычты басып, бул бетке кайтып келиңиз.</translation>
<translation id="6549378540556750549">Taktak башка <ph name="BEGIN_LINK_OSS" />ачык ресурс программасы<ph name="END_LINK_OSS" /> аркылуу да жеткиликтүү.</translation>
<translation id="6613594504749178791">Өзгөртүүлөрүңүз Taktak кийинки жолу кайра ишке киргизилгенде күчүнө кирет.</translation>
<translation id="691026815377248078">Жупташтырууну улантуу үчүн Taktak Bluetooth'ду 
 пайдаланууга уруксат алышы керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Taktak <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> ачык ресурс долбоору аркылуу түзүлдү.</translation>
<translation id="7861509383340276692">Taktak меню &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        өтүп, "<ph name="NO_PREFETCH_DESCRIPTION" />" дегенди тандоодон чыгарыңыз.
        Эгер ушуну менен маселе чечилбесе, иштин майнаптуулугун жогорулатуу үчүн бул параметрди  
        кайра тандаңыз.</translation>
<translation id="8597726643333341451">Коопсуз Taktak for Testing баракчасын карап жатасыз</translation>
<translation id="8684913864886094367">Taktak туура эмес жабылып калды.</translation>
</translationbundle>