<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sw">
<translation id="130631256467250065">Mabadiliko yako yatatekelezwa utakapowasha upya tena kifaa chako.</translation>
<translation id="275588974610408078">Kuripoti uharibifu hakupatikana katika Taktak.</translation>
<translation id="3064346599913645280">Unaangalia ukurasa salama wa Taktak</translation>
<translation id="3255926992597692024">Taktak inajaribu kurekebisha mipangilio kwa ajili ya kujaza njia za kulipa.</translation>
<translation id="358997566136285270">Nembo ya Taktak</translation>
<translation id="4050599136622776556">Taktak inajaribu kubadilisha njia za kulipa.</translation>
<translation id="4365115785552740256">Taktak imerahisishwa na mradi wa programu huria ya <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> na programu nyingine <ph name="BEGIN_LINK_OSS" />huria<ph name="END_LINK_OSS" />.</translation>
<translation id="4559775032954821361">Nenda kwenye
         menyu ya Taktak &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Mipangilio ya LAN
         na uondoe tiki "Tumia seva ya proksi kwa kikasha kaguzi chako cha LAN".</translation>
<translation id="4622039161600275920">Ukurasa huu umezuiwa na Taktak</translation>
<translation id="48558539577516920">Ruhusu Taktak ifikie mtandao kwenye mipangilio yako ya kinga mtandao au kingavirusi.</translation>
<translation id="4949828774841497663">Nenda kwenye Programu &gt; Mipangilio ya Mfumo &gt; Mtandao, chagua
          mtandao unaotumika, bofya kitufe cha Maelezo... kisha uache kuchagua seva zozote mbadala
          ambazo huenda umechagua.</translation>
<translation id="580822234363523061">Nenda kwenye
          menyu ya Taktak &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
         na uhakikishe kuwa usanidi wako umewekwa kwenye "hakuna proksi" au "moja kwa moja."</translation>
<translation id="648062525172759633">Kurasa hizi zinanuiwa kutumiwa na wasanidi programu wa Taktak na huenda zisiweze kufanyiwa majaribio wala kudumishwa kila wakati. Ili uzifungue, nenda kwenye <ph name="BEGIN_LINK" />Taktak://Taktak-urls<ph name="LINK_END" />, bofya kitufe ili ufungue kurasa za utatuzi kisha urudi kwenye ukurasa huu tena.</translation>
<translation id="6549378540556750549">Taktak inawezeshwa pia na <ph name="BEGIN_LINK_OSS" />programu nyingine huria<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Mabadiliko yako yataanza kufanya kazi wakati ujao utakapozindua upya Taktak.</translation>
<translation id="691026815377248078">Taktak inahitaji ruhusa ya kufikia Bluetooth ili iendelee 
 kuoanisha. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Taktak inawezeshwa na mradi wa programu huria wa <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="7861509383340276692">Nenda kwenye
        menyu ya Taktak &gt;
        <ph name="SETTINGS_TITLE" />
        <ph name="ADVANCED_TITLE" />na uondoe tiki kwenye "<ph name="NO_PREFETCH_DESCRIPTION" />."
        Ikiwa hili halitatatua tatizo, tunapendekeza uchague tena chaguo hili kwa utendaji ulioboreshwa.</translation>
<translation id="8597726643333341451">Unaangalia ukurasa salama wa Taktak ya Majaribio</translation>
<translation id="8684913864886094367">Taktak haikuzimika kwa njia sahihi.</translation>
</translationbundle>