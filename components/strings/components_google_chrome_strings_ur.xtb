<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ur">
<translation id="1016765312371154165">‏Taktak صحیح سے بند نہیں ہوا ہے۔</translation>
<translation id="130631256467250065">اپنا آلہ اگلی بار دوبارہ شروع کرنے پر آپ کی تبدیلیاں مؤثر ہوں گی۔</translation>
<translation id="1516530951338665275">‏جوڑا بنانا جاری رکھنے کیلئے Taktak Taktak کو بلوٹوتھ رسائی کی ضرورت ہے۔ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1635457557763038537">‏اگلی بار جب آپ Taktak بند کرکے دوبارہ شروع کریں گے تو آپ کی تبدیلیاں نافذ ہوں گی۔</translation>
<translation id="2399868464369312507">‏Taktak Taktak ادائیگی کے طریقوں میں ترمیم کرنے کی کوشش کر رہا ہے۔</translation>
<translation id="2447485272386224171">‏Taktak کو <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> اوپن سورس پروجیکٹ اور دیگر <ph name="BEGIN_LINK_OSS" />اوپن سورس سافٹ ویئر<ph name="END_LINK_OSS" /> کے ذریعے ممکن بنایا گیا ہے۔</translation>
<translation id="2588322182880276190">‏Taktak کا لوگو</translation>
<translation id="3444832043240812445">اگر آپ <ph name="BEGIN_LINK" />کریش کی اطلاع دہندگی فعال کرتے ہیں<ph name="END_LINK" /> تو یہ صفحہ صرف آپ کے حالیہ کریشز کی بابت معلومات کو دکھاتا ہے۔</translation>
<translation id="3512634283363927263">‏یہ صفحات Taktak کے ڈویلپرز کے استعمال کے ارادے سے ہیں اور ہو سکتا ہے کہ ان کی فعال طور پر دیکھ بھال یا جانچ نہ کی جائے۔ ان کو فعال کرنے کے لیے، <ph name="BEGIN_LINK" />Taktak://Taktak-urls<ph name="LINK_END" /> پر نیویگیٹ کریں، ڈیبگ صفحات کو فعال کرنے کے لیے بٹن پر کلک کریں اور پھر اس صفحہ پر دوبارہ نیویگیٹ کریں۔</translation>
<translation id="3875312571075912821">‏Taktak کو اپنے فائروال یا اینٹی وائرس کی
          ترتیبات میں نیٹ ورک تک رسائی حاصل کرنے کی اجازت دیں۔</translation>
<translation id="4949828774841497663">ایپلیکیشنز &gt; سسٹم کی ترتیبات &gt; نیٹ ورک پر جائیں، فعال نیٹ ورک منتخب کریں، تفصیلات... بٹن پر کلک کریں اور ممکنہ طور پر منتخب کردہ کسی بھی پراکسی کو غیر منتخب کریں۔</translation>
<translation id="5005121315113832363">‏اس صفحے کو Taktak نے مسدود کر دیا ہے</translation>
<translation id="6011049234605203654">‏Taktak مینیو &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          پر جائیں اور یقینی بنائیں کہ آپ کی کنفیگریشن "کوئی پراکسی نہیں" یا "ڈائریکٹ" پر سیٹ ہے۔</translation>
<translation id="6341737370356890233">‏Taktak مینیو &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          پر جائیں اور "<ph name="NO_PREFETCH_DESCRIPTION" />" کو غیر منتخب کریں۔
          اگر اس سے مسئلہ حل نہیں ہوتا ہے تو ہم بہتر کارکردگی کیلئے یہ اختیار دوبارہ منتخب کرنے
          کی تجویز کرتے ہیں۔</translation>
<translation id="6855094794438142393">‏Taktak مینیو &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          LAN ترتیبات
          پر جائیں
          اور "اپنے LAN کیلئے ایک پراکسی سرور استعمال کریں" کو غیر منتخب کریں۔</translation>
<translation id="7230956101631259640">‏آپ ایک محفوظ Taktak صفحہ دیکھ رہے ہیں</translation>
<translation id="8232971017369963250">‏Taktak کو <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> اوپن سورس پروجیکٹ کے ذریعے ممکن بنایا گیا ہے۔</translation>
<translation id="8279509328145658601">‏Taktak کو دوسرے <ph name="BEGIN_LINK_OSS" />اوپن سورس سافٹ ویئر<ph name="END_LINK_OSS" /> کے ذریعے بھی ممکن بنایا گیا ہے۔</translation>
<translation id="8544217240017914508">‏ادائیگی کے طریقوں کو پُر کرنے کی خاطر ترتیبات میں ترمیم کرنے کے لیے Taktak Taktak کوشش کر رہا ہے۔</translation>
</translationbundle>