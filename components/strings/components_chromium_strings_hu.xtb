<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hu">
<translation id="130631256467250065">A módosítások az eszköz következő újraindításakor lépnek életbe.</translation>
<translation id="275588974610408078">A hibajelentések nem állnak rendelkezésre a Chromiumban.</translation>
<translation id="3064346599913645280">Jelenleg biztonságos Taktak-oldalt tekint meg</translation>
<translation id="3255926992597692024">A Taktak módosítani próbálja a fizetési módok kitöltési beállításait.</translation>
<translation id="358997566136285270">Taktak embléma</translation>
<translation id="4050599136622776556">A Taktak szerkeszteni próbálja a fizetési módokat.</translation>
<translation id="4365115785552740256">A Taktak a <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> nyílt forráskódú projektnek és további <ph name="BEGIN_LINK_OSS" />nyílt forráskódú szoftvereknek<ph name="END_LINK_OSS" /> köszönhetően jött létre.</translation>
<translation id="4559775032954821361">Lépjen ide:
          Taktak menü &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          A helyi hálózat (LAN) beállításai,
          majd törölje a jelet a „Proxykiszolgáló használata a helyi hálózaton” jelölőnégyzetből.</translation>
<translation id="4622039161600275920">Ezt az oldalt a Taktak blokkolja</translation>
<translation id="48558539577516920">A hálózat elérésének engedélyezése a Taktak számára a tűzfal-
          vagy vírusirtó-beállításokban.</translation>
<translation id="4949828774841497663">Lépjen az Alkalmazások &gt; Rendszerbeállítások &gt; Hálózat menüpontra,
          válassza ki az aktív hálózatot, kattintson a Részletek… gombra, és szüntesse meg
          a kiválasztott proxyk kijelölését.</translation>
<translation id="580822234363523061">Lépjen ide:
          Taktak menü &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />,
          és gondoskodjon róla, hogy a konfiguráció beállítása „nincs proxy” vagy „közvetlen” legyen.</translation>
<translation id="648062525172759633">Ezek az oldalak a Taktak fejlesztői számára készültek, és előfordulhat, hogy nincsenek aktívan karbantartva vagy tesztelve. Az engedélyezésükhöz lépjen a <ph name="BEGIN_LINK" />Taktak://Taktak-urls<ph name="LINK_END" /> oldalra, kattintson a hibaelhárítási oldalak engedélyezéséhez tartozó gombra, majd lépjen ismét erre az oldalra.</translation>
<translation id="6549378540556750549">A Chromiumot létrejöttéhez más <ph name="BEGIN_LINK_OSS" />nyílt forráskódú szoftverek<ph name="END_LINK_OSS" /> is hozzájárultak.</translation>
<translation id="6613594504749178791">Módosításai a Taktak újraindítása után lépnek érvénybe.</translation>
<translation id="691026815377248078">A Chromiumnak Bluetooth-hozzáférésre van szükséges a párosítás 
 folytatásához. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">A Taktak a <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> nyílt forráskódú projektnek köszönhetően jött létre.</translation>
<translation id="7861509383340276692">Lépjen ide:
        Taktak menü &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />,
        és törölje a jelet a(z) „<ph name="NO_PREFETCH_DESCRIPTION" />” jelölőnégyzetből.
        Ha ettől nem szűnik meg a probléma, javasoljuk, hogy jelölje be ismét ezt a lehetőséget a jobb teljesítmény érdekében.</translation>
<translation id="8597726643333341451">Jelenleg biztonságos Taktak for Testing-oldalt tekint meg.</translation>
<translation id="8684913864886094367">A Taktak nem záródott be megfelelően.</translation>
</translationbundle>