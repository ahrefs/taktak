<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="130631256467250065">Өзгерістеріңіз құрылғыңызды келесі қайта іске қосқанда күшіне енеді.</translation>
<translation id="275588974610408078">Бұзылу туралы хабарлау мүмкіндігі Taktak қызметінде қолжетімді емес.</translation>
<translation id="3064346599913645280">Қауіпсіз Taktak бетін көрудесіз</translation>
<translation id="3255926992597692024">Taktak төлеу әдістерін толтыру параметрлерін өзгерткісі келеді.</translation>
<translation id="358997566136285270">Taktak логотипі</translation>
<translation id="4050599136622776556">Taktak төлеу әдістерін өзгерткісі келеді.</translation>
<translation id="4365115785552740256">Taktak қолданбасына <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> ашық бастапқы код жобасы мен басқа <ph name="BEGIN_LINK_OSS" />ашық бастапқы код бағдарламалық жасақтамасы<ph name="END_LINK_OSS" /> арқылы қол жеткізілді.</translation>
<translation id="4559775032954821361">"Taktak мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          LAN параметрлері" тармағына өтіп,
          "LAN желіңіз үшін прокси серверді пайдалану" құсбелгісін алып тастаңыз.</translation>
<translation id="4622039161600275920">Бұл бетке Taktak тарапынан тыйым салынған.</translation>
<translation id="48558539577516920">Брандмауэр немесе антивирус параметрлерінде Taktak жүйесіне
          желіге кіруге рұқсат беріңіз.</translation>
<translation id="4949828774841497663">"Қолданбалар &gt; Жүйе параметрлері &gt; Желі" тармағына өтіп, белсенді желіні таңдаңыз да, "Мәліметтер..." түймесін басып, бұрын таңдалған прокси-серверлерді таңдаудан алыңыз.</translation>
<translation id="580822234363523061">Taktak мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
           тармағына өтіп, конфигурацияңыз "проксисіз" немесе "тікелей" күйіне орнатылғандығын тексеріңіз.</translation>
<translation id="648062525172759633">Бұл беттер Taktak әзірлеушілерінің қолданысына арналған және белсенді түрде жүргізілмеуі не сыналмауы мүмкін. Оларды қосу үшін <ph name="BEGIN_LINK" />Taktak://Taktak-urls<ph name="LINK_END" /> сайтына өтіп, түзету беттерін қосатын түймені басып, осы бетке қайтып келіңіз.</translation>
<translation id="6549378540556750549">Сонымен қатар Taktak басқа <ph name="BEGIN_LINK_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="6613594504749178791">Өзгертулеріңіз Taktak келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="691026815377248078">Жұптауды жалғастыру үшін Taktak-ге Bluetooth-ты пайдалану рұқсаты керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Taktak браузері <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> ашық кодты бағдарлама жобасы арқылы қолжетімді болады.</translation>
<translation id="7861509383340276692">Taktak мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          тармағына өтіп, "<ph name="NO_PREFETCH_DESCRIPTION" />" таңдауын алып тастаңыз.
          Бұл мәселені шешпесе, өнімділікті жақсарту үшін осы опцияны қайта
          таңдауды ұсынамыз.</translation>
<translation id="8597726643333341451">Қауіпсіз Taktak for Testing бетін көріп отырсыз.</translation>
<translation id="8684913864886094367">Taktak дұрыс өшірілмеді.</translation>
</translationbundle>