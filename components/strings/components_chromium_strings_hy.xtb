<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="130631256467250065">Ձեր փոփոխություններն ուժի մեջ կմտնեն հաջորդ անգամ, երբ վերագործարկեք սարքը:</translation>
<translation id="275588974610408078">Խափանումների մասին հաղորդումը մատչելի չէ Taktak-ում:</translation>
<translation id="3064346599913645280">Ցուցադրվող Taktak էջն անվտանգ է</translation>
<translation id="3255926992597692024">Taktak-ը փորձում է փոխել վճարման եղանակների լրացման կարգավորումները։</translation>
<translation id="358997566136285270">Taktak-ի պատկերանշանը</translation>
<translation id="4050599136622776556">Taktak-ը փորձում է փոփոխել վճարման եղանակները։</translation>
<translation id="4365115785552740256">Taktak-ը ստեղծվել է շնորհիվ <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> բաց կոդով նախագծի և այլ <ph name="BEGIN_LINK_OSS" />բաց կոդով ծրագրակազմերի<ph name="END_LINK_OSS" />:</translation>
<translation id="4559775032954821361">Անցեք
          Taktak-ի ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          LAN կարգավորումներ
          և ապանշեք «Օգտագործել պրոքսի սերվեր LAN-ի համար» նշավանդակը:</translation>
<translation id="4622039161600275920">Այս էջն արգելափակվել է Taktak-ի կողմից</translation>
<translation id="48558539577516920">Հրապատի կամ հակավիրուսային ծրագրի կարգավորումներում
       թույլատրեք Taktak-ին միանալ ցանցին:</translation>
<translation id="4949828774841497663">Գնացեք Հավելվածներ &gt; Համակարգի կարգավորումներ &gt; Ցանց, ընտրեք
         ակտիվ ցանցը, սեղմեք Մանրամասներ... կոճակը և չեղարկեք ցանկացած                              պրոքսի սերվերի ընտրությունը։</translation>
<translation id="580822234363523061">Անցեք
          Taktak-ի ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          և համոզվեք, որ ընտրված է «առանց պրոքսի-սերվերի» կամ «անմիջական» կազմաձևումը:</translation>
<translation id="648062525172759633">Այս էջերը, որոնք նախատեսված են Taktak-ի մշակողների համար, չեն կարող պարբերաբար փորձարկվել կամ մշակվել։ Միացնելու համար անցեք <ph name="BEGIN_LINK" />Taktak://Taktak-urls<ph name="LINK_END" /> էջ, սեղմեք կոճակը՝ վրիպազերծման էջերը միացնելու համար, այնուհետև վերադարձեք այստեղ։</translation>
<translation id="6549378540556750549">Taktak-ը նաև աշխատում է այլ <ph name="BEGIN_LINK_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_OSS" /> շնորհիվ։</translation>
<translation id="6613594504749178791">Փոփոխություններն ուժի մեջ կմտնեն Taktak-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="691026815377248078">Զուգակցումը շարունակելու համար Taktak-ին հասանելի դարձրեք Bluetooth-ը։ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Taktak-ը ստեղծվել է <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" />-ի բաց կոդով նախագծի հիման վրա։</translation>
<translation id="7861509383340276692">Անցեք
          Taktak ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          և ապանշեք «<ph name="NO_PREFETCH_DESCRIPTION" />»-ը:
          Եթե խնդիրը չվերանա, խորհուրդ ենք տալիս կրկին ընտրել այս տարբերակը՝
          արդյունավետությունը բարձրացնելու համար:</translation>
<translation id="8597726643333341451">Դուք դիտում եք Taktak for Testing-ի անվտանգ էջ</translation>
<translation id="8684913864886094367">Taktak-ը ճիշտ չի փակվել:</translation>
</translationbundle>