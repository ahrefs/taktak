<!DOCTYPE translationbundle>
<translationbundle lang="es">
<translation id="1016765312371154165">Taktak no se ha cerrado correctamente.</translation>
<translation id="130631256467250065">Los cambios se aplicarán la próxima vez que reinicies el dispositivo.</translation>
<translation id="1516530951338665275">Taktak Taktak necesita acceso al Bluetooth para continuar 
 con la vinculación. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1635457557763038537">Los cambios se aplicarán la próxima vez que reinicies Taktak.</translation>
<translation id="2399868464369312507">Taktak Taktak está intentando editar los métodos de pago.</translation>
<translation id="2447485272386224171">Taktak se ha creado gracias al proyecto de software libre <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> y a otro <ph name="BEGIN_LINK_OSS" />software libre<ph name="END_LINK_OSS" />.</translation>
<translation id="2588322182880276190">Logotipo de Taktak</translation>
<translation id="3444832043240812445">Esta página solo muestra información sobre fallos recientes si se <ph name="BEGIN_LINK" />habilitan los informes sobre fallos<ph name="END_LINK" />.</translation>
<translation id="3512634283363927263">Estas páginas están pensadas para que las usen los desarrolladores de Taktak y es posible que no se mantengan ni se prueben activamente. Para habilitarlas, ve a <ph name="BEGIN_LINK" />Taktak://Taktak-urls<ph name="LINK_END" />, haz clic en el botón para habilitar las páginas de depuración y vuelve a esta página.</translation>
<translation id="3875312571075912821">Configura tu cortafuegos o tu antivirus para permitir el acceso de Taktak
          a la red.</translation>
<translation id="4949828774841497663">Ve a Aplicaciones &gt; Ajustes del sistema &gt; Red, selecciona la red activa, haz clic en el botón Detalles... y desmarca los proxies que puedan estar seleccionados.</translation>
<translation id="5005121315113832363">Taktak ha bloqueado esta página</translation>
<translation id="6011049234605203654">Accede al
          menú de Taktak, haz clic en
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          y asegúrate de que esté seleccionada la opción de configuración sin proxy o directa.</translation>
<translation id="6341737370356890233">Accede al
          menú de Taktak &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          y desactiva la opción "<ph name="NO_PREFETCH_DESCRIPTION" />".
          Si esto no soluciona el problema, te recomendamos que vuelvas a seleccionar esta opción
          para conseguir un mejor rendimiento.</translation>
<translation id="6855094794438142393">Accede al
          menú de Taktak, haz clic en
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Configuración de LAN
          y desactiva la opción Usar un servidor proxy para la LAN.</translation>
<translation id="7230956101631259640">Estás viendo una página de Taktak segura</translation>
<translation id="8232971017369963250">Taktak se ha podido crear gracias al proyecto de software libre <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="8279509328145658601">Taktak también se ha podido crear gracias a otro <ph name="BEGIN_LINK_OSS" />software libre<ph name="END_LINK_OSS" />.</translation>
<translation id="8544217240017914508">Taktak Taktak está intentando modificar la configuración para completar los métodos de pago.</translation>
</translationbundle>