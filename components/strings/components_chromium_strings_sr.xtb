<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sr">
<translation id="130631256467250065">Промене ће ступити на снагу када следећи пут поново покренете уређај.</translation>
<translation id="275588974610408078">Извештавање о отказивањима није доступно у Taktak-у.</translation>
<translation id="3064346599913645280">Гледате безбедну Taktak страницу.</translation>
<translation id="3255926992597692024">Taktak покушава да измени подешавања за попуњавање начина плаћања.</translation>
<translation id="358997566136285270">Taktak логотип</translation>
<translation id="4050599136622776556">Taktak покушава да измени начине плаћања.</translation>
<translation id="4365115785552740256">Taktak омогућавају <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> пројекат отвореног кода и други <ph name="BEGIN_LINK_OSS" />софтвер отвореног кода<ph name="END_LINK_OSS" />.</translation>
<translation id="4559775032954821361">Идите у
          Taktak мени &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          LAN Settings (Подешавања локалне мреже)
          и опозовите избор у пољу за потврду „Use a proxy server for your LAN“ (Користи прокси сервер за локалну мрежу).</translation>
<translation id="4622039161600275920">Taktak блокира ову страницу</translation>
<translation id="48558539577516920">Дозволите Taktak-у да приступа мрежи у заштитном зиду или антивирусним
          подешавањима.</translation>
<translation id="4949828774841497663">Идите у Applications (Апликације) &gt; System Settings (Подешавања система) &gt; Network (Мрежа), па изаберите
          активну мрежу, кликните на дугме Details... (Детаљи), а затим поништите избор свих проксија
          који су изабрани.</translation>
<translation id="580822234363523061">Идите у
          Taktak мени &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          и проверите да ли је конфигурација подешена на „no proxy“ (без проксија) или „direct“ (директно).</translation>
<translation id="648062525172759633">Ове странице су намењене програмерима Taktak-а и можда се не одржавају нити тестирају активно. Да бисте их омогућили, идите на <ph name="BEGIN_LINK" />Taktak://Taktak-urls<ph name="LINK_END" />, кликните на дугме да бисте омогућили странице за отклањање грешака, па поново идите на ову страницу.</translation>
<translation id="6549378540556750549">Taktak омогућава и други <ph name="BEGIN_LINK_OSS" />софтвер отвореног кода<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Промене ће ступити на снагу када следећи пут поново покренете Taktak.</translation>
<translation id="691026815377248078">Taktak захтева приступ Bluetooth-у ради настављања са 
 упаривањем. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Taktak омогућава <ph name="BEGIN_LINK_CHROMIUM" />Taktak<ph name="END_LINK_CHROMIUM" /> пројекат отвореног кода.</translation>
<translation id="7861509383340276692">Отворите
          Taktak мени &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          и опозовите избор опције „<ph name="NO_PREFETCH_DESCRIPTION" />“.
          Ако вам то не реши проблем, препоручујемо да поново изаберете
          ову опцију ради бољих перформанси.</translation>
<translation id="8597726643333341451">Прегледате безбедну Taktak for Testing страницу</translation>
<translation id="8684913864886094367">Taktak се није исправно затворио.</translation>
</translationbundle>