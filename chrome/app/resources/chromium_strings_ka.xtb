<translation id="4893347770495441059">ხელახლა გაშვება &amp;Taktak-ის გასაახლებლად</translation>
<translation id="4918844574251943176">სურათი დაკოპირდა</translation>
<translation id="4943838377383847465">Taktak ფონურ რეჟიმშია.</translation>
<translation id="494490797786467921">დააწკაპუნეთ Taktak-ის შესვლის დიალოგის დასახურად</translation>
<translation id="4950660488495335294">Taktak პროფილები Taktak-ში არსებული თქვენი კონტენტის განცალკევების საშუალებას გაძლევთ. შექმენით პროფილები ოჯახის წევრებისა და მეგობრებისთვის, ან განაცალკევეთ სამსახურებრივი და პირადი მონაცემები.</translation>
<translation id="4987820182225656817">სტუმრებს შეუძლიათ Taktak-ის გამოყენება და მისი ყველა ფუნქციით სარგებლობა.</translation>
<translation id="4994636714258228724">საკუთარი თავის დამატება Taktak-ში</translation>
<translation id="5123973130450702873">Taktak-ს სჭირდება ნებართვა თქვენი ხელების მოძრაობაზე თვალის მისადევნებლად</translation>
<translation id="5141988424377517949">ბოლო დროს არ ყოფილხართ. Taktak-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და <ph name="PERMISSION_3" />.</translation>
<translation id="5174969993834422967">როგორც წესი, თქვენ ბლოკავთ შეტყობინებებს. ამ საიტისგან შეტყობინებების მისაღებად დააწკაპუნეთ მდებარეობის ზოლის მარჯვენა კუთხეში მდებარე ხატულას.</translation>
<translation id="5187123684706427865">Taktak ანგარიში საჭიროებს ხელახლა ავტორიზაციას</translation>
<translation id="5224391634244552924">შენახული პაროლები არ არის. პაროლების შემოწმებას Taktak შეძლებს მათი შენახვის შემდეგ.</translation>
<translation id="5231355151045086930">Taktak-იდან გამოსვლა</translation>
<translation id="5234764350956374838">გაუქმება</translation>
<translation id="5254739261293693943">ამ ვიდეოსთან დაკავშირებით შეკითხვების დასმა</translation>
<translation id="5277894862589591112">ცვლილებების მისასადაგებლად ხელახლა გაუშვით Taktak</translation>
<translation id="5286907366254680517">ამოცნობილია</translation>
<translation id="5294316920224716406">ვების ინკოგნიტო რეჟიმში დათვალიერებისას Taktak გაგაფრთხილებთ საიტის დაუცველი კავშირის გამოყენებით ჩატვირთვამდე</translation>
<translation id="5296845517486664001">როცა ცდები ჩართულია და თუ Taktak შემთხვევითობის პრინციპით მიგაღებინებთ მონაწილეობას მიმდინარე ცდაში, თქვენ მიერ ვების დათვალიერების ისტორია აისახება თქვენთვის ხილულ რეკლამასა და თქვენს ინტერესებზე, ქვემოთ პროგნოზირებულის შესაბამისად. თქვენი კონფიდენციალურობის დაცვის მიზნით, Taktak წაშლის თქვენს ინტერესებს ყოველთვიურად რიგითობის მიხედვით.</translation>
<translation id="5313228254328109263">Taktak-ის განმაახლებელი შიდა სერვისი</translation>
<translation id="5352264705793813212">Taktak-მა თქვენთვის იპოვა უსაფრთხოებასთან დაკავშირებული რეკომენდაციები</translation>
<translation id="5352361688875342522">სხვა Taktak პროფილები</translation>
<translation id="5358375970380395591">მართული ანგარიშით შედიხართ სისტემაში და ადმინისტრატორს თქვენს Taktak-ის პროფილზე კონტროლს აძლევთ. თქვენი Taktak ის მონაცემები როგორიცაა თქვენი აპლიკაციები, სანიშნები, ისტორიები, პაროლები, და სხვა პარამეტრები მუდმივად მიბმული გახდება <ph name="USER_NAME" />-თან. ამ მონაცემების წაშლას Taktak ანგარიშის საინფორმაციო დაფის გზით შეძლებთ, მაგრამ შეუძლებელი იქნება ამ მონაცემების სხვა ანგარიშთან გაერთიანება. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">დამატებითი კოდი: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">პერსონალიზაციით რომ ისარგებლოთ, დაურთეთ Taktak ვებსა და აპებში აქტივობას</translation>
<translation id="5383439451358640070">შეიტყვეთ, რატომ ბლოკავს Taktak ზოგიერთ ფაილს</translation>
<translation id="5386450000063123300">მიმდინარეობს Taktak-ის განახლება (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Taktak-ში შესვლის დაშვება</translation>
<translation id="5405650547142096840">Taktak-იდან ამოღება</translation>
<translation id="5424544524441439284">ამცირებს წარმადობას, თუმცა Taktak შეტევების წინაშე უფრო მდგრადი იქნება</translation>
<translation id="5427571867875391349">დააყენეთ Taktak ნაგულისხმევ ბრაუზერად</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> — Taktak Beta</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Taktak გირჩევთ, დააპაუზოთ ჩანართი, რომელიც ანელებს თქვენი ბრაუზერის მუშაობას}other{Taktak გირჩევთ, დააპაუზოთ ჩანართები, რომლებიც ანელებს თქვენი ბრაუზერის მუშაობას}}</translation>
<translation id="5473971139929175403">Taktak-მა შეიძლება არასწორად იმუშაოს, რადგან ის აღარ არის მხარდაჭერილი ამ Linux დისტრიბუტივზე</translation>
<translation id="5475924890392386523">Taktak-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ფაილს შეუძლია თქვენი პირადი და სოციალური ქსელების ანგარიშების დაზიანება.</translation>
<translation id="5480860683791598150">Taktak საჭიროებს თქვენს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის გასაზიარებლად</translation>
<translation id="5487574057737591516">თქვენი კონფიდენციალურობის დაცვის მიზნით, ჩვენ ავტომატურად ვშლით თქვენს ინტერესებს, რომლებიც 4 კვირაზე ძველია. თქვენ მიერ ვების დათვალიერების პარალელურად, ესა თუ ეს ინტერესი შეიძლება ხელახლა გამოჩნდეს სიაში. თუ Taktak შეცდომით გამოიცნობს თქვენს ინტერესს, ან რომელიმე ტიპის რეკლამის ნახვას არ მოისურვებთ, ინტერესის წაშლის საშუალება გექნებათ.</translation>
<translation id="549669000822060376">დაელოდეთ, სანამ Taktak დააინსტალირებს სისტემის უახლეს განახლებებს.</translation>
<translation id="5496810170689441661">Taktak ცდილობს პაროლების რედაქტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="5524890928877629608">ძიების არეალის ზედა მარცხენა კუთხე: მარცხნივ <ph name="LEFT" />%, ზემოთ <ph name="TOP" />%</translation>
<translation id="5527463683072221100">PDF-ების გახსნა Taktak-ში</translation>
<translation id="5579324208890605088">გაშვების შეცდომა: გაუშვით ინსტალატორი, როგორც რიგითმა მომხმარებელმა და არა — ადმინისტრატორმა.</translation>
