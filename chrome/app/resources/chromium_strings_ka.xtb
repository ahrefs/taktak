<translation id="6390800440335263989">გასაგრძელებლად შედით Taktak-ში ანგარიშით <ph name="EMAIL" />. ამგვარად თქვენს ხელთ იქნება თქვენი ორგანიზაციის დებულებები.</translation>
<translation id="6400112897226594999">Taktak-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="6403826409255603130">Taktak არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ Taktak-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="6436260184216827876">სურათების ძიება მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="6442900851116057561">გადატვირთეთ ChromiumOS</translation>
<translation id="6443470774889161065">Taktak წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="645458117210240797">გამორთული • Taktak ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="6455857529632101747">მოგესალმებათ Taktak პროფილები</translation>
<translation id="6466344609055215035">ანგარიშის ამოშლა Taktak-იდან</translation>
<translation id="6475912303565314141">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Taktak-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="6510925080656968729">Taktak-ის დეინსტალაცია</translation>
<translation id="651535675648445253">მალსახმობები იხსნება Taktak-ში</translation>
<translation id="6524389414524528185">როცა შესული ხართ, Taktak-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Taktak ანგარიშიდან. ამის შეცვლა შეგიძლიათ ნებისმიერ დროს, მდებარეობის პარამეტრებიდან.</translation>
<translation id="6539122709674868420">თქვენი ორგანიზაცია ხურავს Taktak-ს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="6542839706527980775">თითოეულ პროფილში ინახება საკუთარი Taktak ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="6563921047760808519">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK" />როგორ ინარჩუნებს Taktak თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK" /></translation>
<translation id="6564039629497156115">ამ პარამეტრის ცვლილება ამოქმედდება Taktak-ის გადატვირთვისთანავე.</translation>
<translation id="656935081669708576">ახლა შეგიძლიათ გადართვა, პაროლები სხვა Taktak პროფილიდან რომ ნახოთ</translation>
<translation id="6570579332384693436">მართლწერის შეცდომების გასასწორებლად, Taktak თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს Taktak-ს უგზავნის</translation>
<translation id="6598877126913850652">Taktak-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6600016381025017075">მოძებნეთ ნებისმიერი რამ ამ გვერდზე</translation>
<translation id="6613594504749178791">თქვენი ცვლილებები გააქტიურდება Taktak-ის შემდეგი გაშვებისას.</translation>
<translation id="665732753414869868">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად Taktak საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="6669284030132180248">თუ თქვენს სანიშნეებს Taktak ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Taktak-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="668175097507315160">ChromiumOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="6692797197837897398">Taktak გაძლევთ მეტ კონტროლს თქვენთვის ხილულ რეკლამაზე. ის, ასევე, ზღუდავს იმას, თუ რომელ საიტებს შეუძლია თქვენ შესახებ ინფორმაციის მიღება, როცა მათ მიერ თქვენთვის ნაჩვენებია პერსონალიზებული რეკლამა.</translation>
<translation id="6709350901466051922">Taktak საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR" /></translation>
<translation id="6717134281241384636">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის Taktak-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ Taktak-ის ახალი ვერსია.</translation>
<translation id="6729124504294600478">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ Taktak როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ Taktak სერვისებს</translation>
<translation id="6734291798041940871">Taktak უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="6751374565094704799">აჩქარებს Taktak-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Taktak ოდნავ ნაკლებად უძლებს შეტევებს. ეს პარამეტრი ჩართულია.</translation>
<translation id="67706546131546258">Taktak გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
