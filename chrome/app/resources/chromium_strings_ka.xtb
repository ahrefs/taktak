<translation id="370962675267501463">{COUNT,plural, =0{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Taktak-ის ხელახლა გაშვებას}=1{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Taktak-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ Taktak-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="3713809861844741608">ბმულის გახსნა Taktak-ის ახალ ჩა&amp;ნართში</translation>
<translation id="3728124580182886854">მიაბით ერთმანეთს Taktak და სხვა Taktak სერვისები პერსონალიზებისა და სხვა მიზნით</translation>
<translation id="3788675262216168505">Taktak-ის პროფილების მართვა</translation>
<translation id="3790262771324122253">შეიტყვეთ, რატომ ბლოკავს Taktak ზოგიერთ ჩამოტვირთვას</translation>
<translation id="379589255253486813">Taktak გაცნობებთ, თუ რაიმეს შემოწმება დაგჭირდებათ</translation>
<translation id="3802055581630249637">Taktak წინასწარ ჩატვირთავს გვერდებს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="3810973564298564668">მართვა</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Taktak</translation>
<translation id="3885770153807205175">ენის ამომრჩევი</translation>
<translation id="388648406173476553">მოირგეთ და გააკონტროლეთ Taktak. საჭიროა თქვენი ყურადღება — დააწკაპუნეთ დეტალური ინფორმაციისთვის.</translation>
<translation id="3889543394854987837">Taktak ის გახსნისა და დათვალიერების დაწყებისათვის დააჭირეთ თქვენი სახელს.</translation>
<translation id="3892148308691398805">ტექსტის კოპირება</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> უკვე შესულია ამ Taktak პროფილში. თქვენი დათვალიერების მონაცემები რომ განაცალკევოთ, Taktak-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="3909353120217047026">ეს გაფართოება არღვევს Taktak Web Store-ის წესებს და ის, შესაძლოა, არ იყოს უსაფრთხო. წაშალეთ ის Taktak-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="3941890832296813527">შეცდომა ინსტალაციისას: ინსტალატორის ფაილის სახელი არასწორი ან მხარდაუჭერელია.</translation>
<translation id="3945058413678539331">Taktak ცდილობს პაროლების კოპირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="3954172517175569325">ამ მოწყობილობიდან ამოიშლება თქვენი პაროლები, გადახდის მეთოდები და მისამართები, რომლებიც შეინახეთ თქვენს Taktak ანგარიშში. Taktak-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="395904275706073188">დაცული გვერდების წაკითხვა შეუძლებელია. ცადეთ სხვა გვერდი.</translation>
<translation id="3962647064319009959">შეიტყვეთ, როგორ ზრუნავს Taktak თქვენს უსაფრთხოებაზე</translation>
<translation id="3971865010372729242">როდესაც მისამართთა ზოლში ან საძიებო ველში ტექსტი შეგყავთ, Taktak აგზავნის მას თქვენი ორგანიზაციის საძიებო სისტემაში, ხელოვნურ ინტელექტთან და აგენტის ხელსაწყოებში, რათა მიიღოს შემოთავაზებები.</translation>
<translation id="3975724895399328945">Taktak Taktak for Testing-ის შ&amp;ესახებ</translation>
<translation id="3997429360543082038">ChromiumOS-ის შესახებ</translation>
<translation id="4019629340646866719">ChromiumOS და <ph name="BEGIN_LINK_LINUX_OSS" />Linux-ის შემუშავების გარემო <ph name="END_LINK_LINUX_OSS" /> მუშაობს <ph name="BEGIN_LINK_CROS_OSS" />ღია კოდის დამატებითი პროგრამული უზრუნველყოფის<ph name="END_LINK_CROS_OSS" /> დამსახურებით.</translation>
<translation id="4022972681110646219">ეკრანის თარგმნა</translation>
<translation id="4023601594785368013">ორიგინალის ენა: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">გახსნის ბმულებს Taktak-ში ნებისმიერი აპიდან. დამატებით, მარტივი წვდომისთვის ის ჩამაგრდება თქვენს ამოცანათა ზოლში.</translation>
<translation id="4036079820698952681">ხელი შეუწყვეთ Taktak-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="4050175100176540509">უსაფრთხოების მნიშვნელოვანი გაუმჯობესება და ახალი თვისებები ხელმისაწვდომია უახლეს ვერსიაში.</translation>
<translation id="4055805654398742145">პ&amp;აროლების მმართველი</translation>
<translation id="4095980151185649725">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად ხურავს Taktak-ს, როცა ის 1 წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}other{თქვენი ორგანიზაცია ავტომატურად ხურავს Taktak-ს, როცა ის # წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}}</translation>
<translation id="4118474109249235144">Taktak-ის ინკოგნიტო რეჟიმი</translation>
<translation id="4122186850977583290">Taktak-ის შესახებ ინფორმაციის გვერდზე გადასვლა</translation>
<translation id="4148957013307229264">ინსტალაცია…</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> — ქსელში შესვლა — Taktak</translation>
<translation id="421369550622382712">აღმოაჩინეთ შესანიშნავი აპები, თამაშები, გაფართოებები და თემები Taktak-ისთვის.</translation>
<translation id="4217080900579554343">ამ გაფართოების და სხვა ერთეულების თქვენს კომპიუტერზე მისაღებად შედით Taktak-ში</translation>
<translation id="4217972271355023382">ონლაინ უსაფრთხოების დასაცავად, თქვენი მშობლის არჩევანით, გადართეთ Taktak პროფილზე, რომელშიც უკვე შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">მიმდინარეობს გაუქმება…</translation>
<translation id="4224210481850767180">ინსტალაცია გაუქმდა.</translation>
<translation id="4230135487732243613">დავუკავშიროთ თქვენი Taktak მონაცემები ამ ანგარიშის?</translation>
<translation id="4251772536351901305">გაგაფრთხილებთ სახიფათო საიტების შესახებ (თუნდაც Taktak-ისთვის იქამდე უცნობის შესახებ) საიტებიდან იმაზე მეტი მონაცემის სკანირების მეშვეობით, ვიდრე სტანდარტული დაცვის შემთხვევაში. სურვილისამებრ, შეგიძლიათ გამოტოვოთ Taktak-ის გაფრთხილებები.</translation>
<translation id="4269093074552541569">Taktak-იდან გასვლა</translation>
<translation id="4271805377592243930">Taktak-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="4281844954008187215">მომსახურების პირობები</translation>
<translation id="4285930937574705105">ინსტალაცია ვერ განხორციელდა განუსაზღვრელი შეცდომის გამო. თუ Taktak ამჟამად გაშვებულია, დახურეთ იგი და ხელახლა სცადეთ.</translation>
<translation id="4304713468139749426">პაროლების მმართველი</translation>
<translation id="4334241893986177674">ეკრანის ამ ანაბეჭდის მოძიება</translation>
<translation id="4334294535648607276">ჩამოტვირთვა დასრულდა.</translation>
<translation id="439358628917130594"><ph name="MANAGER" /> მოითხოვს, რომ ამ მოწყობილობის გამოყენებამდე წაიკითხოთ ქვემოთ მოცემული მომსახურების პირობები და დაეთანხმოთ მათ. აღნიშნული პირობები არ არის ChromiumOS-ის წესების დამატება, ასევე, არ ცვლის და არც ზღუდავს მათ.</translation>
<translation id="4407044323746248786">მაინც გსურთ Taktak-იდან გასვლა?</translation>
<translation id="4413205837991854510">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
<translation id="4415566066719264597">Taktak-ისთვის ფონურ რეჟიმში მუშაობის დაშვება</translation>
<translation id="4419831163359812184">{NUM_EXTENSIONS,plural, =1{Taktak გირჩევთ მის ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" />}other{Taktak გირჩევთ მათ ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" />}}</translation>
<translation id="4423735387467980091">Taktak-ის მორგება და კონტროლი</translation>
<translation id="4427306783828095590">გაძლიერებული დაცვა გთავაზობთ ფიშინგისა და მავნე პროგრამებისგან დაცვის მეტ საშუალებას</translation>
<translation id="4434353761996769206">ინსტალატორის შეცდომა: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438870983368648614"><ph name="MANAGER" /> მართავს Taktak-ს</translation>
<translation id="444069871276811466">Taktak პროფილის დამატება</translation>
<translation id="4447409407328223819">Taktak for Testing-ის შესახებ</translation>
<translation id="4470974262661801543">თქვენს Taktak ანგარიშში Taktak-ის მონაცემები რომ გამოიყენოთ და შეინახოთ, შეიყვანეთ თქვენი საიდუმლო ფრაზა</translation>
<translation id="4493028449971051158">გაშვების შეცდომა: ინსტალატორი გაუშვით, როგორც ადმინისტრატორმა.</translation>
<translation id="4501471624619070934">ინსტალაცია ვერ მოხერხდა, რადგან წვდომა შეზღუდულია ამ ქვეყანაში</translation>
<translation id="4510853178268397146">ამ გაფართოებას არ გამოუქვეყნებია კონფიდენციალური ინფორმაციის გამოყენების პრაქტიკა, მაგალითად, მონაცემების შეგროვებისა და გამოყენების წესები. Taktak გირჩევთ მის ამოშლას.</translation>
<translation id="452711251841752011">მოგესალმებით Taktak-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="4531137820806573936">თქვენი გარემოს მოსანიშნად და თქვენი ხელებისთვის თვალის მიდევნებისთვის Taktak საჭრიროებს ნებართვას</translation>
<translation id="4534145890176164066">Taktak ფორმებს უკეთ აღიქვამს და უფრო სწრაფად შეუძლია მათი შევსება</translation>
<translation id="4536805923587466102">თქვენ უკვე შესული ხართ Taktak-ის სხვა პროფილში როგორც <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4548534452171747496">Taktak წინასწარ ჩატვირთავს გვერდებს, რაც დააჩქარებს დათვალიერებას და ძიებას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი წინასწარ ჩატვირთული გვერდების შესახებ<ph name="END_LINK" /></translation>
<translation id="4567424176335768812">თქვენ შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS" />. ახლა შეგიძლიათ გახსნათ თქვენი სანიშნეები, ისტორია და სხვა პარამეტრები ყველა მოწყობილობიდან, რომელშიც შესული ხართ.</translation>
<translation id="4570813286784708942">Taktak-მა დაბლოკა ეს ჩამოტვირთვა, რადგან Safe Browsing გამორთეთ და ფაილის შემოწმება ვერ ხერხდება</translation>
<translation id="4594305310729380060">პაროლების მმართველში ამ მოწყობილობაზე</translation>
<translation id="459535195905078186">Taktak პროგრამები</translation>
<translation id="4598116752460667024">სიიდან ნებისმიერი პროცესის მოძიება.</translation>
<translation id="4613863813562375431">ChromiumOS-ის ვერსია</translation>
<translation id="4621240073146040695">განახლება თითქმის მზად არის! დასასრულებლად, ხელახლა გაუშვით Taktak.</translation>
<translation id="4625064703209785397">აჩქარებს Taktak-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Taktak ოდნავ ნაკლებად უძლებს შეტევებს</translation>
<translation id="4654936675281451226">Taktak ფორმებს უკეთ აღიქვამს და უფრო სწრაფად შეუძლია მათი შევსება. ეს პარამეტრი ჩართულია.</translation>
<translation id="4665829708273112819">გაფრთხილება: Taktak ვერ შეუშლის ხელს გაფართოებებს დათვალიერების ისტორიის შენახვაში. ინკოგნიტო რეჟიმში ამ გაფართოების გასათიშად მოხსენით მონიშვნა ამ ვარიანტზე.</translation>
<translation id="4673151026126227699">თუ Taktak-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="4677944499843243528">როგორც ჩანს, პროფილი გამოიყენება სხვა Taktak პროცესის მიერ (<ph name="PROCESS_ID" />) სხვა კომპიუტერში (<ph name="HOST_NAME" />). Taktak-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ Taktak.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="469259825538636168">თქვენი Taktak-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Taktak ანგარიშში. სისტემიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="4708193446201257833">როცა შესული ხართ, Taktak-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Taktak ანგარიშიდან. <ph name="SHORTCUT" /> შეცვლის თქვენი Taktak სერვისების პარამეტრებს.</translation>
<translation id="4708774505295300557">Taktak-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST" />. გთხოვთ, შექმნათ Taktak-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="4724676981607797757">ინსტალაცია ვერ მოხერხდა მხარდაუჭერელი პროტოკოლის შეცდომის გამო.</translation>
<translation id="4746050847053251315">მაინც გსურთ Taktak-იდან გასვლა?</translation>
<translation id="4748217263233248895">Taktak-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე (თქვენი ჩანართები აღდგება).</translation>
<translation id="4771701986670315895">ბოლო დროს არ ყოფილხართ. Taktak-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და კიდევ <ph name="COUNT" />.</translation>
<translation id="4788777615168560705">Taktak ვერ ახერხებს პაროლების შემოწმებას. ცადეთ 24 საათში ან <ph name="BEGIN_LINK" />შეამოწმეთ პაროლები თქვენს Taktak ანგარიშში<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Taktak Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება Taktak-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="4814736265800133385">Taktak-ის გამოყენება ანგარიშის გარეშე</translation>
