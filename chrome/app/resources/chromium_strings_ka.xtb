<translation id="1820835682567584003">Taktak ცდილობს შემდეგს: <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1838374766361614909">ძიების გასუფთავება</translation>
<translation id="18552579716432081">დათვალიერების მონაცემების მხოლოდ ამ მოწყობილობიდან წასაშლელად და Taktak ანგარიშში მათ შესანარჩუნებლად <ph name="BEGIN_LINK" />გამოდით Taktak-იდან<ph name="END_LINK" />.</translation>
<translation id="185970820835152459">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Taktak ანგარიშები. თქვენი Taktak ანგარიშები გამოიყენება Taktak ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE" />-ს. <ph name="LINK_BEGIN" />შეიტყვეთ მეტი<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">სურათების ძიებით მოძიება</translation>
<translation id="1863308913976887472">საიტებს Taktak-ის მეშვეობით შეუძლია თქვენს ინტერესებთან დაკავშირებული ინფორმაციის შენახვა. მაგალითად, თუ მარათონისთვის ფეხსაცმლის საყიდლად რომელიმე საიტს მოინახულებთ, აღნიშნულმა საიტმა შეიძლება განსაზღვროს, რომ მარათონებში მონაწილეობა გაინტერესებთ. მოგვიანებით, თუ განსხვავებულ საიტს მოინახულებთ, მაგალითად, რბოლაში მონაწილეობის მისაღებად რეგისტრაციისთვის, ამ საიტმა შეიძლება სპორტული ფეხსაცმლის რეკლამა გაჩვენოთ თქვენი ინტერესების საფუძველზე.</translation>
<translation id="1880677175115548835">ტექსტის არჩევა</translation>
<translation id="1881322772814446296">თქვენ შედიხართ სისტემაში მართული ანგარიშით და ამით აძლევთ ადმინისტრატორს კონტროლს თქვენს Taktak-ის პროფილზე. თქვენი Taktak-ის მონაცემები, როგორიცაა პროგრამები, სანიშნეები, ისტორია, პაროლები და სხვა პარამეტრები სამუდამოდ მიემაგრება <ph name="USER_NAME" />-ს. თქვენ შეძლებთ ამ მონაცემების წაშლას Taktak ანგარიშების საინფორმაციო დაფის მეშვეობით, თუმცა ამ მონაცემების დაკავშირებას სხვა ანგარიშთან ვერ შეძლებთ. სურვილისამებრ, შეგიძლიათ შექმნათ ახალი პროფილი, არსებული Taktak-ის მონაცემების ცალკე შესანახად. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Taktak დაზოგავს ბატარეის მუხტს ვიზუალური ეფექტებისა (მაგალითად, ლივლივა გადაადგილებისა და ვიდეოკადრების სიხშირის) და ფონური აქტივობის შეზღუდვის გზით. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი ენერგიის დამზოგის შესახებ<ph name="END_LINK" /></translation>
<translation id="1898804291554630487">იკითხეთ ამ გვერდის შესახებ</translation>
<translation id="1900969832270057921">Taktak-ის განმაახლებელი სერვისი</translation>
<translation id="1911763535808217981">ამ პარამეტრის გამორთვის შემთხვევაში, Taktak-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Taktak-ში შესვლის გარეშე</translation>
<translation id="1916451563296275579">ამ აპების მონაცემების Taktak-იდან ამოშლა</translation>
<translation id="1929939181775079593">Taktak არ პასუხობს. გავუშვათ ხელახლა?</translation>
<translation id="1933341829955786215">თქვენი ორგანიზაცია, <ph name="MANAGER" />, მოითხოვს, რომ Taktak-ში შეხვიდეთ</translation>
<translation id="193439633299369377">განახლების მისასადაგებლად ChromiumOS უნდა გადაიტვირთოს.</translation>
<translation id="1951406923938785464">Taktak-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ტიპის ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="1953553007165777902">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="MINUTE" /> წუთი</translation>
<translation id="1966382378801805537">Taktak ნაგულისხმევ ბრაუზერს ვერ საზღვრავს, ან ვერ აყენებს</translation>
<translation id="1990262977744080398">შეიტყვეთ, რატომ ბლოკავს Taktak ზოგიერთ ფაილს, გაიხსნება ახალ ჩანართში</translation>
<translation id="1999715455684970349">იზრუნებს, რომ თქვენი Taktak-ის პროგრამული უზრუნველყოფა განახლებული იყოს. თუ ეს სერვისი გაითიშება ან შეჩერდება, Taktak-ის პროგრამული უზრუნველყოფა აღარ განახლდება, რაც იმას ნიშნავს, რომ უსაფრთხოებასთან დაკავშირებული პოტენციური საფრთხეების აღმოფხვრა აღარ მოხდება და ფუნქციებმა შეიძლება არ იმუშაოს. ეს სერვისი დეინსტალირდება, როცა მისით მოსარგებლე Taktak-ის პროგრამული უზრუნველყოფა არ არსებობს.</translation>
<translation id="2008474315282236005">ეს მოქმედება წაშლის 1 ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Taktak-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ინსტალაცია ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="2020032459870799438"><ph name="BEGIN_LINK" />შედით Taktak-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს სხვა პაროლებს.</translation>
<translation id="2049376729098081731">აირჩიეთ, დაერთოს თუ არა Taktak ისტორია, Taktak სერვისებში უფრო პერსონალიზებული ფუნქციებით რომ ისარგებლოთ</translation>
<translation id="2054039611381840095">მომავალში Taktak-ის განახლებების მისაღებად დაგჭირდებათ macOS 12 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 11-ს.</translation>
<translation id="2086476982681781442">Taktak-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი შეცდომაში შემყვანია და მას შეუძლია მოულოდნელი ცვლილებების განხორციელება თქვენს მოწყობილობაზე</translation>
<translation id="2099452623287920103">თქვენი პაროლები და Taktak-ის სხვა მონაცემები, რომლებიც შენახულია თქვენს Taktak ანგარიშში, ამოიშლება ამ მოწყობილობიდან. Taktak-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Taktak არ გამოიყენება 1 წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}other{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Taktak არ გამოიყენება # წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}}</translation>
