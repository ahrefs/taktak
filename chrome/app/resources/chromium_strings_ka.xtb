<translation id="7339898014177206373">ახალი ფანჯარა</translation>
<translation id="734373864078049451">თქვენი ვები, სანიშნეები და Taktak-ის სხვა მასალა არის აქ.</translation>
<translation id="7349591376906416160">თქვენი სისტემის ადმინისტრატორმა მოახდინა Taktak-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME" />-ის გახსნა.</translation>
<translation id="7352651011704765696">რაღაც არასწორად წარიმართა</translation>
<translation id="7376384068949534168">ბოლო დროს არ ყოფილხართ. Taktak-მა ამოშალა <ph name="PERMISSION_1" /> და <ph name="PERMISSION_2" />.</translation>
<translation id="7384121030444253939">ეს გაფართოება აღარ არის მხარდაჭერილი. Taktak გირჩევთ მის ამოშლას.</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> — Taktak Dev</translation>
<translation id="7450541714075000668">ტექსტი დაკოპირდა</translation>
<translation id="7451052299415159299">Taktak საჭიროებს თქვენს კამერაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="7458892263350425044">თქვენი მიკროფონი რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Taktak-ს წვდომა</translation>
<translation id="7461356015007898716">Taktak-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 7-ს.</translation>
<translation id="7467949745582939695">გსურთ Taktak-ის ხელახლა გაშვება?</translation>
<translation id="7483335560992089831">შეუძლებელია იმავე Taktak-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ Taktak და ხელახლა სცადეთ.</translation>
<translation id="7517403744065880907">თქვენ შეინახავთ და გამოიყენეთ პაროლებსა და სხვა მონაცემებს Taktak ანგარიშში, როცა Taktak-ში შეხვალთ. <ph name="LEARN_MORE" /></translation>
<translation id="751935028865900641">საიტები, სავარაუდოდ, არ იმუშავებს მოლოდინისამებრ. Taktak-ის ყველა ფანჯრის დახურვისას სისტემიდან გამოხვალთ საიტების უმეტესობაზე, გამონაკლისია თქვენი Taktak ანგარიში, თუ მასში შესული ხართ Taktak-იდან.</translation>
<translation id="753534427205733210">{0,plural, =1{Taktak ხელახლა გაეშვება 1 წუთში}other{Taktak ხელახლა გაეშვება # წუთში}}</translation>
<translation id="7565444033145385702">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Taktak-ს გაუუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ.</translation>
<translation id="7582945390259497898">Taktak-ს შეუძლია თქვენი ინტერესების პროგნოზირება. მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, Taktak-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ინსტალატორი</translation>
<translation id="761356813943268536">Taktak იყენებს თქვენს კამერას და მიკროფონს.</translation>
<translation id="7617377681829253106">Taktak გაუმჯობესდა</translation>
<translation id="7622753900276619808">ახლა თქვენთვის ხელმისაწვდომია მეტი ფუნქცია Taktak-ში</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="7658239707568436148">გაუქმება</translation>
<translation id="7686590090926151193">Taktak არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="7689606757190482937">მოახდინეთ Taktak-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="7699779824407626136">Taktak-ის განახლება</translation>
<translation id="7716950018788545737">ამოცანა(ები) დასრულდა.</translation>
<translation id="77283119132245232">უზრუნველყოფს სისტემის კონტროლის სერვისს <ph name="BROWSER_NAME" />-ისთვის. თუ ეს სერვისი გათიშულია, ბრაუზერის მიერ შექმნილი ეფექტურობის ჩანაწერები არ მიიღებს მონაწილეობას სისტემის დონის მოვლენებში, როგორიცაა კონტექსტის გადართვა თუ მზა ნაკადების მოვლენები.</translation>
<translation id="7745317241717453663">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Taktak-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="7786760609782648049">ააჩქარეთ Taktak-ის მუშაობა</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> — Taktak Canary</translation>
<translation id="7803986347287457849">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. Taktak იყენებს უსაფრთო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="7810005234485217901">შეგიძლიათ, ჩაამაგროთ სურათების ძიება მასზე მარტივად წვდომისთვის</translation>
<translation id="7828947555739565424">Taktak პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="7859018312476869945">მისამართთა ზოლში ან საძიებო ველში ტექსტის აკრეფისას უკეთესი შემოთავაზებების მისაღებად Taktak თქვენ მიერ აკრეფილ ტექსტს გაუგზავნის თქვენს ნაგულისხმევ საძიებო სისტემას. აღნიშნული ფუნქცია გამორთულია ინკოგნიტო რეჟიმში.</translation>
<translation id="7867198900892795913">Taktak ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS" /> წამი</translation>
<translation id="7877212753140190672">შეკითხვა ამ სურათის შესახებ</translation>
<translation id="7888981273428720788">Taktak-ის დაყენება ნაგულისხმევად</translation>
<translation id="7934340546140346950">Taktak ავტომატურად განაახლებს HTTPS-თან დაუცველ კავშირებს, როცა ეს შესაძლებელი იქნება</translation>
<translation id="7937630085815544518">თქვენ შესული ხართ Taktak-ში როგორც <ph name="USER_EMAIL_ADDRESS" />. გთხოვთ გამოიყენოთ იგივე ანგარიში ხელახლა შესვლისას.</translation>
<translation id="7975919845073681630">ეს Taktak-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="7997934263947464652">უცნობი წყაროებიდან მომავალ გაფართოებებს, აპებსა და თემებს შეუძლია თქვენი მოწყობილობის დაზიანება. Taktak გირჩევთ, ისინი მხოლოდ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-დან დააინსტალიროთ.</translation>
<translation id="8004582292198964060">ბრაუზერი</translation>
<translation id="8010081455002666927">ავტომატური ამოცნობა</translation>
<translation id="8013436988911883588">Taktak-ისთვის წვდომის მინიჭების შემდეგ ცალკეული ვებსაიტები შეძლებს თქვენგან წვდომის მოთხოვნას.</translation>
<translation id="8031714377769448844">ჩაამაგრეთ Taktak ამოცანათა ზოლში, რომ ნებისმიერ დროს გამოიყენოთ ის</translation>
<translation id="80471789339884597">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი ყველა ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="8054112667659782652">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
<translation id="8077498902115777962">Taktak-ის აპების ფონურ რეჟიმში მუშაობის გათიშვა</translation>
<translation id="80790299200510644">სურათების ძიება</translation>
<translation id="8086881907087796310">ინსტალაცია ვერ მოხერხდა, რადგან თქვენი კომპიუტერი არ აკმაყოფილებს მინიმალურ მოთხოვნებს აპარატურის კუთხით.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Taktak Taktak for Testing</translation>
<translation id="8105840573057009683">Taktak საჭიროებს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="8118331347066725040">გამოხმაურება Lens-ით ძიების შესახებ</translation>
<translation id="8133124826068723441">ChromiumOS-ის საშუალებით ვერ მოხერხდა თქვენი მონაცემების სინქრონიზაცია, რადგან თქვენს დომენზე სინქრონიზაცია მიუწვდომელია.</translation>
<translation id="813913629614996137">მიმდინარეობს ინიცირება…</translation>
<translation id="81770708095080097">Taktak-მა დაბლოკა ეს ფაილი, რადგან ის სახიფათოა.</translation>
<translation id="8177472873527554730">გვერდზე კონტენტი ვერ მოიძებნა</translation>
<translation id="8200109504272824693">შეიყვანეთ თქვენი საიდუმლო ფრაზა, რომ გამოიყენოთ და შეინახოთ Taktak-ის მონაცემები თქვენს ანგარიშში, <ph name="USER_EMAIL" /></translation>
<translation id="8221491193165283816">როგორც წესი, თქვენ ბლოკავთ შეტყობინებებს. ამ საიტისგან შეტყობინებების მისაღებად დააწკაპუნეთ აქ.</translation>
<translation id="8223363452568144035">თქვენი კამერა რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Taktak-ს წვდომა</translation>
<translation id="8232193495299001329">Taktak ვერ ადასტურებს ამ გაფართოების წარმომავლობას და შესაძლოა, ის სახიფათო იყოს. წაშალეთ ის Taktak-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="8248265253516264921">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Taktak შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Taktak-ში. ამის გამორთვა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="8254601181414348851">გსურთ, შეხვიდეთ Taktak-ის ახალ პროფილში?</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Taktak გაგაფრთხილებთ<ph name="END_LINK" /> არაუსაფრთხო საიტებისა და ჩამოტვირთვების შესახებ</translation>
<translation id="8295827201165805317">ბოლო დროს არ ყოფილხართ. Taktak-მა ამოშალა <ph name="PERMISSION" />.</translation>
<translation id="8313851650939857356">გაშვების შეცდომა: <ph name="STARTUP_ERROR" />.</translation>
<translation id="8318772038038596122">თქვენი ორგანიზაცია ხურავს Taktak-ს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება.</translation>
<translation id="8321888067342493336">სურათად შენახვა</translation>
<translation id="8330519371938183845">შედით სისტემაში, რათა მოახდინოთ Taktak-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
