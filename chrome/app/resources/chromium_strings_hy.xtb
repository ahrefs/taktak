<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1026101648481255140">Վերսկսել տեղադրումը</translation>
<translation id="1029669172902658969">Վերագործարկել՝ &amp;ChromiumOS-ը թարմացնելու համար</translation>
<translation id="103359417695385097">Taktak-ը ավելի լավ է որոշում ձևերը և ավելի արագ ավտոմատ լրացնում դրանք։ Այս կարգավորումն անջատված է։</translation>
<translation id="1040916596585577953">Taktak-ը խորհուրդ է տալիս ստուգել այս ընդլայնումը</translation>
<translation id="1042552502243217427">Երբ որևէ կայք հայցում է էջերի անանուն նախաբեռնում իր էջում առկա հղումների միջոցով, Taktak-ը օգտագործում է Taktak-ի սերվերները։ Այդպիսով ձեր անձնական տվյալները չեն փոխանցվում, սակայն Taktak-ը իմանում է, թե որ կայքերն են նախապես բեռնվում։</translation>
<translation id="1051793555070215510">Օգնեք մեզ բարելավել ինկոգնիտո ռեժիմը՝ անցնելով այս 1 րոպեանոց հարցումը։</translation>
<translation id="1065672644894730302">Ձեր նախասիրությունները չի հաջողվում ստանալ:

Որոշ գործառույթներ կարող են մատչելի չլինել: Նախընտրանքների փոփոխությունները չեն պահպանվի:</translation>
<translation id="1083934481477628225">Ձեր ծնողն անջատել է «Թույլտվություններ կայքերի, հավելվածների և ընդլայնումների համար» պարամետրը Taktak-ում</translation>
<translation id="1104942323762546749">Taktak-ն ուզում է արտահանել ձեր գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="112640046208448578">Նույնականացրեք իրեր կամ վայրեր և պատճենեք կամ թարգմանեք տեքստեր։ Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի սքրինշոթն ուղարկվում է սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Taktak-ը ձեր կանխադրված դիտարկիչն է</translation>
<translation id="1131805035311359397">Որպեսզի պաշտպանեք ձեր գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK" />մտեք հաշիվ Taktak դիտարկիչում<ph name="END_LINK" />։</translation>
<translation id="1153368717515616349">Սեղմեք Taktak-ի ընտրացանկը</translation>
<translation id="1157985233335035034">Վերջերս ընտրված լեզուներ</translation>
<translation id="1184145431117212167">Տեղադրումը ձախողվեց, քանի որ Windows-ի ձեր տարբերակը չի աջակցվում։</translation>
<translation id="1185134272377778587">Taktak-ի մասին</translation>
<translation id="1203500561924088507">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր դիտարկիչը։</translation>
<translation id="1262876892872089030">Մինչ այս ներդիրն ակտիվ չէր, Taktak-ի աշխատանքի արագությունը պահպանելու համար տարածք է ազատվել։ Դուք կարող եք ընտրել, որ այս կայքը միշտ ակտիվ մնա։</translation>
<translation id="1265577313130862557">Taktak-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը վտանգավոր է</translation>
<translation id="126567311906253476">Երբ <ph name="USER_EMAIL" /> հաշվի միջոցով մուտք եք գործում Taktak-ի ծառայություններ, օր․՝ Gmail կամ YouTube, նույն հաշվի միջոցով կարող եք ավտոմատ մուտք գործել Taktak</translation>
<translation id="1290883685122687410">Կարգավորման սխալ՝ <ph name="METAINSTALLER_EXIT_CODE" />։ <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Կարգավորեք Taktak-ի ձեր նոր պրոֆիլը</translation>
<translation id="1324107359134968521">Taktak-ին անհրաժեշտ է Bluetooth-ի հասանելիություն՝
 Bluetooth սարքեր որոնելու համար։ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1330562121671411446">Ճանաչել լեզուն</translation>
<translation id="1342274909142618978">Նաև հեռացնել տվյալները Taktak-ից (<ph name="URL" />)</translation>
<translation id="1345251407431278948">«Որոնում պատկերով» գործառույթն ամրացված է․ այն բացելու համար օգտագործեք գործիքագոտու նոր կոճակը</translation>
<translation id="1356661055722410047">Նորույթ․ դուք կարող եք ձեր էկրանին թարգմանել ինչպես տեքստ, այնպես էլ պատկերներ</translation>
<translation id="1383876407941801731">Որոնում</translation>
<translation id="1414495520565016063">Դուք մուտք եք գործել Taktak:</translation>
<translation id="141901961143729572">Կիսվեք ձեր մտքերով</translation>
<translation id="1465192221147974788">Ձեր պատուհանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Taktak-ի համար։</translation>
<translation id="1478370723027452770">Ստանալ օգնություն Taktak for Testing-ի միջոցով</translation>
<translation id="1497802159252041924">Տեղադրման սխալ՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Այս էջը պաշտպանված է</translation>
<translation id="1524282610922162960">Կիսվեք Taktak-ի ներդիրով</translation>
<translation id="1547469039832541117">Ավարտում է ընդգծված առաջադրանքը։</translation>
<translation id="1553461853655228091">Taktak-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն՝ ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար։</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{Այս ընդլայնումն այլևս չի աջակցվում։ Taktak-ը խորհուրդ է տալիս հեռացնել այն։}one{Այս ընդլայնումն այլևս չի աջակցվում։ Taktak-ը խորհուրդ է տալիս հեռացնել այն։}other{Այս ընդլայնումներն այլևս չեն աջակցվում։ Taktak-ը խորհուրդ է տալիս հեռացնել դրանք։}}</translation>
<translation id="1562320819937089394">Ամրացնել Taktak-ը</translation>
<translation id="1574377791422810894">Taktak-ի անվտանգության գործիքներ</translation>
<translation id="1594928384848033697">Taktak-ը ուզում է ջնջել Գաղտնաբառերի կառավարչի ձեր տվյալները։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Taktak-ը}=1{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Taktak-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Taktak-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Taktak-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="1625909126243026060">Դիտեք գաղտնիության և անվտանգության հիմնական կառավարման տարրերը Taktak-ում։</translation>
<translation id="1640672724030957280">Ներբեռնում…</translation>
<translation id="1680687534629375545">Հարցնել պատկերով որոնմանը այս էջի մասին</translation>
<translation id="1709772298389099340">Ընդլայնված արտոնություններ է տալիս <ph name="BROWSER_NAME" />-ին։</translation>
<translation id="1715127912119967311">Taktak-ը Taktak-ին ուղարկում է ձեր փոխազդեցությունների մասին տվյալները, որպեսզի օգնի բարելավել այս գործառույթերը։ Այդ տվյալները կարող են ընթերցվել, մշակվել և մեկնաբանվել մասնագետների կողմից։</translation>
<translation id="1722488837206509557">Սա ձեզ թույլ կտա ընտություն կատարել հասանելի սարքերից և բովանդակություն ցուցադրել այդ սարքերում։</translation>
<translation id="1733725117201708356">Taktak-ը շուտով կջնջի դիտարկման տվյալները</translation>
<translation id="1736443181683099871">Taktak-ը կփորձի անցնել HTTPS հաղորդակարգի</translation>
<translation id="1736662517232558588">Taktak-ի տվյալները մաքրվեցին</translation>
<translation id="1745121272106313518">Taktak-ը կվերագործարկվի <ph name="REMAINING_TIME" />ից</translation>
<translation id="1749104137266986751">Երբ HTTPS հաղորդակարգը հասանելի չէ, Taktak-ը առանց ձեզ զգուշացնելու կօգտագործի ոչ ապահով միացում</translation>
<translation id="1774152462503052664">Թույլ տալ Taktak-ին աշխատել հետնաշերտում</translation>
<translation id="1779356040007214683">Taktak-ն ավելի ապահով դարձնելու համար որոշ ընդլայնումներ, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացվել առանց ձեր իմացության, անջատվել են։</translation>
<translation id="1808667845054772817">Նորից տեղադրել Taktak-ը</translation>
<translation id="1820835682567584003">Taktak-ը փորձում է <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1838374766361614909">Մաքրել որոնումը</translation>
<translation id="18552579716432081">Այցելությունների պատմությունը միայն այս սարքից ջնջելու, սակայն Taktak հաշվում պահպանելու համար <ph name="BEGIN_LINK" />դուրս եկեք Taktak-ից<ph name="END_LINK" />։</translation>
<translation id="185970820835152459">Դուք կարող եք կառավարել ձեր Taktak հաշիվները, որոնցում մուտք եք գործել։ Դրանք օգտագործվում են Taktak դիտարկիչում, Play Խանութում, Gmail-ում և այլ ծառայություններում։ Եթե ուզում եք ընտանեկան խմբի անդամի կամ մեկ ուրիշի համար հաշիվ ավելացնել, <ph name="DEVICE_TYPE" /> սարքում ավելացրեք նոր օգտատեր։ <ph name="LINK_BEGIN" />Իմանալ ավելին<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Որոնել «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="1863308913976887472">Կայքերը կարող են ձեր հետաքրքրությունների մասին տեղեկություններ պահել Taktak-ում։ Օրինակ, եթե դուք այցելել եք ինչ-որ կայք՝ մարաթոնի համար վազքի կոշիկներ գնելու, այդ կայքը կորոշի, որ ձեզ հետաքրքրում է մարաթոնյան վազքը։ Ավելի ուշ, երբ դուք այցելեք մեկ այլ կայք՝ մրցավազքի համար գրանցվելու, այնտեղ կարող է վազքի կոշիկների գովազդ ցուցադրվել։</translation>
<translation id="1880677175115548835">Ընտրեք տեքստը</translation>
<translation id="1881322772814446296">Դուք մուտք եք գործում վերահսկվող հաշիվ` թույլ տալով ադմինիստրատորին վերահսկել ձեր Taktak պրոֆիլը: Ձեր Taktak տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները մշտապես կկցվեն <ph name="USER_NAME" />-ին: Դուք կարող եք ջնջել այս տվյալները Taktak Dashboard-ի միջոցով, սակայն չեք կարող համակցել այս տվյալները այլ հաշվի հետ: Կարող եք ստեղծել նոր պրոֆիլ՝ ձեր առկա Taktak տվյալներն առանձին պահելու համար: <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Taktak-ը տնտեսում է մարտկոցի լիցքը՝ սահմանափակելով աշխատանքը ֆոնային ռեժիմում և վիզուալ էֆեկտները, օրինակ՝ սահուն ոլորումը և տեսանյութերի կադրերի հաճախականությունը։ <ph name="BEGIN_LINK" />Իմանալ ավելին Էներգիայի խնայման մասին<ph name="END_LINK" /></translation>
<translation id="1898804291554630487">Հարցրեք այս էջի մասին</translation>
<translation id="1900969832270057921">Taktak Updater ծառայություն</translation>
<translation id="1911763535808217981">Անջատելով այս գործառույթը՝ դուք կարող եք մտնել հաշիվ Taktak-ի կայքերում, օրինակ՝ Gmail, առանց մուտք գործելու Taktak:</translation>
<translation id="1916451563296275579">Հեռացնել այս հավելվածի տվյալները Taktak-ից</translation>
<translation id="1929939181775079593">Taktak-ը չի պատասխանում: Վերագործարկե՞լ:</translation>
<translation id="1933341829955786215">Ձեր կազմակերպության (<ph name="MANAGER" />) կանոնների համաձայն՝ դուք պետք է մուտք գործեք Taktak</translation>
<translation id="193439633299369377">Թարմացումը կիրառելու համար հարկավոր է վերագործարկել ChromiumOS-ը։</translation>
<translation id="1951406923938785464">Taktak-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլի այս տեսակը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="1953553007165777902">Ներբեռնում… Մնաց <ph name="MINUTE" /> րոպե</translation>
<translation id="1966382378801805537">Taktak-ը չի կարողանում որոշել կամ սահմանել կանխադրված դիտարկիչը</translation>
<translation id="1990262977744080398">Իմացեք, թե ինչու է Taktak-ն արգելափակում որոշ ֆայլեր կամ բացում նոր ներդիրում</translation>
<translation id="1999715455684970349">Թարմացնում է Taktak-ի ծրագրակազմը։ Եթե անջատեք կամ դադարեցնեք ծառայությունը, դա կարող է հանգեցնել նրան, որ ի հայտ եկած խոցելիությունները չշտկվեն, և որոշ գործառույթներ չաշխատեն։ Այս ծառայությունն ավտոմատ կհեռացվի, եթե չկա Taktak-ի ծրագրակազմ, որն օգտագործում է այն։</translation>
<translation id="2008474315282236005">1 տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Taktak <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="2018879682492276940">Չհաջողվեց տեղադրել։ Նորից փորձեք։</translation>
<translation id="2020032459870799438">Որպեսզի պաշտպանեք ձեր մյուս գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK" />մտեք հաշիվ Taktak դիտարկիչում<ph name="END_LINK" />։</translation>
<translation id="2049376729098081731">Ընտրեք, թե արդյոք ներառել Taktak-ի պատմությունը՝ Taktak-ի ծառայությունների ավելի անհատականացված օգտագործման համար։</translation>
<translation id="2054039611381840095">Taktak-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է macOS 12 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է macOS 11 տարբերակը։</translation>
<translation id="2086476982681781442">Taktak-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը կասկածելի է և կարող է անսպասելի փոփոխություններ կատարել ձեր սարքում</translation>
<translation id="2099452623287920103">Ձեր գաղտնաբառերն ու Taktak-ի մյուս տվյալները, որոնք պահել եք ձեր Taktak հաշվում, կհեռացվեն այս սարքից։ Taktak-ում դրանք նորից օգտագործելու համար պետք է կրկին մուտք գործեք։</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Taktak-ը 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}one{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Taktak-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}other{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Taktak-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}}</translation>
<translation id="2126108037660393668">Ներբեռնված ֆայլը չանցավ հաստատումը։</translation>
<translation id="2137162749895930932">Փակել թարգմանել պատուհանը</translation>
<translation id="215352261310130060">Taktak-ն արգելափակել է այս ներբեռնումը, քանի որ կայքը չի օգտագործում անվտանգ կապ, և ֆայլում, հնարավոր է, չարտոնված գործողություններ են կատարվել</translation>
<translation id="2174178932569897599">Անհատականացնել Taktak-ը</translation>
<translation id="2174917724755363426">Տեղադրումը չի ավարտվել։ Իսկապե՞ս ուզում եք չեղարկել։</translation>
<translation id="2185166961232948079">Taktak – Ցանցի մուտք – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Թարմացումների ստուգման սխալ՝ <ph name="UPDATE_CHECK_ERROR" />։</translation>
<translation id="2199210295479376551">Հեռացնել հաշիվը Taktak-ից</translation>
<translation id="2210682093923538346">Վտանգավոր կայք։ Taktak-ը հեռացրել է ծանուցումների թույլտվությունը։</translation>
<translation id="2236949375853147973">Իմ գործողությունները</translation>
<translation id="2238130810669087193">Հասցեները և այլ տվյալներ ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Taktak։ Այս հասցեն կպահվի ձեր Taktak հաշվում, երբ մուտք գործեք։</translation>
<translation id="2241627712206172106">Եթե ձեզնից բացի որևէ այլ մեկն օգտվում է այս համակարգչից, օրինակ ձեր ընկերները կամ հարազատները, ապա նրանք կարող են առանձին աշխատել և կարգավորել Taktak-ն իրենց ուզած ձևով:</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Taktak-ը խորհուրդ է տալիս դադարեցնել ներդիրը, որը դադաղեցնում է ձեր դիտարկիչը}one{Taktak-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}other{Taktak-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}}</translation>
<translation id="2313870531055795960">Ստուգում է URL-ները Taktak-ում պահված վտանգավոր կայքերի ցանկի միջոցով։ Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Taktak-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ անվտանգ դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="2343156876103232566">Հեռախոսահամարն այստեղից ձեր Android հեռախոսին ուղարկելու համար երկու սարքերի Taktak դիտարկիչներում մտեք հաշիվ։</translation>
<translation id="2359808026110333948">Շարունակել</translation>
<translation id="2361918034042471035">«<ph name="EXTENSION_NAME" />» ընդլայնումն ուզում է, որ դուք մուտք գործեք Taktak</translation>
<translation id="236943522426971115">Անջատել Taktak-ի ֆոնային ռեժիմը հավելվածների համար</translation>
<translation id="2374216753258219393">Այս ընդլայնումը որպես <ph name="USER_EMAIL_ADDRESS" /> օգտագործելու համար մուտք գործեք Taktak։</translation>
<translation id="2384373936468275798">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են։</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{Taktak-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 HID սարքի հասանելիություն}=1{Taktak-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 HID սարք}one{Taktak-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}other{Taktak-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}}</translation>
<translation id="2401032172288869980">Այս կայքի համար Taktak-ին անհրաժեշտ է խոսափողն ու տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="2403703063067034158">Մեկնարկի սխալ․ ներկայումս կարգավորման մեկ այլ օրինակ է աշխատում։ Փորձեք ավելի ուշ։</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Taktak-ի գործիքների<ph name="END_LINK" /> միջոցով դուք կարող եք ապահով դիտարկել և կառավարել կարգավորումները</translation>
<translation id="2451727308784734061">Արագ բացեք Գաղտնաբառերի կառավարիչը դյուրանցման միջոցով։ Դյուրանցումը կարող եք տեղափոխել համակարգչի հիմնական էկրան կամ հավելվածների գործարկիչ։</translation>
<translation id="2478295928299953161">Taktak-ը շուտով կփակվի</translation>
<translation id="2483889755041906834">Taktak-ի մեջ</translation>
<translation id="2485422356828889247">Ապատեղադրել</translation>
<translation id="2513154137948333830">Հարկավոր է վերաբեռնել. <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Ընտրեք տեքստ «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="2554739539410784893">Taktak-ը փորձում է փոխարինել գոյություն ունեցող գաղտնաբառերը։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="2560420686485554789">Ֆայլեր ներբեռնելու համար Taktak-ին անհրաժեշտ է պահեստի օգտագործման թույլտվություն</translation>
<translation id="2572494885440352020">Taktak օգնական</translation>
<translation id="2575822587468774919">Ընտրեք ցանկացած բան՝ «Որոնում պատկերով» գործառույթի միջոցով որոնելու համար</translation>
<translation id="2576118232315942160">Գաղտնաբառերը և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Taktak</translation>
<translation id="2592940277904433508">Շարունակել Taktak-ի օգտագործումը</translation>
<translation id="259935314519650377">Չհաջողվեց քեշավորել ներբեռնված տեղադրիչը։ Սխալ՝ <ph name="UNPACK_CACHING_ERROR_CODE" />։</translation>
<translation id="2620436844016719705">Համակարգ</translation>
<translation id="2629740064077610681">Ձեր կազմակերպությունը կարող է տեսնել և կառավարել այցելությունների պատմությունը, օրինակ՝ էջանիշները, պատմությունը և գաղտնաբառերը։ Taktak-ի անձնական պրոֆիլներում այցելությունների պատմությունը հասանելի չի լինի ձեր կազմակերպությանը։</translation>
<translation id="2635452620547538388">Հաստատեք ձեր ինքնությունը, որպեսզի օգտագործեք և պահեք Taktak-ի տվյալները ձեր <ph name="ACCOUNT_EMAIL" /> հաշվում</translation>
<translation id="264613044588233783">Taktak-ն ավելի արագ է աշխատում, իսկ JavaScript օգտագործող գործառույթները պետք է աշխատեն նախատեսվածի պես (խորհուրդ է տրվում)</translation>
<translation id="2648074677641340862">Տեղադրման ժամանակ օպերացիոն համակարգի սխալ տեղի ունեցավ: Նորից տեղադրեք Taktak-ը:</translation>
<translation id="2661879430930417727">Եթե ձեզնից բացի որևէ այլ օգտատեր օգտվում է այս սարքից (օրինակ՝ ձեր ընկերները կամ հարազատները), ապա նրանք կարող են առանձին աշխատել և անհատականացնել Taktak-ը</translation>
<translation id="2711502716910134313">Taktak-ի ներդիր</translation>
<translation id="2718390899429598676">Լրացուցիչ անվտանգության համար Taktak-ը կգաղտնագրի ձեր տվյալները:</translation>
<translation id="2721354645805494590">Ձեր Taktak հաշիվը Taktak-ից հեռացնելու համար դուրս եկեք հաշվից</translation>
<translation id="2722636413143664436">Գաղտնաբառերը, էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Taktak</translation>
<translation id="2738871930057338499">Հնարավոր չէ միանալ ինտերնետին։ HTTP 403 Forbidden։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="2753623023919742414">Սեղմեք որոնելու համար</translation>
<translation id="2768103863314748511">Սահմանեք Taktak-ը որպես ձեր կանխադրված PDF դիտակ</translation>
<translation id="2770231113462710648">Կանխադրված դիտարկիչը դարձնել՝</translation>
<translation id="2785438272836277133">Այս ընդլայնումը պարունակում է վնասագիր և վտանգավոր է։ Հեռացրեք ընդլայնումը Taktak-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="2799223571221894425">Վերագործարկել</translation>
<translation id="2803971713792056305">Ձեր Taktak-ը</translation>
<translation id="2816462166102338036">Որոնել այս տեսանյութը պատկերով որոնման միջոցով</translation>
<translation id="2841525013647267359">Թարգմանվող լեզու</translation>
<translation id="2846251086934905009">Տեղադրման սխալ. չհաջողվեց ավարտել տեղադրումը։ Գործընթացն ընդհատվել է։</translation>
<translation id="2847479871509788944">Հեռացնել Taktak-ից...</translation>
<translation id="2850691299438350830">Ապահովում է ձեր անվտանգությունը Taktak-ում և Taktak հավելվածներում, երբ մտել եք ձեր հաշիվ։</translation>
<translation id="2885378588091291677">Task Manager</translation>
<translation id="2910007522516064972">&amp;Taktak-ի մասին</translation>
<translation id="2915996080311180594">Վերագործարկել ավելի ուշ</translation>
<translation id="2928420929544864228">Տեղադրումն ավարտված է։</translation>
<translation id="2933336679234709858">Ձեր տվյալները գաղտնագրված են անցաբառով։ Taktak-ի տվյալները ձեր Taktak հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="2945997411976714835">Տեղադրման սխալ. չհաջողվեց սկսել տեղադրումը։</translation>
<translation id="2970426615109535079">Taktak-ը կառավարվում է ձեր կազմակերպության կողմից</translation>
<translation id="2977470724722393594">Taktak-ը թարմացված է</translation>
<translation id="2977506796191543575">Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Taktak-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ Ապահով դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="2981563588585023386">Ձեր ծնողների ընտրած ավելի անվտանգ կարգավորումներն օգտագործելու համար մուտք գործեք Taktak</translation>
<translation id="3003694935412297923">Բոլոր առաջադրանքները</translation>
<translation id="3013473503895162900">Բացել <ph name="URL" /> հղումը Taktak-ի նոր ներդիրում։</translation>
<translation id="3032706164202344641">Taktak-ը չի կարող ստուգել ձեր գաղտնաբառերը։ Փորձեք ավելի ուշ։</translation>
<translation id="3032787606318309379">Ավելացվում է Taktak-ին…</translation>
<translation id="3038232873781883849">Սպասում ենք տեղադրմանը…</translation>
<translation id="3045032126857188731">Թարգմանության լեզուն՝ <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Փակել կարծիքով երկխոսության պատուհանը</translation>
<translation id="3068187312562070417">Taktak-ի այլ պրոֆիլներ</translation>
<translation id="3068515742935458733">Օգնեք բարելավել Taktak-ը՝ Taktak-ին ուղարկելով խափանման մասին հաշվետվությունները և <ph name="UMA_LINK" />ը</translation>
<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{Taktak-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 USB սարքի հասանելիություն}=1{Taktak-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 USB սարք}one{Taktak-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}other{Taktak-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}}</translation>
<translation id="3101560983689755071">Ձեր այցելությունների պատմությունն ազդում է ձեզ ցուցադրվող գովազդի և ստորև ներկայացված հետաքրքրությունների վրա։ Ձեր գաղտնիությունը պաշտպանելու նպատակով Taktak-ն ամեն ամիս ավտոմատ ջնջում է ձեր հետաքրքրությունները։ Հետաքրքրությունները կարող են թարմացվել, եթե դրանք չհեռացնեք։</translation>
<translation id="3103660991484857065">Տեղադրիչը չկարողացավ բացել արխիվը: Նորից ներբեռնեք Taktak-ը:</translation>
<translation id="310459126943037700">Չհաջողվեց ավարտել առաջադրանք(ներ)ը։</translation>
<translation id="3130323860337406239">Taktak-ն օգտագործում է ձեր խոսափողը:</translation>
<translation id="3137969841538672700">Քաշեք որոնելու համար</translation>
<translation id="3144188012276422546">Այս ներդիրն օգտագործում է լրացուցիչ ռեսուրսներ։ Թույլատրեք Taktak-ին ապակտիվացնել այն, և աշխատանքի արդյունավետությունը կբարձրանա։</translation>
<translation id="3149163023759831301">Ձեր էկրանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Taktak-ի համար</translation>
<translation id="3155163173539279776">Taktak-ի վերագործարկում</translation>
<translation id="3161522574479303604">Բոլոր լեզուները</translation>
<translation id="3179665906251668410">Բացել հղումը Taktak-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="3185330573522821672">Կարգավորեք Taktak-ի նոր պրոֆիլը</translation>
<translation id="3224847870593914902">Ձեր Taktak հաշիվը Taktak-ից հեռացնելու համար դուրս եկեք Taktak-ից «Կարգավորումներ» էջում</translation>
<translation id="3234316605225071811">Հետագայում Taktak-ը կարող է հարցնել, թե արդյոք ուզում եք օգտագործել պահված տեղեկությունները ձևերի ավտոմատ լրացման համար</translation>
<translation id="3258596308407688501">Taktak-ը չի կարող կարդալ և գրել իր տվյալների գրացուցակում՝

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3286538390144397061">Վերագործարկել հիմա</translation>
<translation id="328888136576916638">Taktak API-ի բանալիները չկան: Taktak-ի որոշ գործառույթներ կանջատվեն:</translation>
<translation id="3296368748942286671">Շարունակել հետնաշերտի հավելվածների աշխատանքը, երբ Taktak-ը փակված է</translation>
<translation id="3313189106987092621">Նախքան ոչ ապահով միացման միջոցով որևէ կայք բեռնելը Taktak-ը ձեզ կնախազգուշացնի</translation>
<translation id="3316771292331273802">Դուք դուրս կգրվեք կայքերի մեծամասնությունից, երբ փակեք Taktak-ի բոլոր պատուհանները, սակայն կմնաք ձեր Taktak հաշվում, եթե մուտք եք գործել Taktak։ Որպեսզի թույլ տաք կայքերին հիշել ձեզ, <ph name="SETTINGS_LINK" />։</translation>
<translation id="3352986031709923790">որոնման տարածքի վերևի աջ անկյուն՝ <ph name="RIGHT" />% աջից, <ph name="TOP" />% վերևից</translation>
<translation id="3369405342922656244">Որոնել այս էջը պատկերով որոնման միջոցով</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3406848076815591792">Անցնե՞լ Taktak-ի ընթացիկ պրոֆիլ</translation>
<translation id="3412460710772753638">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="347328004046849135">Taktak-ը կտեղեկացնի ձեզ, երբ կոտրված գաղտնաբառ օգտագործեք։</translation>
<translation id="3474745554856756813"><ph name="ITEMS_COUNT" /> տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Taktak <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="3497319089134299931">Taktak-ի այլ պրոֆիլի կարող եք անցնել <ph name="SHORTCUT" /> ստեղների համադրության միջոցով</translation>
<translation id="3509308970982693815">Փակեք Taktak-ի բոլոր պատուհանները և կրկին փորձեք:</translation>
<translation id="3522404737534491619">Ձեր պատուհանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Taktak-ի համար</translation>
<translation id="3530103706039034513"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։  Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Taktak <ph name="USER_EMAIL_ADDRESS" /> հաշվով։</translation>
<translation id="3533435340678213462">Ձեր գաղտնիությունը պաշտպանելու նպատակով մենք 4 շաբաթից ավտոմատ ջնջում ենք ձեր հետաքրքրությունները։ Երբ դուք շարունակում եք դիտել վեբ էջեր, համապատասխան հետաքրքրությունը կարող է նորից հայտնվել ցանկում։ Որպեսզի Taktak-ը հաշվի չառնի որոշակի հետաքրքրությունները, կարող եք դրանք հեռացնել։</translation>
<translation id="3561853857681580870">Ձեր էկրանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Taktak-ի համար։</translation>
<translation id="3567254597502212821">Ձեր այցելությունների պատմությունը այն կայքերի ցանկն է, որոնք դուք այցելել եք Taktak-ի միջոցով այս սարքում։</translation>
<translation id="3597003331831379823">Չհաջողվեց գործարկել ընդլայնված արտոնություններով կարգավորումը։ <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3639635944603682591">Այս օգտատիրոջ այցելությունների պատմությունը կհեռացվի այս սարքից։ Տվյալները վերականգնելու համար <ph name="USER_EMAIL" /> հաշվով մուտք գործեք Taktak-ում։</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Taktak-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։}=1{Taktak-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Taktak-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Taktak-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3651803019964686660">Հեռախոսահամարը <ph name="ORIGIN" /> կայքից ձեր Android հեռախոսին ուղարկելու համար երկու սարքերի Taktak դիտարկիչներում մտեք հաշիվ։</translation>
<translation id="3667616615096815454">Չհաջողվեց տեղադրել․ հավելվածն անծանոթ է սերվերի համար։</translation>
<translation id="3685209450716071127">Taktak-ը չի կարող ստուգել ձեր գաղտնաբառերը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Taktak-ը}=1{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Taktak-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Taktak-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Taktak-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3713809861844741608">Բացել հղումը Taktak-ի նոր &amp;ներդիրում</translation>
<translation id="3728124580182886854">Կապեք Taktak-ը Taktak-ի մյուս ծառայությունների հետ՝ անհատականացման և այլ գործընթացների համար</translation>
<translation id="3788675262216168505">Կառավարել Taktak-ի պրոֆիլները</translation>
<translation id="3790262771324122253">Իմացեք, թե ինչու է Taktak-ն արգելափակում որոշ ներբեռնումներ</translation>
<translation id="379589255253486813">Taktak-ը ձեզ կտեղեկացնի, եթե որևէ բան փոխելու անհրաժեշտություն լինի</translation>
<translation id="3802055581630249637">Taktak-ը նախապես բեռնում է էջերը, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="3810973564298564668">Կառավարել</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Taktak</translation>
<translation id="3885770153807205175">Լեզվի ընտրիչ</translation>
<translation id="388648406173476553">Taktak-ի կարգավորման և կառավարման համար անհրաժեշտ է ձեր ուշադրությունը։ Սեղմեք՝ մանրամասներին ծանոթանալու համար։</translation>
<translation id="3889543394854987837">Սեղմեք ձեր անվան վրա՝ Taktak-ը բացելու համար:</translation>
<translation id="3892148308691398805">Պատճենել տեքստը</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" />-ն արդեն մուտք է գործել Taktak-ի այս պրոֆիլը։ Ձեր դիտարկումների պատմությունն առանձին պահելու համար կարող եք Taktak-ի առանձին պրոֆիլ ստեղծել։</translation>
<translation id="3909353120217047026">Այս ընդլայնումը խախտում է Chrome Web Store-ի քաղաքականությունը և կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Taktak-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="3941890832296813527">Տեղադրման սխալ. տեղադրման ծրագրի ֆայլի անվանումն անվավեր է կամ չի աջակցվում։</translation>
<translation id="3945058413678539331">Taktak-ը փորձում է պատճենել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="3954172517175569325">Ձեր գաղտնաբառերը, վճարման եղանակները և հասցեները, որոնք պահել եք ձեր Taktak հաշվում, կհեռացվեն այս սարքից։ Taktak-ում դրանք նորից օգտագործելու համար պետք է նորից մուտք գործեք։</translation>
<translation id="395904275706073188">Պաշտպանված էջերը հնարավոր չէ ընթերցել։ Փորձեք այլ էջ։</translation>
<translation id="3962647064319009959">Ինչպես է Taktak-ն ապահով պահում ձեր տվյալները</translation>
<translation id="3971865010372729242">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Taktak-ը ձեր հարցումն ուղարկում է ձեր կազմակերպության որոնողական համակարգին, ԱԲ-ին և գործակալական գործիքներին՝ առաջարկներ ստանալու համար։</translation>
<translation id="3975724895399328945">&amp;Taktak for Testing-ի մասին</translation>
<translation id="3997429360543082038">ChromiumOS-ի մասին</translation>
<translation id="4019629340646866719">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա, ինչպիսին է <ph name="BEGIN_LINK_LINUX_OSS" />Լինուքսի մշակման միջավայրը<ph name="END_LINK_LINUX_OSS" />։</translation>
<translation id="4022972681110646219">Թարգմանել էկրանը</translation>
<translation id="4023601594785368013">Բնօրինակի լեզուն՝ <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Հղումները բացեք Taktak-ում ցանկացած հավելվածից։ Հեշտ մուտքի համար դիտարկիչն ամրացվում է խնդրագոտում։</translation>
<translation id="4036079820698952681">Օգնեք կատարելագործել Taktak-ը՝ հաղորդելով <ph name="BEGIN_LINK" />ընթացիկ կարգավորումների<ph name="END_LINK" /> մասին</translation>
<translation id="4050175100176540509">Վերջին տարբերակում առկա են անվտանգության կարևոր բարելավումներ և նոր գործառույթներ:</translation>
<translation id="4055805654398742145">Գ&amp;աղտնաբառերի կառավարիչ</translation>
<translation id="4095980151185649725">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է Taktak-ը, երբ այն 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է Taktak-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է Taktak-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}}</translation>
<translation id="4118474109249235144">Taktak ինկոգնիտո</translation>
<translation id="4122186850977583290">Անցնել «Taktak-ի մասին» էջ</translation>
<translation id="4148957013307229264">Տեղադրում…</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> – Ցանցի մուտքի էջ – Taktak</translation>
<translation id="421369550622382712">Հավելվածների, խաղերի, ընդլայնումների և թեմաների լայն ընտրանի Taktak-ի համար:</translation>
<translation id="4217080900579554343">Ձեր բոլոր համակարգիչներում այս ընդլայնումը և ավելին ստանալու համար մուտք գործեք Taktak</translation>
<translation id="4217972271355023382">Ձեր ծնողների ընտրած ավելի անվտանգ կարգավորումներն օգտագործելու համար անցեք Taktak պրոֆիլ, որտեղ արդեն մուտք եք գործել որպես <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Չեղարկվում է…</translation>
<translation id="4224210481850767180">Տեղադրումը չեղարկվել է։</translation>
<translation id="4230135487732243613">Կապել Taktak-ի տվյալներն այս հաշվի հետ:</translation>
<translation id="4251772536351901305">Զգուշացնում է ձեզ վտանգավոր, այդ թվում՝ Taktak-ին նախկինում անհայտ կայքերի մասին, քանի որ ավելի շատ տվյալներ է վերլուծում կայքերում՝ համեմատած ստանդարտ պաշտպանության հետ։ Դուք կարող եք բաց թողնել Taktak-ի նախազգուշացումները։</translation>
<translation id="4269093074552541569">Դուրս գալ Taktak-ից</translation>
<translation id="4271805377592243930">Taktak-ի օգնության էջ</translation>
<translation id="4281844954008187215">Օգտագործման պայմաններ</translation>
<translation id="4285930937574705105">Անհայտ սխալի պատճառով տեղադրումը չհաջողվեց: Եթե Taktak-ը բաց է, փակեք այն և կրկին փորձեք:</translation>
<translation id="4304713468139749426">Գաղտնաբառերի կառավարիչ</translation>
<translation id="4334241893986177674">Որոնում այս սքրինշոթում</translation>
<translation id="4334294535648607276">Ներբեռնումն ավարտվեց:</translation>
<translation id="439358628917130594">Ադմինիստրատորը (<ph name="MANAGER" />) պահանջում է, որ դուք նախքան սարքն օգտագործելը կարդաք և ընդունեք հետևյալ Օգտագործման պայմանները։ Այս պայմանները չեն ընդլայնում, փոփոխում կամ սահմանափակում Taktak ChromiumOS-ի պայմանները։</translation>
<translation id="4407044323746248786">Փակե՞լ Taktak-ը։</translation>
<translation id="4413205837991854510">Միշտ ցույց տալ պատկերով որոնման դյուրանցումը</translation>
<translation id="4415566066719264597">Թույլատրել Taktak-ին աշխատել ֆոնային ռեժիմում</translation>
<translation id="4419831163359812184">{NUM_EXTENSIONS,plural, =1{Taktak-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}one{Taktak-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}other{Taktak-ը խորհուրդ է տալիս հեռացնել դրանք։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}}</translation>
<translation id="4423735387467980091">Հարմարեցնել և վերահսկել Taktak-ը</translation>
<translation id="4427306783828095590">Լրացուցիչ պաշտպանությունն օգնում է խուսափել ֆիշինգից և արգելափակել վնասաբեր ծրագրերը</translation>
<translation id="4434353761996769206">Տեղադրիչի սխալ՝ <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438870983368648614">Taktak-ը կառավարվում է <ph name="MANAGER" />-ի կողմից</translation>
<translation id="444069871276811466">Ավելացնել Taktak պրոֆիլ</translation>
<translation id="4447409407328223819">Taktak for Testing-ի մասին</translation>
<translation id="4470974262661801543">Taktak-ի տվյալները ձեր Taktak հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="4493028449971051158">Մեկնարկի սխալ․ գործարկեք տեղադրիչը որպես ադմինիստրատոր։</translation>
<translation id="4501471624619070934">Չհաջողվեց տեղադրել, քանի որ այս երկրում հասանելիության սահմանափակումներ կան։</translation>
<translation id="4510853178268397146">Այս ընդլայնումը չի հրապարակել գաղտնիության քաղաքականություն, օրինակ՝ թե ինչպես է այն հավաքում և օգտագործում տվյալները։ Taktak-ը խորհուրդ է տալիս հեռացնել այն։</translation>
<translation id="452711251841752011">Բարի գալուստ Taktak․ բացված է դիտարկիչի նոր պատուհան</translation>
<translation id="4531137820806573936">Taktak-ին անհրաժեշտ է թույլտվություն՝ ձեր շրջակայքի քարտեզը ստեղծելու և ձեր ձեռքերի շարժումները հետագծելու համար</translation>
<translation id="4534145890176164066">Taktak-ը ավելի լավ է որոշում ձևերը և ավելի արագ ավտոմատ լրացնում դրանք</translation>
<translation id="4536805923587466102">Դուք արդեն մուտք եք գործել <ph name="USER_EMAIL_ADDRESS" /> հաշիվ մյուս Taktak պրոֆիլում</translation>
<translation id="4548534452171747496">Taktak-ը նախապես բեռնում է էջերը՝ արագացնելով դիտարկումն ու որոնումը։ <ph name="BEGIN_LINK" />Իմանալ ավելին էջերի նախաբեռնման մասին<ph name="END_LINK" /></translation>
<translation id="4567424176335768812">Դուք մուտք եք գործել որպես <ph name="USER_EMAIL_ADDRESS" />: Այժմ կարող եք օգտագործել ձեր էջանիշները, պատմությունը և այլ կարգավորումները ձեր բոլոր մուտք գործած սարքերում:</translation>
<translation id="4570813286784708942">Taktak-ն արգելափակել է այս ներբեռնումը, քանի որ դուք անջատել եք Անվտանգ դիտարկումը, և ֆայլը հնարավոր չէ ստուգել</translation>
<translation id="4594305310729380060">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="459535195905078186">Taktak հավելվածներ</translation>
<translation id="4598116752460667024">Ցանկում գտեք անհրաժեշտ գործընթացը։</translation>
<translation id="4613863813562375431">ChromiumOS-ի տարբերակը</translation>
<translation id="4621240073146040695">Գրեթե պատրաստ է: Վերագործարկեք Taktak-ը՝ թարմացումն ավարտելու համար:</translation>
<translation id="4625064703209785397">Արագացնում է կայքերի աշխատանքը Taktak-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում Taktak-ը հարձակումների նկատմամբ</translation>
<translation id="4654936675281451226">Taktak-ը ավելի լավ է որոշում ձևերը և ավելի արագ ավտոմատ լրացնում դրանք։ Այս կարգավորումը միացված է։</translation>
<translation id="4665829708273112819">Ուշադրություն․ Taktak-ը չի կարող արգելել ընդլայնումներին գրանցել ձեր այցելությունների պատմությունը։ Ընդլայնումն ինկոգնիտո ռեժիմում անջատելու համար ապանշեք այս պարամետրը։</translation>
<translation id="4673151026126227699">Եթե դուք նաև ուղարկում եք Taktak-ի օգտագործման մասին հաշվետվություններ, դրանցում կներառվեն ձեր այցելած URL-ները։</translation>
<translation id="4677944499843243528">Կարծես թե պրոֆիլն օգտագործվում է Taktak-ի այլ գործընթացի կողմից (<ph name="PROCESS_ID" />) այլ համակարգչում (<ph name="HOST_NAME" />): Taktak-ը կողպել է պրոֆիլը, որպեսզի այն չվնասվի: Եթե համոզված եք, որ պրոֆիլը չի օգտագործվում այլ գործընթացների կողմից, կարող եք ապակողպել պրոֆիլը և նորից գործարկել Taktak-ը:</translation>
<translation id="4680828127924988555">Չեղարկել տեղադրումը</translation>
<translation id="469259825538636168">Taktak-ի որոշ տվյալներ դեռ չեն պահվել ձեր Taktak հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="4708193446201257833">Հաշիվ մուտք գործած ժամանակ Taktak-ում դուք կարող եք օգտագործել ձեր գաղտնաբառերն ու մյուս կարգավորումները ձեր Taktak հաշվից։ <ph name="SHORTCUT" /> դյուրանցումով կարող եք փոխել Taktak-ի ձեր ծառայությունների կարգավորումները։</translation>
<translation id="4708774505295300557">Ինչ-որ մեկն այս համակարգչում <ph name="ACCOUNT_EMAIL_LAST" /> հասցեով մուտք է գործել Taktak: Ստեղծեք Taktak-ի նոր պրոֆիլ` ձեր տվյալներն առանձին պահելու համար:</translation>
<translation id="4724676981607797757">Չհաջողվեց տեղադրել հավելվածը, քանի որ չաջակցվող հաղորդակարգի կիրառման արդյունքում սխալ է առաջացել։</translation>
<translation id="4746050847053251315">Փակե՞լ Taktak-ը։</translation>
<translation id="4748217263233248895">Taktak-ի անվտանգության կարգավորումները հենց նոր թարմացվել են: Վերագործարկեք Taktak-ը, և ձեր ներդիրները կվերականգնվեն:</translation>
<translation id="4771701986670315895">Դուք վաղուց չեք այցելել կայք։ Taktak-ը հեռացրել է «<ph name="PERMISSION_1" />», «<ph name="PERMISSION_2" />» ու ևս <ph name="COUNT" /> թույլտվություն։</translation>
<translation id="4788777615168560705">Taktak-ը չի կարող ստուգել ձեր գաղտնաբառերը։ 24 ժամ հետո նորից փորձեք կամ <ph name="BEGIN_LINK" />ստուգեք ձեր Taktak հաշվի գաղտնաբառերը<ph name="END_LINK" />։</translation>
<translation id="479167709087336770">Օգտագործվում է միևնույն ուղղագրիչը, ինչ Taktak Որոնման մեջ: Դիտարկիչում մուտքագրված տեքստերն ուղարկվում են Taktak-ին: Սա կարող եք փոխել կարգավորումներում։</translation>
<translation id="4814736265800133385">Օգտագործել Taktak-ն առանց հաշվի</translation>
<translation id="4888717733111232871">Թույլատրել Taktak-ում տվյալների մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="4893347770495441059">Վերագործարկել՝ &amp;Taktak-ը թարմացնելու համար</translation>
<translation id="4918844574251943176">Պատկերը պատճենվեց</translation>
<translation id="4943838377383847465">Taktak-ն աշխատում է ֆոնային ռեժիմում:</translation>
<translation id="494490797786467921">Սեղմեք՝ Taktak մտնելու երկխոսության պատուհանը փակելու համար</translation>
<translation id="4950660488495335294">Taktak պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օգտատերերից։ Ստեղծեք պրոֆիլներ ձեր ընկերների և ընտանիքի անդամների կամ գործնական և անձնական նպատակների համար։</translation>
<translation id="4987820182225656817">Օգտագործելով Taktak-ը հյուրի ռեժիմում՝ դուք ոչ մի հետք չեք թողնում:</translation>
<translation id="4994636714258228724">Ավելացրեք ձեր հաշիվը Taktak-ին</translation>
<translation id="5123973130450702873">Taktak-ին անհրաժեշտ է թույլտվություն՝ ձեր ձեռքերի շարժումները հետագծելու համար</translation>
<translation id="5141988424377517949">Դուք վաղուց չեք այցելել կայք։ Taktak-ը հեռացրել է «<ph name="PERMISSION_1" />», «<ph name="PERMISSION_2" />» և «<ph name="PERMISSION_3" />» թույլտվությունները։</translation>
<translation id="5174969993834422967">Դուք սովորաբար արգելափակում եք ծանուցումները։ Հասցեագոտու աջ անկյունում սեղմեք ծանուցման պատկերակը, որպեսզի թույլ տաք կայքին ծանուցել ձեզ։</translation>
<translation id="5187123684706427865">Taktak հաշիվը պահանջում է վերաիսկորոշում</translation>
<translation id="5224391634244552924">Պահված գաղտնաբառեր չկան։ Taktak-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք։</translation>
<translation id="5231355151045086930">Դուրս գալ Taktak-ից</translation>
<translation id="5234764350956374838">Փակել</translation>
<translation id="5254739261293693943">Հարցնել այս տեսանյութի մասին</translation>
<translation id="5277894862589591112">Փոփոխությունները կիրառելու համար վերագործարկեք Taktak-ը</translation>
<translation id="5286907366254680517">Ճանաչվել է</translation>
<translation id="5294316920224716406">Երբ ինկոգնիտո ռեժիմում դիտարկելիս լինեք, նախքան ոչ ապահով միացման միջոցով կայք բեռնելը Taktak-ը ձեզ կնախազգուշացնի</translation>
<translation id="5296845517486664001">Եթե փորձնական գործառույթները միացված են, և Taktak-ը պատահականության սկզբունքով ձեզ ընտրում է ակտիվ փորձարկմանը մասնակցության համար, ձեր այցելությունների պատմությունն ազդում է ձեզ ցուցադրվող գովազդի և ստորև ներկայացված հետաքրքրությունների վրա։ Ձեր գաղտնիությունը պաշտպանելու նպատակով Taktak-ը ամեն ամիս ջնջում է ձեր հետաքրքրությունները։</translation>
<translation id="5313228254328109263">Taktak Updater ներքին ծառայություն</translation>
<translation id="5352264705793813212">Taktak-ը անվտանգության հետ կապված որոշ առաջարկներ է գտել ձեզ համար</translation>
<translation id="5352361688875342522">Taktak-ի այլ պրոֆիլներ</translation>
<translation id="5358375970380395591">Դուք մուտք եք գործում վերահսկվող հաշիվ՝ թույլ տալով ադմինիստրատորին կառավարել ձեր Taktak պրոֆիլը: Ձեր Taktak-ի տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները, մշտապես կկապվեն <ph name="USER_NAME" />-ի հետ: Դուք կկարողանաք ջնջել այս տվյալները Taktak Dashboard-ի միջոցով, սակայն չեք կարողանա համակցել դրանք այլ հաշվի հետ: <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Լրացուցիչ կոդ՝ <ph name="EXTRA_CODE" />։</translation>
<translation id="5377622451696208284">Անհատականացումը կարգավորելու համար ավելացրեք Taktak-ը Վեբ որոնման և հավելվածների պատմության մեջ</translation>
<translation id="5383439451358640070">Իմացեք, թե ինչու է Taktak-ն արգելափակում որոշ ֆայլեր</translation>
<translation id="5386450000063123300">Taktak-ի թարմացում (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Թույլատրել մուտքը Taktak-ում</translation>
<translation id="5405650547142096840">Հեռացնել Taktak-ից</translation>
<translation id="5424544524441439284">Արդյունավետությունը կնվազի, սակայն Taktak-ն ավելի դիմակայուն կդառնա հարձակումների նկատմամբ</translation>
<translation id="5427571867875391349">Դարձնել Taktak-ը կանխադրված դիտարկիչը</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> – Taktak բետա</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Taktak-ը խորհուրդ է տալիս դադարեցնել ներդիրը, որը դադաղեցնում է ձեր դիտարկիչը}one{Taktak-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}other{Taktak-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}}</translation>
<translation id="5473971139929175403">Taktak-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Լինուքսի այս բաշխման մեջ։</translation>
<translation id="5475924890392386523">Taktak-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը կարող է վնասել ձեր անձնական և սոցիալական ցանցերի հաշիվները</translation>
<translation id="5480860683791598150">Taktak-ին այս կայքի համար անհրաժեշտ է ձեզ տեղորոշելու թույլտվություն</translation>
<translation id="5487574057737591516">Ձեր գաղտնիությունը պաշտպանելու նպատակով մենք 4 շաբաթից ավտոմատ ջնջում ենք ձեր հետաքրքրությունները։ Երբ դուք շարունակում եք դիտել վեբ էջեր, համապատասխան հետաքրքրությունը կարող է նորից հայտնվել ցանկում։ Եթե Taktak-ը սխալ է որոշել ձեր հետաքրքրությունը, կամ դուք չեք ուզում տեսնել որոշակի գովազդներ, կարող եք հեռացնել հետաքրքրությունը։</translation>
<translation id="549669000822060376">Սպասեք` մինչ Taktak-ը տեղադրում է համակարգի նորագույն թարմացումները:</translation>
<translation id="5496810170689441661">Taktak-ը փորձում է փոխել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="5524890928877629608">որոնման տարածքի վերևի ձախ անկյուն՝ <ph name="LEFT" />% ձախից, <ph name="TOP" />% վերևից</translation>
<translation id="5527463683072221100">Բացել PDF ֆայլեր Taktak-ում</translation>
<translation id="5579324208890605088">Մեկնարկի սխալ․ գործարկեք տեղադրիչը որպես սովորական օգտատեր, այլ ոչ որպես ադմինիստրատոր։</translation>
<translation id="5580770360767802657">Դարձրեք Taktak-ը ձեր կանխադրված դիտարկիչը և ամրացրեք այն</translation>
<translation id="5596627076506792578">Լրացուցիչ ընտրանքներ</translation>
<translation id="5605834417512968703">Ընտրեք որևէ բան՝ «Որոնում պատկերով» գործառույթի միջոցով որոնելու համար, կամ սեղմեք Escape՝ այդ գործառույթից դուրս գալու համար</translation>
<translation id="5618818588972826921">Ընտրեք ցանկացած տեքստ կամ պատկեր պատկերների որոնման միջոցով որոնելու համար կամ սեղմեք Escape՝ պատկերների միջոցով որոնումից դուրս գալու համար</translation>
<translation id="5623402015214259806">{0,plural, =0{Հասանելի է Taktak-ի նոր տարբերակը}=1{Հասանելի է Taktak-ի նոր տարբերակը}one{Taktak-ի նոր տարբերակը # օր է հասանելի է}other{Taktak-ի նոր տարբերակը # օր է հասանելի է}}</translation>
<translation id="5643865575100044307">Միշտ ջնջել կայքերի տվյալները սարքից՝ Taktak-ը փակելու դեպքում</translation>
<translation id="5653831366781983928">Վերագործարկեք Taktak-ը</translation>
<translation id="5690427481109656848">Taktak LLC</translation>
<translation id="5698481217667032250">Taktak-ը ցուցադրել այս լեզվով</translation>
<translation id="569897634095159764">Հնարավոր չէ միանալ ինտերնետին։ Պրոքսի սերվերն իսկորոշում է պահանջում։</translation>
<translation id="5768371961535086509">Taktak-ը ազատում է ոչ ակտիվ ներդիրներին հատկացված հիշողությունը։ Դրա շնորհիվ ակտիվ ներդիրներն ու մյուս հավելվածները համակարգչի ավելի շատ ռեսուրսներից են կարողանում օգտվել, իսկ Taktak-ը կարողանում է արագ աշխատել։ Ոչ ակտիվ ներդիրներն ավտոմատ կակտիվանան, երբ նորից սկսեք օգտագործել դրանք։ <ph name="BEGIN_LINK" />Իմանալ ավելին Հիշողության տնտեսման մասին<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, խորհուրդ ենք տալիս <ph name="SETTINGS_LINK" /> Taktak-ի տվյալները ձեր հաշվից</translation>
<translation id="5800158606660203929">Անհատականացրեք և վերահսկեք Taktak-ը։ Դարձրեք Taktak-ը ձեր կանխադրված դիտարկիչը։</translation>
<translation id="5809516625706423866">Հնարավոր չէ միանալ ինտերնետին։ HTTP 401 Unauthorized։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="5817952762723416573">Արագացնում է կայքերի աշխատանքը Taktak-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում Taktak-ը հարձակումների նկատմամբ։ Այս կարգավորումն անջատված է։</translation>
<translation id="5821520528363214608">Taktak-ի տվյալները ձեր Taktak հաշվում օգտագործելու և պահելու համար թարմացրեք Taktak-ը</translation>
<translation id="5824893331272123205">Չհաջողվեց բեռնել այս վահանակը։ Նորից փորձեք։</translation>
<translation id="5862307444128926510">Բարի գալուստ Taktak</translation>
<translation id="5871205389137001634">Սեղմեք՝ «Որոնում պատկերով» գործառույթից դուրս գալու համար</translation>
<translation id="5883558403894052917">Taktak-ը այս տարրերում վնասագիր է հայտնաբերել՝</translation>
<translation id="5889361821821684993">Taktak-ը պարբերաբար ստուգում է իրականացնում՝ համոզվելու, որ ձեր դիտարկիչն ամենաանվտանգ կարգավորումներն ունի։ Մենք ձեզ կտեղեկացնենք, եթե որևէ բան փոխելու անհրաժեշտություն լինի։</translation>
<translation id="5895138241574237353">Վերագործարկել</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Ցանցի մուտք</translation>
<translation id="5924017743176219022">Միացում համացանցին…</translation>
<translation id="5941711191222866238">Նվազեցնել</translation>
<translation id="5949225980829865667">Որպեսզի այս էջանիշը և այլ տվյալներ հասանելի լինեն ձեր բոլոր սարքերում, մուտք գործեք Taktak</translation>
<translation id="5968400720580217226">ԱԲ ռեժիմ</translation>
<translation id="5972142260211327093">Եթե Taktak-ը պատահականության սկզբունքով ձեզ ընտրում է ակտիվ փորձարկմանը մասնակցության համար, ձեր այցելությունների պատմությունն ազդում է ձեզ ցուցադրվող գովազդի և ստորև ներկայացված հետաքրքրությունների վրա։ Ձեր գաղտնիությունը պաշտպանելու նպատակով Taktak-ը ամեն ամիս ջնջում է ձեր հետաքրքրությունները։ Հետաքրքրությունները թարմացվում են, եթե դրանք չեք հեռացնում։</translation>
<translation id="5986585015444752010">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է Taktak-ը, երբ այն 1 րոպե չի օգտագործվում։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է Taktak-ը, երբ այն # րոպե չի օգտագործվում։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է Taktak-ը, երբ այն # րոպե չի օգտագործվում։}}</translation>
<translation id="5987687638152509985">Թարմացրեք Taktak-ը՝ համաժամացումը սկսելու համար</translation>
<translation id="5988505247484123880">Սովորաբար կայքերը, որոնք դուք այցելում եք, հիշում են, թե ձեզ ինչն է հետաքրքրում, որպեսզի անհատականացնեն գովազդը ձեզ համար։ Կայքերը կարող են նաև ձեր հետաքրքրությունների մասին տեղեկություններ պահել Taktak-ում։</translation>
<translation id="6003112304606738118">Ներբեռնում… Մնաց <ph name="HOURS" /> ժամ</translation>
<translation id="6009821354356307391">Լրացուցիչ հարցեր տվեք</translation>
<translation id="6040143037577758943">Փակել</translation>
<translation id="6058380562449900225">Ձեր տվյալները պաշտպանելու համար թույլ տվեք Taktak-ին հեռացնել թույլտվություններն այն կայքերից, որոնք վերջերս չեք այցելել։ Ընդ որում՝ ծանուցումները չեն անջատվի։</translation>
<translation id="6063093106622310249">&amp;Բացել Taktak-ում</translation>
<translation id="6069027071882229820">Պատճենել որպես պատկեր</translation>
<translation id="6072279588547424923">«<ph name="EXTENSION_NAME" />» ընդլայնումն ավելացվել է Taktak-ին</translation>
<translation id="6072463441809498330">Արագացրեք Taktak-ի աշխատանքը</translation>
<translation id="6096348254544841612">Հասանելի է Taktak-ի նոր տարբերակը։</translation>
<translation id="6107893135096467929">Միացված է • Taktak-ը չի կարող հաստատել այս ընդլայնման ծագումը</translation>
<translation id="6119438414301547735">Թույլատրել ընդլայնմանը մուտքի հարցումներ ցուցադրել Taktak-ի գործիքագոտում</translation>
<translation id="6129621093834146363"><ph name="FILE_NAME" /> ֆայլը վտանգավոր է, և Taktak-ն արգելափակել է այն։</translation>
<translation id="6132897690380286411">Taktak-ը շուտով կփակվի և կջնջի տվյալները</translation>
<translation id="6145820983052037069">Այստեղ կարող եք անցնել Taktak-ի այլ պրոֆիլի</translation>
<translation id="615103374448673771">Եթե դուք թույլատրում եք քուքիների օգտագործումը, Taktak-ը կարող է դրանք օգտագործել նախաբեռնման ժամանակ</translation>
<translation id="6165508094623778733">Իմանալ ավելին</translation>
<translation id="6173308241973263798">Մաքրել Taktak-ի տվյալները ձեր հաշվից</translation>
<translation id="6174920971222007286">Այս ֆայլը կարող է վտանգավոր լինել<ph name="LINE_BREAK" />Taktak-ը կարող է ստուգել այն, եթե մուտքագրեք ձեր գաղտնաբառը։ Ֆայլի մասին տեղեկությունները կուղարկվեն «Taktak Ապահով դիտարկում» ծառայությանը, սակայն ֆայլի բովանդակությունը և գաղտնաբառը կմնան ձեր սարքում։</translation>
<translation id="6182736845697986886">Չհաջողվեց տեղադրել հավելվածը թարմացումն իրականացնող սերվերի ներքին սխալի պատճառով։</translation>
<translation id="6183079672144801177">Համոզվեք, որ մուտք եք գործել հաշիվ <ph name="TARGET_DEVICE_NAME" /> սարքի Taktak դիտարկիչում և փորձեք նորից ուղարկել։</translation>
<translation id="6212496753309875659">Այս համակարգչում արդեն տեղադրված է Taktak-ի ավելի նոր տարբերակը: Եթե ծրագրակազմը չի աշխատում, ապատեղադրեք Taktak-ը և նորից փորձեք:</translation>
<translation id="6219195342503754812">{0,plural, =0{Taktak-ը հիմա կվերագործարկվի}=1{Taktak-ը կվերագործարկվի 1 վայրկյանից}one{Taktak-ը կվերագործարկվի # վայրկյանից}other{Taktak-ը կվերագործարկվի # վայրկյանից}}</translation>
<translation id="6239161312595354541">Հարցնել պատկերով որոնմանը այս տեսանյութի մասին</translation>
<translation id="6241367896540709610">Ֆայլեր ներբեռնելու համար Taktak-ին անհրաժեշտ է հիշողությունն օգտագործելու թույլտվություն</translation>
<translation id="6245734527075554892">Ստուգում է URL-ները Taktak-ում պահված վտանգավոր կայքերի ցանկի միջոցով։</translation>
<translation id="6248213926982192922">Դարձնել Taktak-ը կանխադրված դիտարկիչ</translation>
<translation id="6268381023930128611">Դուրս գա՞լ Taktak-ից:</translation>
<translation id="6270547683008298381">Այս ներդիրները լրացուցիչ ռեսուրսներ են օգտագործում։ Թույլատրեք Taktak-ին ապակտիվացնել դրանք, և աշխատանքի արդյունավետությունը կբարձրանա։</translation>
<translation id="6281746429495226318">Անհատականացնել Taktak-ի պրոֆիլը</translation>
<translation id="6290827346642914212">Անվանեք ձեր Taktak պրոֆիլը</translation>
<translation id="6294831894865512704">Ընդլայնումն ուզում է, որ դուք մուտք գործեք Taktak</translation>
<translation id="6295779123002464101"><ph name="FILE_NAME" /> ֆայլը կարող է վտանգավոր լինել, և Taktak-ն արգելափակել է այն։</translation>
<translation id="6309712487085796862">Taktak-ն օգտագործում է ձեր տեսախցիկը:</translation>
<translation id="6327105987658262776">Հասանելի թարմացումներ չկան։</translation>
<translation id="6333502561965082103">Taktak-ում տեղադրման մեկ այլ գործողություն ընթացքի մեջ է: Փորձեք ավելի ուշ:</translation>
<translation id="6334986366598267305">Այժմ ավելի հեշտ է օգտագործել Taktak-ը ձեր Taktak հաշվի հետ, այդ թվում նաև համօգտագործվող համակարգիչներով:</translation>
<translation id="6347933965114150440">Taktak-ի դյուրանցում</translation>
<translation id="6366160072964553914">Taktak-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="6373523479360886564">Հեռացնե՞լ Taktak-ը:</translation>
<translation id="6375219077595103062">Ավելացրեք Գաղտնաբառերի կառավարչի դյուրանցումը</translation>
<translation id="6388799252195623474">ինձ օգնություն է անհրաժեշտ</translation>
<translation id="6390800440335263989">Շարունակելու համար մուտք գործեք Taktak <ph name="EMAIL" /> էլփոստով։ Սա ապահովում է, որ դուք ունեք ձեր կազմակերպության կանոնները։</translation>
<translation id="6400112897226594999">Taktak-ի լոգոն՝ համակարգչի էկրանին։</translation>
<translation id="6403826409255603130">Taktak-ը վեբ դիտարկիչ է, որը կայծակի արագությամբ է բացում վեբէջերն ու հավելվածները: Այն արագ է, կայուն և պարզ՝ օգտագործման մեջ: Ավելի ապահով աշխատեք համացանցում՝ վնասագրերի և խաբկայքերի դեմ ներկառուցված պաշտպանության շնորհիվ:</translation>
<translation id="6436260184216827876">«Որոնում պատկերով» գործառույթը հասանելի չէ։ Փորձեք ավելի ուշ։</translation>
<translation id="6442900851116057561">Վերագործարկեք ChromiumOS-ը</translation>
<translation id="6443470774889161065">Taktak-ը նախապես բեռնում է էլ ավելի շատ էջեր, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="645458117210240797">Անջատված է • Taktak-ը չի կարող հաստատել այս ընդլայնման ծագումը</translation>
<translation id="6455857529632101747">Բարի գալուստ Taktak պրոֆիլներ</translation>
<translation id="6466344609055215035">Հեռացնել հաշիվը Taktak-ից</translation>
<translation id="6475912303565314141">Այն նաև վերահսկում է, թե որ էջը ցուցադրվի Taktak-ը մեկնարկելիս:</translation>
<translation id="648319183876919572">Բարելավված Ապահով դիտարկումն օգնում է պաշտպանվել վտանգավոր կայքերից և ներբեռնումներից</translation>
<translation id="6510925080656968729">Ապատեղադրել Taktak-ը</translation>
<translation id="651535675648445253">Դյուրանցումները բացվում են Taktak-ում</translation>
<translation id="6524389414524528185">Հաշիվ մուտք գործած ժամանակ Taktak-ում դուք կարող եք օգտագործել ձեր գաղտնաբառերն ու մյուս կարգավորումները ձեր Taktak հաշվից։ Սա ցանկացած ժամանակ կարող եք փոխել կարգավորումներում։</translation>
<translation id="6539122709674868420">Ձեր կազմակերպությունը փակում է Taktak-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այցելությունների պատմությունը ջնջվել է։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="6542839706527980775">Յուրաքանչյուր պրոֆիլում առանձին պահվում են Taktak-ի օգտատերերի տվյալները, օրինակ՝ էջանիշները, պատմությունը, գաղտնաբառերը և այլն</translation>
<translation id="6563921047760808519">Իմացեք ավելին, թե <ph name="BEGIN_LINK" />ինչպես է Taktak-ը պահպանում ձեր տվյալների գաղտնիությունը<ph name="END_LINK" /></translation>
<translation id="6564039629497156115">Այս կարգավորումների փոփոխությունները կկիրառվեն Taktak-ի վերագործարկումից հետո։</translation>
<translation id="656935081669708576">Դուք կարող եք դիտել գաղտնաբառերը՝ անցնելով մյուս Taktak պրոֆիլ</translation>
<translation id="6570579332384693436">Ուղղագրական սխալները շտկելու համար Taktak-ը Taktak-ին է ուղարկում տեքստային դաշտերում ձեր մուտքագրած տեքստը</translation>
<translation id="6598877126913850652">Անցնել Taktak-ի ծանուցումների կարգավորումներ</translation>
<translation id="6600016381025017075">Որոնեք ցանկացած բան այս էջում</translation>
<translation id="6613594504749178791">Փոփոխություններն ուժի մեջ կմտնեն Taktak-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="665732753414869868">Ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար Taktak-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="6669284030132180248">Պահելով էջանիշները Taktak հաշվում՝ դուք կարող եք հետագծել ապրանքների գները Taktak-ում և ստանալ զեղչերի մասին ծանուցումներ</translation>
<translation id="6676384891291319759">Մտնել համացանց</translation>
<translation id="668175097507315160">Մուտքի սխալի պատճառով ChromiumOS-ը չկարողացավ համաժամացնել ձեր տվյալները։</translation>
<translation id="6692797197837897398">Taktak-ը ձեզ տալիս է ավելի շատ հնարավորություններ՝ վերահսկելու ձեզ ցուցադրվող գովազդները, և սահմանափակում է ձեր մասին այն տվյալների ծավալը, որոնք հասանելի են դառնում կայքերին, երբ դրանք ձեզ անհատականացված գովազդ են ցուցադրում</translation>
<translation id="6709350901466051922">Այս կայքի համար Taktak-ին անհրաժեշտ է խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="6712881677154121168">Ներբեռնման սխալ՝ <ph name="DOWNLOAD_ERROR" />։</translation>
<translation id="6717134281241384636">Դուք չեք կարող օգտագործել ձեր պրոֆիլը, քանի որ այն Taktak-ի նոր տարբերակից է:

Որոշ գործառույթներ մատչելի չեն լինի: Հատկորոշեք այլ պրոֆիլի գրացուցակ կամ օգտվեք Taktak-ի ավելի նոր տարբերակից:</translation>
<translation id="6729124504294600478">Անհատականացումը և այլ գործառույթներ կարգավորելու համար ավելացրեք Taktak-ը Վեբ որոնման և հավելվածների պատմության մեջ և Taktak-ի կապված ծառայություններում</translation>
<translation id="6734291798041940871">Taktak-ն արդեն տեղադրված է ձեր համակարգչում բոլոր օգտատերերի համար:</translation>
<translation id="6751374565094704799">Արագացնում է կայքերի աշխատանքը Taktak-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում Taktak-ը հարձակումների նկատմամբ։ Այս կարգավորումը միացված է։</translation>
<translation id="67706546131546258">Taktak-ը խորհուրդ է տալիս ստուգել այս ֆայլը, քանի որ այն կարող է վտանգավոր լինել։</translation>
<translation id="6779406956731413166">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա։</translation>
<translation id="6831043979455480757">Թարգմանել</translation>
<translation id="6847869444787758381">Taktak-ը ձեզ տեղյակ կպահի, եթե ձեր գաղտնաբառերի անվտագությանը սպառնալիք լինի</translation>
<translation id="684888714667046800">Հնարավոր չէ միանալ ինտերնետին։ Հրապատ օգտագործելու դեպքում համոզվեք, որ <ph name="PRODUCT_EXE_NAME" /> ֆայլը թույլատրվածների ցուցակում է։</translation>
<translation id="6857782730669500492">Taktak – <ph name="PAGE_TITLE" /></translation>
<translation id="6862030660799253820">Որոնել այս պատկերը պատկերով որոնման միջոցով</translation>
<translation id="6873893289264747459">Taktak-ը «<ph name="EXTENSION_NAME" />» ընդլայնման մեջ վնասագիր է հայտնաբերել</translation>
<translation id="6877155553248388166">որոնման տարածքի ներքևի աջ անկյուն՝ <ph name="RIGHT" />% աջից, <ph name="BOTTOM" />% վերևից</translation>
<translation id="6896758677409633944">Պատճենել</translation>
<translation id="6901631050894301805">Նշեք Taktak-ը որպես կանխադրված դիտարկիչ և այն ամրացրեք ձեր հավելվածների վահանակում</translation>
<translation id="6929417474050522668">Երբ փորձաշրջանները միացված են, գովազդի արդյունավետության գնահատումը թույլ է տալիս ձեր այցելած կայքերին ստանալ Taktak-ից տեղեկություններ, որոնք օգնում են չափել այդ կայքերում ցուցադրվող գովազդի արդյունավետությունը։ Գովազդի արդյունավետության գնահատումը սահմանափակում է օգտատերերի գործողությունների միջկայքային հետագծումը՝ նվազագույնի հասցնելով կայքերի միջև տեղեկությունների փոխանցումը։</translation>
<translation id="6934579572334859869">Հարցնել պատկերով որոնմանը այս պատկերի մասին</translation>
<translation id="6940431691900807093">Ավելի ուշ կայքը, որն այցելում եք, կարող է Taktak-ից ձեր հետաքրքրությունները տեսնելու թույլտվություն խնդրել՝ ձեզ ցուցադրվող գովազդն անհատականացնելու նպատակով։ Taktak-ը կարող է հասանելի դարձնել ձեր մինչև 3 հետաքրքրությունների մասին տեղեկությունները։</translation>
<translation id="6964305034639999644">Բացել հղումը Taktak-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="6965382102122355670">Եղավ</translation>
<translation id="6978145336957848883">Թույլ գաղտնաբառերը հեշտ է գուշակել։ Թույլատրեք Taktak-ին <ph name="BEGIN_LINK" />գաղտնաբառեր ստեղծել և պահել ձեզ համար<ph name="END_LINK" />։</translation>
<translation id="6985329841647292029">ChromiumOS-ի պայմաններ</translation>
<translation id="6990124437352146030">Taktak-ին այս կայքի համար անհրաժեշտ է ձեր խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="7003299027384820442">Taktak-ի տվյալները <ph name="ACCOUNT_EMAIL" /> հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="7011190694940573312">Տեղադրումը ձախողվեց, քանի որ օպերացիոն համակարգի այս տարբերակը չի աջակցվում։</translation>
<translation id="7024536598735240744">Ապափաթեթավորման սխալ՝ <ph name="UNPACK_ERROR" />։</translation>
<translation id="7025789849649390912">Տեղադրումը կանգնեցվել է։</translation>
<translation id="7045244423563602563">Անհատականացրեք Taktak դիտարկիչը</translation>
<translation id="705851970750939768">Թարմացնել Taktak-ը</translation>
<translation id="7067091210845072982">Եթե պատկերն օգտակար նկարագրություն չունի, Taktak-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Taktak-ին՝ նկարագրություններ ստեղծելու համար։</translation>
<translation id="7141270731789036260">Անհատականացրեք Taktak for Testing-ը</translation>
<translation id="7163519456498498587">Հեռացնել <ph name="EXTENSION_NAME" /> ընդլայնումը Taktak-ից</translation>
<translation id="7173822816570314652">Ձեր կազմակերպությունը ջնջում է Taktak-ի տվյալները, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="718435575166326686">Այս կայքի համար Taktak-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="7196312274710523067">Չհաջողվեց գործարկել Taktak-ը։ Նորից փորձեք։</translation>
<translation id="7197677400338048821">Taktak-ը չի կարող ստուգել ձեր գաղտնաբառերը։ 24 ժամ հետո նորից փորձեք։</translation>
<translation id="7213407614656404070">Օգտագործեք Taktak-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա</translation>
<translation id="7223968959479464213">Խնդիրների կառավարիչ - Taktak</translation>
<translation id="7246575524853130370">Ձեր հետաքրքրությունները (ըստ Taktak-ի)</translation>
<translation id="7274695763216404502">«Որոնում պատկերով» գործառույթն ամրացված է․ այն այժմ հասանելի է գործիքագոտում</translation>
<translation id="7288567540154601580">Ներդիրներ և ընդլայնումներ</translation>
<translation id="7295544978856094497">{NUM_EXTENSIONS,plural, =1{Taktak-ը խորհուրդ է տալիս ձեզ հեռացնել այն}one{Taktak-ը խորհուրդ է տալիս ձեզ հեռացնել այն}other{Taktak-ը խորհուրդ է տալիս ձեզ հեռացնել դրանք}}</translation>
<translation id="7309928523159922338">Գովազդի արդյունավետության գնահատումը թույլ է տալիս ձեր այցելած կայքերին ստանալ Taktak-ից տեղեկություններ, որոնք օգնում են չափել այդ կայքերում ցուցադրվող գովազդի արդյունավետությունը։ Գովազդի արդյունավետության գնահատումը սահմանափակում է օգտատերերի գործողությունների միջկայքային հետագծումը՝ նվազագույնի հասցնելով կայքերի միջև տեղեկությունների փոխանցումը։</translation>
<translation id="731795002583552498">Taktak-ը թարմացվում է</translation>
<translation id="7318036098707714271">Ձեր նախընտրանքների ֆայլը վնասված է կամ անվավեր:

Taktak-ին չհաջողվեց վերականգնել ձեր կարգավորումները:</translation>
<translation id="7339898014177206373">Նոր պատուհան</translation>
<translation id="734373864078049451">Բոլոր վեբէջերը, էջանիշները և Taktak-ի այլ տվյալները պահվում են այստեղ:</translation>
<translation id="7349591376906416160">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել Taktak-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի <ph name="ALTERNATIVE_BROWSER_NAME" /> դիտարկիչով։</translation>
<translation id="7352651011704765696">Ինչ-որ սխալ տեղի ունեցավ</translation>
<translation id="7376384068949534168">Դուք վաղուց չեք այցելել կայք։ Taktak-ը հեռացրել է «<ph name="PERMISSION_1" />» և «<ph name="PERMISSION_2" />» թույլտվությունները։</translation>
<translation id="7384121030444253939">Այս ընդլայնումն այլևս չի աջակցվում։ Taktak-ը խորհուրդ է տալիս հեռացնել այն։</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> – Taktak Dev</translation>
<translation id="7450541714075000668">Տեքստը պատճենվեց</translation>
<translation id="7451052299415159299">Taktak-ին այս կայքի համար անհրաժեշտ է ձեր տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="7458892263350425044">Ձեր խոսափողն օգտագործելու համար Taktak-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
<translation id="7461356015007898716">Taktak-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 7 տարբերակը։</translation>
<translation id="7467949745582939695">Վերագործարկե՞լ Taktak-ը</translation>
<translation id="7483335560992089831">Հնարավոր չէ տեղադրել Taktak-ի նույն տարբերակը, որն այժմ գործարկվում է: Փակեք Taktak-ը և նորից փորձեք:</translation>
<translation id="7517403744065880907">Դուք կկարողանաք պահել գաղտնաբառեր ու այլ տվյալներ և օգտագործել դրանք ձեր Taktak հաշվում, եթե մտած եք հաշիվ Taktak-ում։ <ph name="LEARN_MORE" /></translation>
<translation id="751935028865900641">Կայքերի մեծ մասը ամենայն հավանականությամբ պատշաճ կերպով կաշխատի։ Դուք դուրս կգրվեք կայքերի մեծամասնությունից, երբ փակեք Taktak-ի բոլոր պատուհանները, սակայն կմնաք ձեր Taktak հաշվում, եթե մուտք եք գործել Taktak։</translation>
<translation id="753534427205733210">{0,plural, =1{Taktak-ը կվերագործարկվի 1 րոպեից}one{Taktak-ը կվերագործարկվի # րոպեից}other{Taktak-ը կվերագործարկվի # րոպեից}}</translation>
<translation id="7565444033145385702">Ձեր տվյալները պաշտպանելու համար թույլ տվեք Taktak-ին հեռացնել թույլտվություններն այն կայքերից, որոնք վերջերս չեք այցելել։</translation>
<translation id="7582945390259497898">Taktak-ը կարող է որոշել ձեր հետաքրքրությունները։ Ավելի ուշ կայքը, որն այցելում եք, կարող է Taktak-ից ձեր հետաքրքրությունները տեսնելու թույլտվություն խնդրել՝ ձեզ ցուցադրվող գովազդն անհատականացնելու նպատակով։</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" />-ի տեղադրիչ</translation>
<translation id="761356813943268536">Taktak-ն օգտագործում է ձեր տեսախցիկն ու խոսափողը:</translation>
<translation id="7617377681829253106">Taktak-ը կատարելագործվել է</translation>
<translation id="7622753900276619808">Այժմ Taktak-ում ձեզ ավելի շատ գործառույթներ են հասանելի</translation>
<translation id="7649070708921625228">Օգնություն</translation>
<translation id="7658239707568436148">Չեղարկել</translation>
<translation id="7686590090926151193">Taktak-ը ձեր կանխադրված դիտարկիչը չէ</translation>
<translation id="7689606757190482937">Համաժամացրեք և անհատականացրեք Taktak-ը ձեր բոլոր սարքերում</translation>
<translation id="7699779824407626136">Taktak-ի թարմացում</translation>
<translation id="7716950018788545737">Առաջադրանք(ներ)ը ավարտված են։</translation>
<translation id="77283119132245232">Տրամադրում է <ph name="BROWSER_NAME" /> դիտարկիչին համակարգի հետագծման ծառայություններ։ Եթե այս ծառայությունն անջատված է, դիտարկիչի կողմից ստեղծված արդյունավետության հետագծումները չեն ներառի համակարգային իրադարձություններ, ինչպիսիք են համատեքստի փոխանջատումը և հոսքի պատրաստությունը։</translation>
<translation id="7745317241717453663">Ձեր այցելությունների պատմությունը կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Taktak <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="7747138024166251722">Տեղադրիչը չկարողացավ ստեղծել ժամանակավոր գրացուցակ: Ստուգեք սկավառակում ազատ տարածքի առկայությունը և ծրագրակազմը տեղադրելու թույլտվությունը:</translation>
<translation id="7786760609782648049">Արագացրեք Taktak-ի աշխատանքը</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> – Taktak Canary</translation>
<translation id="7803986347287457849">Արեք այնպես, որ ձեր ինտերնետ թրաֆիկի հասանելիություն ունեցող մարդիկ չկարողանան տեսնել, թե ինչ կայքեր եք այցելել։ Taktak-ն օգտագործում է ապահով միացում՝ DNS-ում (տիրույթի անունների համակարգ) կայքերի IP հասցեները որոնելու համար։</translation>
<translation id="7810005234485217901">Ամրացրեք «Որոնում պատկերով» գործառույթը՝ արագ մուտքի համար</translation>
<translation id="7828947555739565424">Այս հաշվի հետ կապված Taktak-ի պրոֆիլ արդեն գոյություն ունի այս սարքում</translation>
<translation id="7845233973568007926">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր համակարգիչը։</translation>
<translation id="7859018312476869945">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Taktak-ը ձեր հարցումն ուղարկում է կանխադրված որոնողական համակարգին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="7867198900892795913">Չհաջողվեց տեղադրել Taktak-ի վերջին տարբերակը, որը թարմացվել է նոր գործառույթներով և անվտանգության բարելավումներով:</translation>
<translation id="7872446069773932638">Ներբեռնում… Մնաց <ph name="SECONDS" /> վայրկյան</translation>
<translation id="7877212753140190672">Հարցնել այս պատկերի մասին</translation>
<translation id="7888981273428720788">Դարձնել Taktak-ը ձեր կանխադրված դիտարկիչը</translation>
<translation id="7934340546140346950">Taktak-ը հնարավորության դեպքում ավտոմատ կերպով վերածում է ոչ ապահով միացումները HTTPS-ի</translation>
<translation id="7937630085815544518">Դուք մուտք եք գործել Taktak որպես <ph name="USER_EMAIL_ADDRESS" />: Նորից մուտք գործելու համար օգտագործեք նույն հաշիվը:</translation>
<translation id="7975919845073681630">Սա Taktak-ի երկրորդային տեղադրումն է: Այն չի կարող դառնալ ձեր կանխադրված դիտարկիչը:</translation>
<translation id="7997934263947464652">Անհայտ աղբյուրներից ընդլայնումները, հավելվածներն ու թեմաները կարող են վնասել ձեր սարքը։ Taktak-ը խորհուրդ է տալիս դրանք տեղադրել միայն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ից։</translation>
<translation id="8004582292198964060">Դիտարկիչ</translation>
<translation id="8010081455002666927">Ինքնահայտնաբերում</translation>
<translation id="8013436988911883588">Երբ Taktak-ը հասանելիություն ստանա, կայքերը կկարողանան ձեզնից հասանելիություն խնդրել։</translation>
<translation id="8031714377769448844">Ամրացրեք Taktak-ը խնդրագոտու վրա՝ այն ցանկացած պահի արագ բացելու համար</translation>
<translation id="80471789339884597">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր բոլոր դիտարկիչները։</translation>
<translation id="8054112667659782652">Միշտ ցույց տալ պատկերով որոնման դյուրանցումը</translation>
<translation id="8077498902115777962">Անջատել Taktak-ի ֆոնային ռեժիմը հավելվածների համար</translation>
<translation id="80790299200510644">Որոնում պատկերով</translation>
<translation id="8086881907087796310">Տեղադրումը ձախողվեց, քանի որ ձեր համակարգիչը չի համապատասխանում սարքակազմի նվազագույն պահանջներին։</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Taktak for Testing</translation>
<translation id="8105840573057009683">Այս կայքի համար Taktak-ին անհրաժեշտ է տեղորոշումն օգտագործելու թույլտվություն</translation>
<translation id="8118331347066725040">Կարծիք հայտնեք «Որոնել Տեսապակու միջոցով» գործառույթի մասին</translation>
<translation id="8133124826068723441">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ այդ գործառույթը հասանելի չէ ձեր տիրույթի համար։</translation>
<translation id="813913629614996137">Նախապատրաստվում է...</translation>
<translation id="81770708095080097">Այս ֆայլը վտանգավոր է, և Taktak-ն արգելափակել է այն։</translation>
<translation id="8177472873527554730">Էջում բովանդակություն գտնել հնարավոր չէ</translation>
<translation id="8200109504272824693">Taktak-ի տվյալները <ph name="USER_EMAIL" /> հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="8221491193165283816">Դուք սովորաբար արգելափակում եք ծանուցումները։ Այս կայքում ծանուցումներ ստանալու համար սեղմեք այստեղ։</translation>
<translation id="8223363452568144035">Ձեր տեսախցիկն օգտագործելու համար Taktak-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
<translation id="8232193495299001329">Taktak-ը չի կարող ստուգել այս ընդլայնման ծագումը, ուստի այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Taktak-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="8248265253516264921">Եթե պատկերն օգտակար նկարագրություն չունի, Taktak-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Taktak-ին՝ նկարագրություններ ստեղծելու համար։ Ցանկացած պահի կարգավորումներում կարող եք անջատել սա:</translation>
<translation id="8254601181414348851">Մուտք գործե՞լ Taktak նոր պրոֆիլում</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Taktak-ը զգուշացնում է ձեզ<ph name="END_LINK" /> վտանգավոր կայքերի և ներբեռնումների մասին</translation>
<translation id="8295827201165805317">Դուք վաղուց չեք այցելել կայք։ Taktak-ը հեռացրել է «<ph name="PERMISSION" />» թույլտվությունը։</translation>
<translation id="8313851650939857356">Մեկնարկի սխալ․ <ph name="STARTUP_ERROR" />։</translation>
<translation id="8318772038038596122">Ձեր կազմակերպությունը փակում է Taktak-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։</translation>
<translation id="8321888067342493336">Պահել որպես պատկեր</translation>
<translation id="8330519371938183845">Մտեք հաշիվ՝ Taktak-ը ձեր բոլոր սարքերում անհատականացնելու համար</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" />-ը նախկինում Taktak է օգտագործել</translation>
<translation id="8359544530202147897">Թարմացրեք Taktak-ը, որպեսզի շարունակեք օգտագործել Taktak-ի տվյալները ձեր <ph name="ACCOUNT_EMAIL" /> Taktak հաշվում։</translation>
<translation id="8360718212975266891">Taktak-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8 տարբերակը։</translation>
<translation id="8362914115861174987">Թարգմանության լեզու</translation>
<translation id="8370517070665726704">© Taktak LLC <ph name="YEAR" />։ Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8372327902843331129">Գաղտնաբառերը և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Taktak։ Այս գաղտնաբառը կպահվի ձեր Taktak հաշվում, երբ մուտք գործեք։</translation>
<translation id="837460953767177950">Այնուհետև անհրաժեշտ կլինի վերագործարկել Taktak-ը։</translation>
<translation id="8397248745433792218">Taktak-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" /></translation>
<translation id="8401454788024434101">Այս ընդլայնման հրապարակումը չեղարկվել է մշակողի կողմից, և այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Taktak-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="8416884904046428725">Որպեսզի որոշ տվյալներ հնարավոր լինի պահել ձեր Taktak հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, Taktak-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="8417404458978023919">{0,plural, =1{Վերագործարկեք Taktak-ը մեկ օրվա ընթացքում}one{Վերագործարկեք Taktak-ը # օրվա ընթացքում}other{Վերագործարկեք Taktak-ը # օրվա ընթացքում}}</translation>
<translation id="8438543370129609977">Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ուղարկվում են սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="8453117565092476964">Տեղադրիչի արխիվը վնասված է կամ անվավեր: Նորից ներբեռնեք Taktak-ը:</translation>
<translation id="8458614432758743027">Taktak-ի համար պահանջվում է Windows 10 կամ ավելի նոր տարբերակ։</translation>
<translation id="8463672209299734063">Ըստ ցանկության. օգնեք բարելավել ChromiumOS-ի գործառույթներն ու աշխատանքը՝ Taktak-ին ավտոմատ կերպով ուղարկելով օգտագործման և դիագնոստիկ տվյալները։</translation>
<translation id="8471947159125090285">Taktak-ի տվյալները ձեր Taktak հաշվում օգտագործելու և պահելու համար հաստատեք ձեր ինքնությունը</translation>
<translation id="8493179195440786826">Taktak-ը հնացած է</translation>
<translation id="8522801943730206384">Taktak-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք</translation>
<translation id="8555465886620020932">Ծառայության սխալ՝ <ph name="SERVICE_ERROR" />։</translation>
<translation id="8556420416730706394">«Որոնում պատկերով» գործառույթից արագ օգտվելու համար սեղմեք կողային վահանակի վերևի հատվածում գտնվող «Ամրացնել» կոճակը</translation>
<translation id="856656450041460113">Որոնել լեզուների ցանկում</translation>
<translation id="8568283329061645092">Taktak-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ մտնեք ձեր Taktak հաշիվ։</translation>
<translation id="8576826849825683917">Taktak-ը կառավարվում է մի քանի կազմակերպության կողմից</translation>
<translation id="8586442755830160949">© <ph name="YEAR" /> The Taktak Authors: Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8601359445272098721">Նորույթ․ դուք կարող եք ձեր էկրանին թարգմանել ինչպես տեքստ, այնպես էլ պատկերներ՝ սեղմելով «Թարգմանել էկրանը» կոճակը</translation>
<translation id="8619360774459241877">Taktak-ի գործարկում...</translation>
<translation id="8621669128220841554">Անհայտ սխալի պատճառով տեղադրումը չհաջողվեց: Նորից ներբեռնեք Taktak-ը:</translation>
<translation id="8648201657708811153">Taktak for Testing-ը չի կարող դառնալ ձեր կանխադրված դիտարկիչը։</translation>
<translation id="8697124171261953979">Այն նաև վերահսկում է Taktak-ի մեկնարկի կամ Omnibox-ից որոնում կատարելու ժամանակ ցուցադրվող էջը:</translation>
<translation id="8704119203788522458">Սա ձեր Taktak-ն է</translation>
<translation id="8712637175834984815">Պատրաստ է</translation>
<translation id="8719993436687031146">Մուտք գործե՞լ Taktak</translation>
<translation id="8747073452963259673">որոնման տարածքի ներքևի ձախ անկյուն՝ <ph name="LEFT" />% ձախից, <ph name="BOTTOM" />% վերևից</translation>
<translation id="8768722695577490596">Գաղտնաբառերը կարող են հեռացվել միայն Taktak-ից դուրս</translation>
<translation id="878572486461146056">Տեղադրման սխալ. ձեր ցանցի ադմինիստրատորը կիրառել է խմբային կանոն, որը կանխում է տեղադրումը՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="8796602469536043152">Taktak-ին այս կայքի համար անհրաժեշտ է ձեր տեսախցիկն ու խոսափողը օգտագործելու թույլտվություն</translation>
<translation id="8818550178040858407">Մուտք գործե՞լ Taktak</translation>
<translation id="8826492472752484139">Սեղմեք «Գաղտնաբառերի կառավարիչ»</translation>
<translation id="8833697763442816810">ChromiumOS համակարգ</translation>
<translation id="8852026904190808918">Այս լեզուն օգտագործվում է՝ Taktak-ում ընտրացանկերը, կարգավորումները, զգուշացումները և այլ տեքստեր ցուցադրելու համար</translation>
<translation id="8862326446509486874">Դուք չունեք համապատասխան իրավունքներ՝ համակարգի մակարդակով տեղադրում կատարելու համար: Փորձեք տեղադրումը կատարել որպես Ադմինիստրատոր:</translation>
<translation id="8876044221123442390">Ավելացնել Taktak պրոֆիլ</translation>
<translation id="8880203542552872219">Եթե այո, ապա փոխեք ձեր պահված գաղտնաբառը Taktak-ում, որպեսզի այն համապատասխանի ձեր նոր գաղտնաբառին։</translation>
<translation id="8891709362986793894">Ձեր կազմակերպության կանոնների համաձայն՝ դուք պետք է մուտք գործեք Taktak</translation>
<translation id="8907580949721785412">Taktak-ը փորձում է ցուցադրել գաղտնաբառերը: Մուտքագրեք ձեր Windows-ի գաղտնաբառը՝ այս գործողությունը թույլ տալու համար:</translation>
<translation id="8931379085695076764">Taktak-ը որոշում է ձեր հետաքրքրությունները վերջին մի քանի շաբաթվա ընթացքում ձեր այցելությունների պատմության հիման վրա։ Այս տեղեկությունները չեն փոխանցվում ձեր սարքից։</translation>
<translation id="8941642502866065432">Չհաջողվեց թարմացնել Taktak-ը</translation>
<translation id="897581876605952338">Taktak Enterprise-ի լոգո</translation>
<translation id="8988036198400390003">Կառավարել Taktak-ի պրոֆիլները</translation>
<translation id="9019929317751753759">Taktak-ն ավելի ապահով դարձնելու համար հետևյալ ընդլայնումներն անջատվել են, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացված լինել առանց ձեր իմացության։</translation>
<translation id="9022552996538154597">Մուտք գործել Taktak</translation>
<translation id="904366664621834601">Taktak-ն արգելափակել է այս ներբեռնումը, քանի որ արխիվացված ֆայլը կարող է այլ ֆայլեր պարունակել, որոնք կարող են վնասագրեր լինել</translation>
<translation id="9062666675513499497">Մուտք գործեք Taktak, երբ մուտք եք գործում Taktak-ի այլ ծառայություններ</translation>
<translation id="9078733879136747090">Taktak-ն ավտոմատ փակվել է</translation>
<translation id="9089354809943900324">Taktak-ը հնացել է</translation>
<translation id="9093206154853821181">{0,plural, =1{Taktak-ը կվերագործարկվի մեկ ժամից}one{Taktak-ը կվերագործարկվի # ժամից}other{Taktak-ը կվերագործարկվի # ժամից}}</translation>
<translation id="9106236359747881194">Ընտրեք տեքստը՝ որոնելու համար</translation>
<translation id="9106612006984859720">Taktak-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8.1 տարբերակը։</translation>
<translation id="91086099826398415">Բացել հղումը Taktak-ի նոր &amp;ներդիրում</translation>
<translation id="911206726377975832">Ջնջե՞լ նաև ձեր դիտարկումների տվյալները:</translation>
<translation id="9134482777260927479">Օգնություն տնային աշխատանքը կատարելիս</translation>
<translation id="9148058034647219655">Ելնել</translation>
<translation id="9158494823179993217">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել Taktak-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի մեկ այլ դիտարկիչով:</translation>
<translation id="9185526690718004400">Վերագործարկել՝ &amp;Taktak-ը թարմացնելու համար</translation>
<translation id="9190841055450128916">Taktak (mDNS-In)</translation>
<translation id="9206863043651638213">Ստացեք ավելին՝ մուտք գործելով Taktak</translation>
<translation id="924957577793602335">Անհատականացրեք Taktak-ը</translation>
<translation id="93478295209880648">Taktak-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Windows XP և Windows Vista համակարգերում</translation>
<translation id="945522503751344254">Կարծիք հայտնել</translation>
<translation id="965162752251293939">Ո՞վ է օգտագործում Taktak-ը</translation>
<translation id="967427899662692980">Ուժեղացրեք Taktak-ի անվտանգությունը</translation>
<translation id="983803489796659991">Չհաջողվեց տեղադրել հավելվածը, քանի որ թարմացումն իրականացնող սերվերը չունի հավելվածի համար անհրաժեշտ հեշերի տվյալներ։</translation>
<translation id="985498048907240953">Օգտագործել Taktak-ն առանց հաշվի</translation>
<translation id="985602178874221306">Taktak Authors</translation>
<translation id="989970834842471429">Ընտրեք ցանկացած տեքստ կամ պատկեր պատկերների որոնման միջոցով որոնում անելու համար</translation>
<translation id="992780518932311116">Ձեր տեղադրության տվյալներն օգտագործելու համար Taktak-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
</translationbundle>