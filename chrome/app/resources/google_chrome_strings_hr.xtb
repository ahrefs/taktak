<translation id="7658239707568436148">Odustani</translation>
<translation id="7670287553302121848">Taktak račun zahtijeva ponovnu autentifikaciju</translation>
<translation id="769538538642757151">Taktak će vas obavijestiti ako nešto trebate pregledati</translation>
<translation id="7716950018788545737">Zadaci su dovršeni.</translation>
<translation id="77283119132245232">Pruža usluge praćenja sustava za <ph name="BROWSER_NAME" />. Ako se ta usluga onemogući, praćenje izvedbe koje je izradio preglednik neće uključivati događaje na razini sustava, kao što su promjena konteksta i događaji spremnosti niti.</translation>
<translation id="7736869414036750079">Vaša organizacija zahtijeva da se prijavite u Taktak</translation>
<translation id="7747138024166251722">Program za instalaciju nije izradio privremeni direktorij. Provjerite ima li slobodnog prostora na disku i postoji li dopuštenje za instalaciju softvera.</translation>
<translation id="7748969056734910029">U posljednje vrijeme niste posjećivali web-lokaciju. Taktak je uklonio dopuštenja <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="7761834446675418963">Kliknite svoje ime da biste otvorili Taktak i počeli s pregledavanjem.</translation>
<translation id="7777080907402804672">Ako slika nema koristan opis, Taktak će ga pokušati pružiti. Da bi se izradili opisi, slike se šalju Googleu. To možete isključiti u bilo kojem trenutku u postavkama.</translation>
<translation id="778331955594035129">Taktak treba dopuštenje za lokaciju za ovu web-lokaciju</translation>
<translation id="7787950393032327779">Izgleda da neki drugi proces preglednika Taktak (<ph name="PROCESS_ID" />) na nekom drugom računalu (<ph name="HOST_NAME" />) upotrebljava taj profil. Taktak je zaključao profil da se profil ne bi promijenio. Ako ste sigurni da nijedan drugi proces ne upotrebljava taj profil, možete ga otključati i ponovo pokrenuti Taktak.</translation>
<translation id="7801699035218095297">Taktak pokušava kopirati zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="7808348361785373670">Ukloni iz Chromea...</translation>
<translation id="7825851276765848807">Instalacija nije uspjela zbog neodređene pogreške. Ponovo preuzmite Taktak.</translation>
<translation id="7827099906024714326">Taktak treba potvrditi da ste to vi da bi se neki podaci mogli spremiti na vaš Taktak račun i upotrebljavati na svim vašim uređajima. Ako se sada odjavite, ovi će se podaci izbrisati.</translation>
<translation id="7845233973568007926">Zahvaljujemo što ste izvršili instaliranje. Da biste mogli koristiti <ph name="BUNDLE_NAME" />, morate ponovno pokrenuti računalo.</translation>
<translation id="7872446069773932638">Preuzimanje... Još <ph name="SECONDS" /> s</translation>
<translation id="7886087451482920026">Odaberite tekst pomoću Taktak objektiva</translation>
<translation id="7890208801193284374">Ako dijelite računalo, prijatelji i članovi obitelji mogu zasebno pregledavati i postaviti Taktak prema svojim željama.</translation>
<translation id="7896673875602241923">Netko se prethodno prijavio u Taktak na ovom računalu kao <ph name="ACCOUNT_EMAIL_LAST" />. Izradite novog korisnika Chromea kako bi vaši podaci bili odvojeni.</translation>
<translation id="7917876797003313048">Možete upravljati Taktak računima na koje ste prijavljeni. Vaši Taktak računi koriste se za preglednik Taktak, Trgovinu Play, Gmail i brojne druge usluge. Ako želite dodati račun za nekog drugog, na primjer člana obitelji, dodajte novu osobu na uređaj <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Saznajte više<ph name="LINK_END" /></translation>
<translation id="7936702483636872823">Taktak je blokirao ovo preuzimanje jer je ova datoteka obmanjujuća i može napraviti neočekivane promjene na vašem uređaju</translation>
<translation id="7951272445806340501">Potrebno je ponovo pokrenuti ChromeOS Flex kako bi se ažuriranje primijenilo.</translation>
<translation id="7959172989483770734">Upravljajte profilima na Chromeu</translation>
<translation id="7962410387636238736">Ovo računalo više neće primati ažuriranja za Taktak jer sustavi Windows XP i Windows Vista više nisu podržani</translation>
<translation id="8004582292198964060">Preglednik</translation>
<translation id="8005666035647241369">Na Taktak upravitelj zaporki na ovom uređaju</translation>
<translation id="8008534537613507642">Ponovo instaliraj Taktak</translation>
<translation id="8009904340233602924">Koristi Taktak bez računa</translation>
<translation id="8010081455002666927">Automatsko otkrivanje</translation>
<translation id="8013993649590906847">Ako slika nema koristan opis, Taktak će ga pokušati pružiti. Da bi se izradili opisi, slike se šalju Googleu.</translation>
<translation id="8019103195866286235">Razvojni programer poništio je objavljivanje tog proširenja i možda nije sigurno. Uklonite ga iz Chromea kako više ne bi moglo vidjeti i mijenjati vaše podatke na web-lokacijama koje posjećujete, uključujući vaše osobne podatke.</translation>
<translation id="8040768861829554732">Proširenje traži da se prijavite na Taktak</translation>
<translation id="80471789339884597">Zahvaljujemo što ste izvršili instaliranje. Da biste mogli koristiti <ph name="BUNDLE_NAME" />, morate ponovno pokrenuti sve preglednike.</translation>
<translation id="8064015586118426197">ChromeOS Flex</translation>
<translation id="8077579734294125741">Ostali profili na Chromeu</translation>
<translation id="8086881907087796310">Instalacija nije uspjela jer vaše računalo ne zadovoljava minimalne zahtjeve za hardver.</translation>
<translation id="8113883687556086139">Potvrdite svoj identitet kako biste upotrebljavali i spremali podatke iz Chromea na svojem računu, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8118331347066725040">Pošaljite povratne informacije za pretraživanje pomoću Objektiva</translation>
<translation id="8129812357326543296">O programu Taktak</translation>
<translation id="813913629614996137">Pokretanje...</translation>
<translation id="8162006532256575008">Koristi Taktak bez računa</translation>
<translation id="8177472873527554730">Sadržaj na stranici nije pronađen</translation>
<translation id="8221491193165283816">Uglavnom blokirate obavijesti. Da biste dopustili web-lokaciji prikazivanje obavijesti, kliknite ovdje.</translation>
<translation id="8255190535488645436">Taktak upotrebljava vašu kameru i mikrofon.</translation>
<translation id="8267953129876836456">Taktak je pronašao neke sigurnosne preporuke za vaš pregled</translation>
<translation id="8286862437124483331">Taktak pokušava prikazati zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="829923460755755423">Dodavanje prečaca Taktak upravitelju zaporki</translation>
<translation id="8313851650939857356">Pogreška pri pokretanju: <ph name="STARTUP_ERROR" /></translation>
<translation id="8321888067342493336">Spremi kao sliku</translation>
<translation id="8336463659890584292">Kad web-lokacija zatraži privatno predučitavanje veza na stranici, Taktak upotrebljava Googleove poslužitelje. Na taj se način vaš identitet sakriva od predučitane web-lokacije, ali Taktak saznaje koje se web-lokacije predučitavaju.</translation>
<translation id="8342675569599923794">Datoteka je opasna i Taktak ju je blokirao.</translation>
<translation id="8349094670477064572">Možete spremati i upotrebljavati zaporke i druge podatke na svojem Taktak računu kad ste prijavljeni u Taktak. <ph name="LEARN_MORE" /></translation>
<translation id="8362914115861174987">Jezik prijevoda</translation>
<translation id="8366770919198174997">Slabi izvedbu, ali Taktak čini otpornijim na napade</translation>
<translation id="8370517070665726704">Autorska prava <ph name="YEAR" />. Taktak LLC. Sva prava pridržana.</translation>
<translation id="8387459386171870978">Nastavi upotrebljavati Taktak</translation>
<translation id="8394720698884623075">Provjerava nalaze li se URL-ovi na popisu nesigurnih web-lokacija pohranjenom u Chromeu</translation>
<translation id="8403038600646341038">Logotip Chroma na zaslonu računala.</translation>
<translation id="8418845734693287262">Taktak OS nije mogao sinkronizirati vaše podatke jer su vaši podaci za prijavu na račun zastarjeli.</translation>
<translation id="842386925677997438">Chromeovi sigurnosni alati</translation>
<translation id="8425765582779547329">Za više sigurnosti online uz postavke koje su odabrali tvoji roditelji, prijavi se na Taktak</translation>
<translation id="8433638294851456451">Da biste poslali broj s ovog uređaja na svoj Android telefon, prijavite se na Taktak na oba uređaja.</translation>
<translation id="8496177819998570653">Taktak upravitelj zaporki</translation>
<translation id="8498858610309223613">Upravo je primijenjeno posebno sigurnosno ažuriranje za Taktak. Ponovo pokrenite sustav i vratit ćemo vaše kartice.</translation>
<translation id="8516431725144212809">Vaši interesi prema Chromeovoj procjeni</translation>
<translation id="8521348052903287641">Ulazno pravilo kako bi Taktak Dev dopustio mDNS promet.</translation>
<translation id="852529348814672339">Prikaži Taktak na tom jeziku</translation>
<translation id="8533056045953418157">Postavite Taktak kao zadani preglednik PDF-ova</translation>
<translation id="8555465886620020932">Pogreška usluge: <ph name="SERVICE_ERROR" /></translation>
<translation id="856656450041460113">Pretražite popis jezika</translation>
<translation id="8601359445272098721">Novo! Možete prevesti tekst i slike na zaslonu tako da odaberete gumb Prevedi zaslon</translation>
<translation id="8614913330719544658">Taktak ne reagira. Ponovo pokrenuti sada?</translation>
<translation id="861702415419836452">Taktak treba dopuštenje za pristup kameri radi izrade 3D karte vašeg okruženja</translation>
<translation id="8625237574518804553">{0,plural, =1{Taktak će se ponovo pokrenuti za jednu minutu}one{Taktak će se ponovo pokrenuti za # min}few{Taktak će se ponovo pokrenuti za # min}other{Taktak će se ponovo pokrenuti za # min}}</translation>
<translation id="8637932705841171563">Da biste dijelili prozor, u postavkama sustava dopustite snimanje zaslona za Taktak.</translation>
<translation id="8641606876632989680">Taktak će vas obavijestiti kada se prijavite ugroženom zaporkom</translation>
<translation id="8649026945479135076">Uobičajeno je da web-lokacije koje posjećujete pamte vaše interese radi prilagodbe vašeg doživljaja. Web-lokacije mogu i pohraniti podatke o vašim interesima u Taktak.</translation>
<translation id="8669527147644353129">Taktak Helper</translation>
<translation id="8679801911857917785">Upravlja i time koja se stranica prikazuje prilikom pokretanja Chromea.</translation>
<translation id="8712637175834984815">Shvaćam</translation>
<translation id="8712767363896337380">Ažuriranje je skoro gotovo! Ponovo pokrenite Taktak da biste završili ažuriranje.</translation>
<translation id="8718062187489036808">Odjava s Chromea</translation>
<translation id="8725440680697264016">Postavite pitanja Googleu o tom videozapisu</translation>
<translation id="873133009373065397">Taktak ne može utvrditi niti postaviti zadani preglednik</translation>
<translation id="8747073452963259673">donji lijevi kut područja za pretraživanje: lijevo <ph name="LEFT" />%, dno <ph name="BOTTOM" />%</translation>
<translation id="8748735421235723888">Taktak oslobađa memoriju neaktivnih kartica. Time se aktivnim karticama i drugim aplikacijama daje više računalnih resursa, a Taktak ostaje brz. Neaktivne kartice automatski će se ponovo aktivirati kada se vratite na njih. <ph name="BEGIN_LINK" />Saznajte više o štednji memorije<ph name="END_LINK" /></translation>
<translation id="8753189155654018347">Uklonite podatke ove aplikacije iz Chromea</translation>
<translation id="8765470054473112089">Kad upisujete u adresnu traku ili okvir za pretraživanje, ono što upisujete Taktak šalje vašoj zadanoj tražilici kako bi vam pružio bolje prijedloge. To je isključeno u anonimnom načinu.</translation>
<translation id="8781673607513845160">Da biste upotrebljavali kameru, odobrite Chromeu pristup u <ph name="BEGIN_LINK" />sistemskim postavkama<ph name="END_LINK" /></translation>
<translation id="878572486461146056">Pogreška pri instalaciji: vaš administrator mreže primijenio je pravilo grupe koje sprječava instalaciju: <ph name="INSTALL_ERROR" /></translation>
<translation id="8798550110818026746">Vaša organizacija može vidjeti podatke o pregledavanju, kao što su oznake, povijest i zaporke, te upravljati njima. Ne može vidjeti podatke o pregledavanju na drugim profilima na Chromeu.</translation>
<translation id="8821043148920470810">Da biste primali buduća ažuriranja Taktak Chromea, trebat će vam Windows 10 ili novija verzija. Na ovom se računalu upotrebljava Windows 7.</translation>
<translation id="8823341990149967727">Taktak je zastario</translation>
<translation id="8825634023950448068">Da bismo zaštitili vašu privatnost, automatski brišemo vaše interese starije od četiri tjedna. Tijekom vašeg daljnjeg pregledavanja neki se interes može ponovo pojaviti na popisu. A ako Taktak pogriješi ili ne želite vidjeti određene oglase, možete ukloniti interes.</translation>
<translation id="8834965163890861871">Taktak pokušava urediti zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="8843516219908676469">Taktak bolje razumije obrasce i može ih brže automatski popuniti</translation>
<translation id="8851180723659088381">{NUM_EXTENSIONS,plural, =1{Taktak preporučuje da ga uklonite}one{Taktak preporučuje da ih uklonite}few{Taktak preporučuje da ih uklonite}other{Taktak preporučuje da ih uklonite}}</translation>
<translation id="8862326446509486874">Nemate odgovarajuća prava za instaliranje na razini sustava. Pokušajte ponovno pokrenuti program za instalaciju kao administrator.</translation>
<translation id="8883862939660515976">Postavite pitanja Taktak objektivu o toj slici</translation>
<translation id="8914504000324227558">Ponovo pokrenite Taktak</translation>
<translation id="8922193594870374009">Da biste poslali broj s uređaja <ph name="ORIGIN" /> na svoj Android telefon, prijavite se na Taktak na oba uređaja.</translation>
<translation id="8948460679427074738">Ovo proširenje nije objavilo prakse u vezi s privatnošću, na primjer način na koji prikuplja i upotrebljava podatke. Taktak preporučuje da ga uklonite.</translation>
<translation id="8958307504142971576">Sada imate više dostupnih značajki u Chromeu</translation>
<translation id="8989968390305463310">Vaša povijest pregledavanja utječe na oglase koji vam se prikazuju i interese procijenjene u nastavku. Da bi zaštitio vašu privatnost, Taktak automatski kontinuirano briše vaše interese svakog mjeseca. Interesi se mogu osvježiti ako ih ne uklonite.</translation>
<translation id="8992769679401294069">Vaši se podaci šifriraju vašom šifrom. Unesite je da biste upotrebljavali i spremali Chromeove podatke spremljene na vašem Taktak računu.</translation>
<translation id="8999117580775242387">Kad HTTPS nije dostupan, Taktak će upotrebljavati nesigurnu vezu bez upozorenja</translation>
<translation id="8999208279178790196">{0,plural, =0{Dostupno je ažuriranje Chromea}=1{Dostupno je ažuriranje Chromea}one{Ažuriranje Chromea dostupno je # dana}few{Ažuriranje Chromea dostupno je # dana}other{Ažuriranje Chromea dostupno je # dana}}</translation>
<translation id="9014771989710951291">Više organizacija upravlja Chromeom</translation>
<translation id="9024318700713112071">Postavite Taktak kao zadani preglednik</translation>
<translation id="9090566250983691233">Saznajte zašto Taktak blokira neke datoteke</translation>
<translation id="9106236359747881194">Odabir teksta za pretraživanje</translation>
<translation id="911206726377975832">Izbrisati i podatke o pregledavanju?</translation>
<translation id="9134482777260927479">Pomoć s domaćom zadaćom</translation>
<translation id="9138603949443464873">Da bi se vaše promjene primijenile, ponovo pokrenite Taktak</translation>
<translation id="9148058034647219655">Izlaz</translation>
<translation id="9195993889682885387">Taktak može procijeniti vaše interese na temelju vaše povijesti pregledavanja iz posljednjih nekoliko tjedana. Te informacije ostaju na vašem uređaju.</translation>
<translation id="919706545465235479">Ažurirajte Taktak da bi se pokrenula sinkronizacija</translation>
<translation id="922152298093051471">Prilagodite Taktak</translation>
<translation id="93760716455950538">Ponovo pokretanje ChromeOS Flexa</translation>
<translation id="943390475793766444">Taktak preporučuje skeniranje datoteke jer je možda opasna.</translation>
<translation id="945522503751344254">Pošaljite povratne informacije</translation>
<translation id="983803489796659991">Instalacija nije uspjela jer poslužitelj za ažuriranje nema hashiranih podataka za aplikaciju.</translation>
<translation id="989369509083708165">Taktak vaš je zadani preglednik</translation>
<translation id="989816563149873169">Pomoću prečaca <ph name="SHORTCUT" /> možete se prebacivati između profila u Chromeu</translation>
