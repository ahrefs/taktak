<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="1001534784610492198">Arhiva programa za instalaciju je oštećena ili nevažeća. Ponovno preuzmite program Taktak.</translation>
<translation id="1018937009655463387">Da biste dijelili prozor, u postavkama sustava dopustite snimanje zaslona za Taktak.</translation>
<translation id="1026101648481255140">Nastavi instaliranje</translation>
<translation id="102763973188675173">Prilagodite i kontrolirajte Taktak. Dostupno je ažuriranje.</translation>
<translation id="1028061813283459617">Da biste podatke o pregledavanju izbrisali samo s ovog uređaja, a zadržali ih na svojem Taktak računu, <ph name="BEGIN_LINK" />odjavite se iz Chromea<ph name="END_LINK" />.</translation>
<translation id="1042270987544905725">Kliknite da biste zatvorili dijaloški okvir za prijavu u Taktak</translation>
<translation id="1051793555070215510">Pomozite nam da poboljšamo anonimni način rada ispunjavanjem ove jednominutne ankete.</translation>
<translation id="1059838145689930908">Da biste upotrebljavali ovo proširenje kao <ph name="USER_EMAIL_ADDRESS" />, prijavite se u Taktak.</translation>
<translation id="1065672644894730302">Vaše postavke nije moguće čitati. Neke značajke možda nisu dostupne i promjene postavki neće biti spremljene.</translation>
<translation id="1086486568852410168">Pretraži pomoću Taktak objektiva</translation>
<translation id="1088300314857992706">E-adresa <ph name="USER_EMAIL_ADDRESS" /> prethodno je upotrebljavala Taktak</translation>
<translation id="110877069173485804">Ovo je vaš Taktak</translation>
<translation id="1125124144982679672">Tko upotrebljava Taktak?</translation>
<translation id="1142745911746664600">Nije moguće ažurirati Taktak</translation>
<translation id="1152920704813762236">O ChromeOS-u</translation>
<translation id="1154147086299354128">&amp;Otvori u Chromeu</translation>
<translation id="1157985233335035034">Nedavni jezici</translation>
<translation id="1184145431117212167">Instaliranje nije uspjelo jer vaša verzija Windowsa nije podržana.</translation>
<translation id="1194807384646768652">Taktak je blokirao ovo preuzimanje jer se ova vrsta datoteke obično ne preuzima i mogla bi biti opasna</translation>
<translation id="1203500561924088507">Zahvaljujemo što ste izvršili instaliranje. Da biste mogli koristiti <ph name="BUNDLE_NAME" />, morate ponovno pokrenuti preglednik.</translation>
<translation id="1278833599417554002">Ponovo pokrenite da biste ažurirali &amp;Taktak</translation>
<translation id="1290883685122687410">Pogreška pri postavljanju: <ph name="METAINSTALLER_EXIT_CODE" /> <ph name="WINDOWS_ERROR" /></translation>
<translation id="1302523850133262269">Pričekajte da Taktak instalira najnovija ažuriranja sustava.</translation>
<translation id="1330562121671411446">Prepoznaj jezik</translation>
<translation id="1335640173511558774"><ph name="MANAGER" /> zahtijeva da pročitate i prihvatite sljedeće uvjete pružanja usluge prije upotrebe ovog uređaja. Ti uvjeti ne predstavljaju proširenje, izmjenu ili ograničenje uvjeta ChromeOS Flexa.</translation>
<translation id="1341711321000856656">Možete se prebaciti da biste vidjeli zaporke s nekog drugog profila na Chromeu</translation>
<translation id="1356661055722410047">Novo! Možete prevesti tekst i slike na zaslonu</translation>
<translation id="1363996462118479832">Taktak OS nije mogao sinkronizirati vaše podatke zbog pogreške prilikom prijave.</translation>
<translation id="137466361146087520">Beta verzija preglednika Taktak</translation>
<translation id="1383876407941801731">Traži</translation>
<translation id="1399397803214730675">Na ovom računalu već postoji novija verzija programa Taktak. Ako softver ne radi, deinstalirajte Taktak i pokušajte ponovo.</translation>
<translation id="141901961143729572">Podijelite svoje misli</translation>
<translation id="1425903838053942728">{COUNT,plural, =0{Taktak je ažuriran. Možete upotrijebiti najnoviju verziju čim ponovno pokrenete preglednik. Nakon toga vaše će se trenutačne kartice ponovno otvoriti.}=1{Taktak je ažuriran. Možete upotrijebiti najnoviju verziju čim ponovno pokrenete preglednik. Nakon toga vaše će se trenutačne kartice ponovno otvoriti. Anonimni se prozor neće ponovno otvoriti.}one{Taktak je ažuriran. Možete upotrijebiti najnoviju verziju čim ponovno pokrenete preglednik. Nakon toga vaše će se trenutačne kartice ponovno otvoriti. Vaš # anonimni prozor neće se ponovno otvoriti.}few{Taktak je ažuriran. Možete upotrijebiti najnoviju verziju čim ponovno pokrenete preglednik. Nakon toga vaše će se trenutačne kartice ponovno otvoriti. Vaša # anonimna prozora neće se ponovno otvoriti.}other{Taktak je ažuriran. Možete upotrijebiti najnoviju verziju čim ponovno pokrenete preglednik. Nakon toga vaše će se trenutačne kartice ponovno otvoriti. Vaših # anonimnih prozora neće se ponovno otvoriti.}}</translation>
<translation id="1434626383986940139">Aplikacije kanala Taktak Canary</translation>
<translation id="1439793550875056299">Prikvači Taktak</translation>
<translation id="146866447420868597">Želite li se prijaviti u Taktak?</translation>
<translation id="1492280395845991349">Ponovno pokrenite da biste dovršili ažuriranje Chromea</translation>
<translation id="1497802159252041924">Instalacijska pogreška: <ph name="INSTALL_ERROR" /></translation>
<translation id="1507198376417198979">Prilagodite svoj novi profil u Chromeu</translation>
<translation id="1518627427551567882">Ova je stranica zaštićena</translation>
<translation id="1547295885616600893">Taktak OS omogućen je dodatnim <ph name="BEGIN_LINK_CROS_OSS" />softverom utemeljenim na otvorenom izvornom kodu<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="1547469039832541117">Završava istaknut zadatak.</translation>
<translation id="1553358976309200471">Ažuriraj Taktak</translation>
<translation id="1587223624401073077">Taktak upotrebljava vašu kameru.</translation>
<translation id="1587325591171447154">Datoteka <ph name="FILE_NAME" /> opasna je, pa ju je Taktak blokirao.</translation>
<translation id="1597911401261118146">Da biste provjerili jesu li vaše zaporke sigurne od povrede podataka i drugih poteškoća sa sigurnošću, <ph name="BEGIN_LINK" />prijavite se na Taktak<ph name="END_LINK" />.</translation>
<translation id="1619887657840448962">Kako bismo Taktak učinili sigurnijim, onemogućili smo sljedeće proširenje koje nije navedeno na stranici <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> i možda je dodano bez vašeg znanja.</translation>
<translation id="1628000112320670027">Potraži pomoć za upotrebu Chromea</translation>
<translation id="1640672724030957280">Preuzimanje...</translation>
<translation id="1651617469580841801">Kad upotrebljavate Taktak objektiv, naslov, URL i sadržaj stranice, uključujući PDF-ove, šalju se Googleu. <ph name="LEARN_MORE" /></translation>
<translation id="1662146548738125461">O ChromeOS Flexu</translation>
<translation id="1674870198290878346">Otvori vezu u ano&amp;nimnom prozoru Chromea</translation>
<translation id="1682634494516646069">Taktak ne može čitati iz svojeg podatkovnog direktorija niti u njega pisati: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1688214853608504530">Kad upisujete u adresnu traku ili okvir za pretraživanje, ono što upišete Taktak šalje alatima za pretraživanje, AI alatima i alatima za agente vaše organizacije kako bi vam pružio prijedloge.</translation>
<translation id="1698376642261615901">Taktak jest web-preglednik koji web-stranice i aplikacije pokreće brzinom svjetlosti. Brz je, stabilan i jednostavan za upotrebu. Sigurnije pregledavajte web uz zaštitu protiv zlonamjernog i špijunskog softvera koja je ugrađena u Taktak.</translation>
<translation id="1713301662689114961">{0,plural, =1{Taktak će se ponovo pokrenuti za sat vremena}one{Taktak će se ponovo pokrenuti za # h}few{Taktak će se ponovo pokrenuti za # h}other{Taktak će se ponovo pokrenuti za # h}}</translation>
<translation id="1722488837206509557">To će vam omogućiti odabir između dostupnih uređaja i prikaz sadržaja na njima.</translation>
<translation id="1786003790898721085">Obavezno se prijavite na Taktak na uređaju <ph name="TARGET_DEVICE_NAME" /> i nakon toga ponovno pokušajte sa slanjem.</translation>
<translation id="1786044937610313874">Prečaci se otvaraju u Chromeu</translation>
<translation id="178701303897325119">Ovo proširenje više nije podržano. Taktak preporučuje da ga uklonite.</translation>
<translation id="1812689907177901597">Ako isključite tu opciju, možete se prijaviti na Googleove web-lokacije kao što je Gmail bez prijavljivanja u Taktak</translation>
<translation id="1821644463306970002">{NUM_TABS,plural, =1{Taktak preporučuje pauziranje kartice koja usporava preglednik}one{Taktak preporučuje pauziranje kartica koje usporavaju preglednik}few{Taktak preporučuje pauziranje kartica koje usporavaju preglednik}other{Taktak preporučuje pauziranje kartica koje usporavaju preglednik}}</translation>
<translation id="1832046143430087831">Ubrzava web-lokacije s Chromeovom tražilicom V8, ali Taktak čini malo manje otpornim na napade. Postavka je isključena.</translation>
<translation id="1838374766361614909">Brisanje pretraživanja</translation>
<translation id="1860536484129686729">Taktak treba dopuštenje za pristup kameri za ovu web-lokaciju</translation>
<translation id="1873233029667955273">Taktak nije vaš zadani preglednik</translation>
<translation id="1874309113135274312">Taktak Beta (mDNS-In)</translation>
<translation id="1877026089748256423">Taktak je zastario</translation>
<translation id="1880677175115548835">Odaberite tekst</translation>
<translation id="1919130412786645364">Dopusti prijavu u Taktak</translation>
<translation id="1953553007165777902">Preuzimanje... Još <ph name="MINUTE" /> min</translation>
<translation id="2001586581944147178">Otežajte korisnicima s pristupom vašem internetskom prometu da vide koje web-lokacije posjećujete. Taktak upotrebljava sigurnu vezu za traženje IP adrese web-lokacije u DNS-u (Domain Name System).</translation>
<translation id="2008942457798486387">{NUM_EXTENSIONS,plural, =1{Ovo proširenje više nije podržano. Taktak preporučuje da ga uklonite.}one{Ova proširenja više nisu podržana. Taktak preporučuje da ih uklonite.}few{Ova proširenja više nisu podržana. Taktak preporučuje da ih uklonite.}other{Ova proširenja više nisu podržana. Taktak preporučuje da ih uklonite.}}</translation>
<translation id="2018528049276128029">Svaki profil ima vlastite podatke u Chromeu kao što su oznake, povijest, zaporke i slično</translation>
<translation id="2018879682492276940">Instaliranje nije uspjelo. Pokušajte ponovo.</translation>
<translation id="2024959665595762054">Da biste upotrebljavali i spremali podatke iz Chromea spremljene na vašem Taktak računu, potvrdite svoj identitet</translation>
<translation id="2034233344106846793">Taktak automatski nadograđuje nesigurne veze na HTTPS kad je to moguće</translation>
<translation id="207902854391093810">Tijekom eksperimenata Ad measurement API omogućuje web-lokacijama koje posjećujete da od Chromea traže podatke koji im pomažu mjeriti izvedbu svojih oglasa. Ad measurement API ograničava praćenje na različitim web-lokacijama tako što se između web-lokacija prenosi što je manje moguće podataka.</translation>
<translation id="2091012649849228750">Da biste primali buduća ažuriranja Taktak Chromea, trebat će vam Windows 10 ili novija verzija. Na ovom se računalu upotrebljava Windows 8.</translation>
<translation id="2094648590148273905">Uvjeti za ChromeOS Flex</translation>
<translation id="2094919256425865063">Želite li ipak zatvoriti Taktak?</translation>
<translation id="2096213354152647998">U posljednje vrijeme niste posjećivali web-lokaciju. Taktak je uklonio dopuštenje <ph name="PERMISSION" />.</translation>
<translation id="2106831557840787829">ChromeOS Flex omogućuje dodatni <ph name="BEGIN_LINK_CROS_OSS" />softver otvorenog izvornog koda<ph name="END_LINK_CROS_OSS" />, isto kao i <ph name="BEGIN_LINK_LINUX_OSS" />razvojno okruženje Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="2108778574543343055">Onemogući rad Chromea u pozadini za aplikacije</translation>
<translation id="2120620239521071941">Time će se izbrisati sljedeći broj stavki s uređaja: <ph name="ITEMS_COUNT" />. Da biste kasnije dohvatili svoje podatke, prijavite se na Taktak kao <ph name="USER_EMAIL" />.</translation>
<translation id="2121284319307530122">Ponovno pokretanje radi ažuriranja &amp;Chromea</translation>
<translation id="2123055963409958220">Pomognite poboljšati Taktak tako što ćete prijaviti <ph name="BEGIN_LINK" />trenutačne postavke<ph name="END_LINK" /></translation>
<translation id="2126108037660393668">Preuzeta datoteka nije zadovoljila provjeru.</translation>
<translation id="2128411189117340671">Upravljajte profilima na Chromeu</translation>
<translation id="2131230230468101642">Da bismo zaštitili vašu privatnost, automatski brišemo vaše interese starije od četiri tjedna. Tijekom vašeg daljnjeg pregledavanja neki se interes može ponovo pojaviti na popisu. Možete i ukloniti interese za koje ne želite da ih Taktak razmatra.</translation>
<translation id="2137162749895930932">Zatvorite zaslon za prijevod</translation>
<translation id="2139300032719313227">Ponovo pokrenite Taktak OS</translation>
<translation id="2151406531797534936">Sada ponovo pokrenite Taktak</translation>
<translation id="2163089732491971196">Da biste upotrebljavali i spremali Chromeove podatke spremljene na vašem Taktak računu, unesite šifru</translation>
<translation id="2174917724755363426">Instaliranje nije dovršeno. Jeste li sigurni da ga želite otkazati?</translation>
<translation id="2186206192313702726">Taktak objektiv</translation>
<translation id="2190166659037789668">Pogreška provjere ažuriranja: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199691482078155239">Taktak vam pruža veću kontrolu nad oglasima koji vam se prikazuju i ograničava ono što web-lokacije mogu saznati o vama kad vam prikazuju personalizirane oglase.</translation>
<translation id="2216543877350048334">Odjavite se da biste uklonili svoj Taktak račun iz Chromea</translation>
<translation id="2236949375853147973">Moja aktivnost</translation>
<translation id="2290014774651636340">Nedostaju ključevi Taktak API-ja. Neke funkcije Taktak Chromea bit će onemogućene.</translation>
<translation id="2290095356545025170">Jeste li sigurni da želite deinstalirati Taktak?</translation>
<translation id="2301513536169703857">Da biste mogli pristupati svojim zaporkama, oznakama i drugim podacima na svim svojim uređajima, prijavite se na Taktak</translation>
<translation id="2309047409763057870">Ovo je sekundarna instalacija Taktak Chromea, pa on ne može biti vaš zadani preglednik.</translation>
<translation id="2345992953227471816">Taktak je otkrio da ova proširenja sadrže zlonamjerni softver:</translation>
<translation id="2348335408836342058">Taktak treba dopuštenje za pristup kameri i mikrofonu za ovu web-lokaciju</translation>
<translation id="234869673307233423">Taktak ne može provjeriti vaše zaporke. Pokušajte ponovno kasnije.</translation>
<translation id="2359808026110333948">Nastavi</translation>
<translation id="2403703063067034158">Pogreška pokretanja: trenutačno je u tijeku drugi primjerak postavljanja. Pokušajte ponovno kasnije.</translation>
<translation id="2409816192575564775">{NUM_DEVICES,plural, =0{Jedno ili više Chromeovih proširenja pristupalo je jednom HID uređaju}=1{Jedno ili više Chromeovih proširenja pristupa jednom HID uređaju}one{Jedno ili više Chromeovih proširenja pristupa # HID uređaju}few{Jedno ili više Chromeovih proširenja pristupa # HID uređaja}other{Jedno ili više Chromeovih proširenja pristupa # HID uređaja}}</translation>
<translation id="2424440923901031101">To proširenje krši pravila Taktak web-trgovine i možda nije sigurno. Uklonite ga iz Chromea kako više ne bi moglo vidjeti i mijenjati vaše podatke na web-lokacijama koje posjećujete, uključujući vaše osobne podatke.</translation>
<translation id="2467438592969358367">Taktak želi izvesti vaše zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="2472092250898121027">Ovo proširenje sadrži zlonamjerni softver i nije sigurno. Uklonite ga iz Chromea kako više ne bi moglo vidjeti i mijenjati vaše podatke na web-lokacijama koje posjećujete, uključujući vaše osobne podatke.</translation>
<translation id="2485422356828889247">Deinstaliraj</translation>
<translation id="2513154137948333830">Potrebno je ponovno pokretanje: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2534365042754120737">Da biste zaštitili svoje podatke, dopustite Chromeu da ukloni dopuštenja s web-lokacija koje niste posjetili u posljednje vrijeme. Obavijesti se ne zaustavljaju.</translation>
<translation id="2556847002339236023">Vaša organizacija zatvara Taktak kada se ne upotrebljava <ph name="TIMEOUT_DURATION" />. Podaci o pregledavanju su izbrisani. To može uključivati povijest, automatsko popunjavanje i preuzimanja.</translation>
<translation id="2559253115192232574">Web-lokacija koju posjetite nakon toga može od Chromea tražiti podatke o vašim interesima kako bi prilagodila oglase koji će vam se prikazivati. Taktak može dijeliti najviše tri interesa.</translation>
<translation id="2563121210305478421">Ponovo pokrenuti Taktak?</translation>
<translation id="2569974318947988067">Taktak će pokušati nadograditi kretanja na HTTPS</translation>
<translation id="2571392474191184472">Vaša organizacija upravlja Chromeom</translation>
<translation id="2574930892358684005">Korisnik <ph name="EXISTING_USER" /> već je prijavljen na taj profil u Chromeu. Da bi vaše pregledavanje ostalo odvojeno, Taktak vam može izraditi vlastiti profil.</translation>
<translation id="2579190314336775785">Zaporke se mogu izbrisati samo izvan Chromea</translation>
<translation id="2580411288591421699">Nije moguće instalirati istu verziju programa Taktak koja je trenutačno pokrenuta. Zatvorite Taktak i pokušajte ponovo.</translation>
<translation id="2586406160782125153">Time će se izbrisati podaci o pregledavanju s uređaja. Da biste kasnije dohvatili svoje podatke, prijavite se na Taktak kao <ph name="USER_EMAIL" />.</translation>
<translation id="259935314519650377">Spremanje preuzetog alata za instalaciju u predmemoriju nije uspjelo. Pogreška: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sustav</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="2649768380733403658">Taktak redovito provjerava jesu li postavke preglednika najsigurnije. Obavijestit ćemo vas ako bilo što treba pregledati.</translation>
<translation id="2652691236519827073">Otvori vezu na novoj &amp;kartici Chromea</translation>
<translation id="2665296953892887393">Pomognite nam poboljšati Taktak šaljući izvješća o rušenju programa i <ph name="UMA_LINK" /> Googleu</translation>
<translation id="2668094785979141847">Kliknite za zatvaranje Taktak objektiva</translation>
<translation id="2681444469812712297">Otvorite <ph name="URL" /> u novoj kartici u Taktak Chromeu.</translation>
<translation id="2712141162840347885">Odaberite bilo što za pretraživanje pomoću Taktak objektiva ili pritisnite Escape da biste zatvorili Taktak objektiv</translation>
<translation id="2738871930057338499">Povezivanje s internetom nije moguće. HTTP 403 Zabranjeno je. Provjerite konfiguraciju proxyja.</translation>
<translation id="2742320827292110288">Upozorenje: Taktak ne može onemogućiti proširenjima da bilježe vašu povijest pregledavanja. Da biste onemogućili to proširenje u anonimnom načinu, poništite odabir te opcije.</translation>
<translation id="2753623023919742414">Kliknite za pretraživanje</translation>
<translation id="2765403129283291972">Taktak treba dopuštenje za pristup mikrofonu za ovu web-lokaciju</translation>
<translation id="2770231113462710648">Promijeni zadani preglednik na:</translation>
<translation id="2775140325783767197">Taktak ne može provjeriti vaše zaporke. Provjerite internetsku vezu.</translation>
<translation id="2797864378188255696">Kad se na Googleove usluge kao što su Gmail ili YouTube prijavljujete pomoću računa <ph name="USER_EMAIL" />, možete se automatski prijaviti u Taktak istim računom</translation>
<translation id="2799162042226656283">Vaš Taktak</translation>
<translation id="2799223571221894425">Pokreni ponovo</translation>
<translation id="2818684386420968393">Onemogući rad Chromea u pozadini za aplikacije</translation>
<translation id="2825024317344269723">Opasna web-lokacija. Taktak je uklonio obavijesti.</translation>
<translation id="2841525013647267359">Jezik izvornika</translation>
<translation id="2846251086934905009">Pogreška pri instalaciji: program za instalaciju nije dovršio radnju. Instalacija je prekinuta.</translation>
<translation id="2853415089995957805">Taktak predučitava stranice koje ćete vjerojatno posjetiti kako bi se brže učitale kad ih posjetite</translation>
<translation id="2857540653560290388">Pokretanje Chromea...</translation>
