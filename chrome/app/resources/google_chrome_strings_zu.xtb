<translation id="624230925347970731">I-Taktak izovala maduze</translation>
<translation id="6247557882553405851">Umphathi Wephasiwedi ye-Taktak</translation>
<translation id="6251759518630934363">Ikuxwayisa mayelana namasayithi ayingozi, ngisho nalawo i-Taktak ebingazi ngawo ngaphambili, ngokuhlaziya idatha eningi evela kumasayithi kunokuvikela okujwayelekile. Ungakhetha ukweqa izexwayiso ze-Taktak.</translation>
<translation id="6277547788421725101">Umzali wakho uvale "Izimvume zamasayithi, ama-app, nezandiso" ze-Taktak</translation>
<translation id="627882678981830918">Enza ngokwezifiso uphinde ulawule i-Taktak. Setha i-Taktak njengokwakho okuzenzakalelayo.</translation>
<translation id="6288580400488258237">Setha iGoogle Taktak njengebhrawuza evuleka ngokuzenzekela yakho uphinde uyisethe ku-taskbar yakho</translation>
<translation id="6291089322031436445">Izinhlelo zokusebenza ze-Taktak Dev</translation>
<translation id="6291549208091401781">I-Taktak Taktak isivele ifakelwe bonke abasebenzisi kukhompuyutha yakho.</translation>
<translation id="6319856120645568262">I-Taktak idinga imvume yokumepha indawo ekuzungezile futhi ilandelele izandla zakho</translation>
<translation id="6321592572353357376">Isandiso esithi "<ph name="EXTENSION_NAME" />" sifuna ukuthi ungene ngemvume kuChrome</translation>
<translation id="6326175484149238433">Susa kusuka ku-Taktak</translation>
<translation id="6327105987658262776">Asikho isibuyekezo esitholakalayo.</translation>
<translation id="6360449101159168105">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-Taktak ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="6388799252195623474">ngisize ngalokhu</translation>
<translation id="6412673304250309937">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Taktak. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Taktak ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="6417690341895039567">{COUNT,plural, =1{Inhlangano yakho ivala i-Taktak ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}one{Inhlangano yakho ivala i-Taktak ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}other{Inhlangano yakho ivala i-Taktak ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}}</translation>
<translation id="6418662306461808273">Shintshela kuphrofayela ye-Taktak ekhona kakade?</translation>
<translation id="6473905796280459355">Iya ekhasini elithi Mayelana neChrome</translation>
<translation id="6481963882741794338">Linka i-Taktak namanye amasevisi e-Taktak ngokwenza ngokomuntu ngamunye nezinye izinjongo</translation>
<translation id="648319183876919572">Ukubhrawuza Ngokuphepha Okugqamile kwenza okuningi ukukuvikela kumawebhusayithi ayingozi nakokudawunilodiwe</translation>
<translation id="6489302989675808168">Kuvuliwe • I-Taktak ayikwazi ukuqinisekisa ukuthi lesi sandiso sivela kuphi</translation>
<translation id="6493527311031785448">I-Taktak Taktak izama uku-<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="6497147134301593682">I-Taktak ivalwe ngokuzenzekelayo</translation>
<translation id="6506909944137591434">I-Taktak idinga imvume yekhamera ukudala imephu ye-3D yendawo yakho ekuzungezile</translation>
<translation id="6515495397637126556"><ph name="PAGE_TITLE" /> - Taktak Taktak Dev</translation>
<translation id="6520670145826811516">Ukuze usebenzise indawo yakho, nikeza iChrome ukufinyelela <ph name="BEGIN_LINK" />amasethingi ohlelo<ph name="END_LINK" /></translation>
<translation id="659498884637196217">Ku-Taktak Password Manager kule divayisi</translation>
<translation id="6632473616050862500">I-ChromeOS Flex yenzeka ngenxa <ph name="BEGIN_LINK_CROS_OSS" />yesofthiwe yomthombo ovulekile eyengeziwe<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6634299872736643004">Izinguquko kule sethingi zizosetshenziswa uma iChrome iqala kabusha.</translation>
<translation id="6660596345553328257">Ngena Ngemvume ku-Taktak?</translation>
<translation id="6664219008737641504">Uma ukhohlwe umushwana wakho wokungena noma ufuna ukushintsha le sethingi, <ph name="SETTINGS_LINK" /> idatha yeChrome ku-akhawunti yakho</translation>
<translation id="6676384891291319759">Finyelela i-inthanethi?</translation>
<translation id="6679975945624592337">Vumela i-Taktak Taktak isebenze ngemuva</translation>
<translation id="6696915334902295848">I-Taktak idinga imvume yemakrofoni kule sayithi</translation>
<translation id="6712881677154121168">Iphutha lokudawuniloda: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="6718739135284199302">Yenza i-Taktak isheshe</translation>
<translation id="6734827584173583205">Awukavakashi kamuva nje. IChrome isuse i-<ph name="PERMISSION_1" />, i-<ph name="PERMISSION_2" />, nokungu-<ph name="COUNT" /> okwengeziwe.</translation>
<translation id="6735387454586646204">Isistimu ye-ChromeOS Flex</translation>
<translation id="6750954913813541382">Ukuze kulungiswe amaphutha okupeletwa, i-Taktak ithumela umbhalo owuthayiphayo kusiphequluli ku-Taktak</translation>
<translation id="6760235774835597023">Isheshisa amasayithi ngenjini yeChrome ye-V8 kodwa yenza iChrome imelane kancane nokuhlaselwa. Le sethingi livuliwe.</translation>
<translation id="677276454032249905">Phuma ku-Taktak noma kunjalo?</translation>
<translation id="6794858689789885890">Yisule njalo idatha yesayithi kudivayisi yakho lapho uvala i-Taktak</translation>
<translation id="6831043979455480757">Humusha</translation>
<translation id="683440813066116847">Umyalo wokubophezeleka ngaphakathi kwe-Taktak Taktak Canary ukuze kuvunyelwe ithrafikhi ye-mDNS.</translation>
<translation id="684888714667046800">Ayikwazi ukuxhuma ku-inthanethi. Uma usebenzisa uhlelo lokuvikela, sicela uqinisekise ukuthi i-<ph name="PRODUCT_EXE_NAME" /> ikuhlelo lwabagunyaziwe.</translation>
<translation id="6877155553248388166">ikhona elingezansi ngakwesokudla lendawo yokusesha: ngakwesokudla okungu-<ph name="RIGHT" />%, ngezansi okungu-<ph name="BOTTOM" />%</translation>
<translation id="6881299373831449287">Ibuyekeza i-Taktak</translation>
<translation id="6885412569789873916">Izinhlelo zokusebenza ze-beta ye-Taktak</translation>
<translation id="6893363893008038481">Susa i-akhawunti kuChrome</translation>
<translation id="6896758677409633944">Kopisha</translation>
<translation id="6930294499209825">Igcina isofthiwe yakho yeGoogle ingeyakamuva. Uma le sevisi ikhutshaziswe noma imisiwe, isofthiwe yakho yeGoogle ngeke igcinwe ingeyakamuva, okusho ukuthi ukungavikeleki okungase kuphakame akukwazi ukulungiswa futhi izakhi zingase zingasebenzi. Le sevisi iyazikhipha uma ingekho isofthiwe yeGoogle eyisebenzisayo.</translation>
<translation id="6933858244219479645">Isistimu ye-ChromeOS</translation>
<translation id="6938166777909186039">Ukuze uthole izibuyekezo zesikhathi esizayo ze-Taktak Taktak, uzodinga i-Windows 10 noma yakamuva. Le khompyutha isebenzisa i-Windows 8.1.</translation>
<translation id="6943584222992551122">Idatha yokuphequlula yalo muntu izosuswa kusukela kule divayisi. Ukuze uphinde uthole idatha, ngena ngemvume ku-Taktak njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6967962315388095737">Umyalo wokubophezeleka ngaphakathi kwe-beta yeGoogle Taktak ukuze kuvunyelwe ithrafikhi ye-mDNS.</translation>
<translation id="6979589607440534284">Funda ukuthi kungani i-Taktak ivimba amanye amafayela, ivula kuthebhu entsha</translation>
<translation id="6991926986715044139">Bonisa njalo Isinqmuleli seGoogle Lens</translation>
<translation id="7011190694940573312">Ukufakwa kwehlulekile ngenxa yokuthi lolu hlobo lwesistimu yokusebenza alusekelwe.</translation>
<translation id="7024536598735240744">Iphutha lokuvula: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7025789849649390912">Ukufaka Kumisiwe.</translation>
<translation id="7025800014283535195">Ungashintsha phakathi kwamaphrofayela we-Taktak lapha</translation>
<translation id="7051685429025310665">Awukavakashi kamuva nje. IChrome isuse i-<ph name="PERMISSION_1" />, i-<ph name="PERMISSION_2" />, i-<ph name="PERMISSION_3" /></translation>
<translation id="7059914902409643750">Yenza i-Taktak Ibe Ngeyakho</translation>
<translation id="7060643578009939353">Sesha le vidiyo ngeGoogle Lens</translation>
<translation id="7071827361006050863">I-Taktak izosula idatha yokubhrawuza maduze</translation>
<translation id="7085332316435785646">Khetha ukuthi ufake phakathi umlando we-Taktak ukuze uthole umuzwa womuntu siqu kumasevisi e-Taktak</translation>
<translation id="7088681679121566888">I-Taktak isesimweni sakamuva</translation>
<translation id="7096221564931416126">Khetha noma yimuphi umbhalo noma isithombe ukuze useshe ngeGoogle Lens</translation>
<translation id="7098166902387133879">I-Taktak Taktak isebenzisa imakrofoni yakho.</translation>
<translation id="7099479769133613710">Qalisa kabusha ukuze ubuyekeze i-&amp;ChromeOS</translation>
<translation id="7106741999175697885">Isiphathi somsebenzi - i-Taktak Taktak</translation>
<translation id="7140653346177713799">{COUNT,plural, =0{Isibuyekezo esisha se-Taktak siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha.}=1{Isibuyekezo esisha se-Taktak siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Isibuyekezo esisha se-Taktak siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Isibuyekezo esisha se-Taktak siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="7155997830309522122">Uma kunjalo, sicela uhlele iphasiwedi yakho elondoloziwe ku-Taktak ukuze ifane nephasiwedi yakho entsha.</translation>
<translation id="7161904924553537242">Siyakwamukela ku-Taktak Taktak</translation>
<translation id="7193885263065350793">Inhlangano yakho ivala i-Taktak uma ingasetshenziswa isikhathi eingu-<ph name="TIMEOUT_DURATION" />.</translation>
<translation id="7242029209006116544">Ungena ngemvume nge-akhawunti ephethwe futhi ukunikezela ukulawula kwayo ngaphezulu kwephrofayela yakho ye-Taktak Taktak. Idatha yakho ye-Taktak, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizobophezeleka unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-deshibhodi yama-akhawunti we-Taktak, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ngokuzikhethela ungadala iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-Taktak ihlukanisiwe. <ph name="LEARN_MORE" /></translation>
<translation id="7285616922384953075">I-<ph name="MANAGER" /> iphatha iChrome</translation>
<translation id="7288567540154601580">Amathebhu nezandiso</translation>
<translation id="7296210096911315575">Ukusebenzisa okubalulekile nolwazi lokuphepha</translation>
<translation id="7302361266603927550">Enye idatha yakho yeChrome ayikalondolozwa kuGoogle Account. Zama ukulinda imizuzu embalwa ngaphambi kokuphuma ngemvume. Uma uphuma ngemvume manje, le datha izosulwa.</translation>
<translation id="7308322188646931570">I-Taktak idinga ukufinyelela kusitoreji ukuze ilande amafayela</translation>
<translation id="7339898014177206373">Iwindi elisha</translation>
<translation id="7352651011704765696">Okuthile akuhambanga kahle</translation>
<translation id="7386878009611068389">Ukuze uhlale uphephile ku-inthanethi ngokukhetha komzali wakho, shintshela kuphrofayela yakho yeChrome lapho usungene ngemvume kakade njengo-<ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="7398801000654795464">Ubukade ungene ngemvume ku-Taktak njengo-<ph name="USER_EMAIL_ADDRESS" />. Sicela usebenzise i-akhawunti efanayo ukuze uphinde ungene ngemvume.</translation>
<translation id="7412494426921990001">Chofoza imenyu ye-Taktak</translation>
<translation id="7419819959108735624">Khetha noma yini ongasesha nge-Taktak Lens</translation>
<translation id="742463671275348370">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-USB ibifinyelelwa yisandiso se-Taktak esisodwa noma eziningi}=1{Idivayisi e-1 ye-USB ifinyelelwa yisandiso se-Taktak esisodwa noma eziningi}one{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-Taktak esisodwa noma eziningi}other{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-Taktak esisodwa noma eziningi}}</translation>
<translation id="7426611252293106642">I-Taktak Taktak ingase ingasebenzi kahle ngoba ayisasekelwa kulokhu kusatshalaliswa kwe-Linux</translation>
<translation id="7437998757836447326">Phuma ku-Taktak</translation>
<translation id="7449333426561673451">{COUNT,plural, =1{Inhlangano yakho ivala i-Taktak ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1.}one{Inhlangano yakho ivala i-Taktak ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}other{Inhlangano yakho ivala i-Taktak ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}}</translation>
<translation id="7450541714075000668">Umbhalo okopishiwe</translation>
<translation id="7452987490177144319">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Taktak ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Taktak ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Taktak ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}}</translation>
<translation id="7477130805345743099">I-Taktak izokuxwayisa ngaphambi kokulayisha noma iyiphi isayithi isebenzisa uxhumo olungavikelekile</translation>
<translation id="7481213027396403996">Thola isivikelo esinamandla kakhulu se-Taktak</translation>
<translation id="749228101751499733">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ukusuka kuGoogle Account yakho kuChrome. I-<ph name="SHORTCUT" /> ingashintsha amasethingi wakho wamasevisi eGoogle.</translation>
<translation id="7496017508659652909">IChrome ilayisha ngaphambilini amakhasi okwenza ukubhrawuza nokusesha kusheshe. <ph name="BEGIN_LINK" />Funda kabanzi mayelana namakhasi okulayisha kuqala<ph name="END_LINK" /></translation>
<translation id="7510927761955779701">IChrome iwaqonda kangcono amafomu futhi ingakugcwalisela wona ngokuzenzekelayo ngokushesha. Leli sethingi livuliwe.</translation>
<translation id="7514258452813684157">Isevisi Yesibuyekezi SeGoogle</translation>
<translation id="7515191208480168435">Ungaphina iGoogle Lens ukuze uyifinyelele kalula</translation>
<translation id="7535429826459677826">I-Taktak Taktak Dev</translation>
<translation id="7543146567111253230">Ukuze uthole le bhukhimakhi nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuChrome</translation>
<translation id="756809126120519699">Idatha ye-Taktak esuliwe</translation>
<translation id="7572537927358445944">Kuvaliwe • I-Taktak ayikwazi ukuqinisekisa ukuthi lesi sandiso sivela kuphi</translation>
<translation id="7583399374488819119">Isifaki Se-<ph name="COMPANY_NAME" /></translation>
<translation id="7602868996817972616">Buza iGoogle mayelana naleli khasi</translation>
<translation id="7606334485649076285">I-Taktak ChromeOS Flex</translation>
<translation id="7626072681686626474">I-<ph name="MANAGER" /> idinga ukuthi ufunde uphinde wamukele Imigomo Yesevisi elandelayo ngaphambi kokusebenzisa le divayisi. Le migomo ayinwebeki, ayiguquki, noma ikhawulela Imigomo ye-Taktak ChromeOS.</translation>
<translation id="7627609214560473136">Ukuvikela idatha yakho vumela iChrome isuse izimvume emasayithini ongakawavakasheli muva nje.</translation>
<translation id="7629695634924605473">I-Taktak ikuvumela ukuthi wazi uma amaphasiwedi akho afakwa engcupheni</translation>
<translation id="7641148173327520642">Umlawuli wakho wesistimu ulungiselele i-Taktak Taktak ukuthi ivule i-<ph name="ALTERNATIVE_BROWSER_NAME" /> ukuze ifinyelele ku-<ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7649070708921625228">Usizo</translation>
<translation id="7651907282515937834">Ilogo yebhizinisi le-Taktak</translation>
<translation id="76531479118467370">I-Taktak ivimbele lokhu kudawuniloda ngoba uvale Ukuphequlula Okuphephile futhi ifayela alikwazi ukuqinisekiswa</translation>
<translation id="7655455401911432608">Umlando wakho wokubhrawuza, irekhodi lamasayithi owavakashele usebenzisa i-Taktak kule divayisi.</translation>
<translation id="7655472416356262023">Susa i-akhawunti kuChrome</translation>
<translation id="7658239707568436148">Khansela</translation>
<translation id="7670287553302121848">I-akhawunti yeChrome idinga ukuqinisekiswa kabusha</translation>
<translation id="769538538642757151">I-Taktak izokwazisa uma kukhona okudinga ukubuyekezwa kwakho</translation>
<translation id="7716950018788545737">Imisebenzi iqediwe.</translation>
<translation id="77283119132245232">Inikeza amasevisi okulandelela isistimu ku-<ph name="BROWSER_NAME" />. Uma le sevisi ikhutshaziwe, ukusebenza kokulandelela okusungulwe yibhrawuza ngeke kuhlanganise imisebenzi yobubanzi besistimu njengokushintshwa kokuqukethwe kanye nemisebenzi esikulungele yochungechunge.</translation>
<translation id="7736869414036750079">Inhlangano yakho ifuna ungene ngemvume kuChrome</translation>
<translation id="7747138024166251722">Isifaki asikwazanga ukudala umkhombandlela wesikhashana. Sicela uhlolele isikhala esikhululekile sediski nemvume ukuze ufake isofthiwe.</translation>
<translation id="7748969056734910029">Awukavakashi kamuva nje. IChrome isuse i-<ph name="PERMISSION_1" />, i-<ph name="PERMISSION_2" /></translation>
<translation id="7761834446675418963">Chofoza igama lakho ukuze uvule i-Taktak uphinde uqale ukudlulisa amehlo.</translation>
<translation id="7777080907402804672">Uma isithombe singenayo incazelo ephelele, i-Taktak izozama ukukunikezela eyodwa. Ukuze udale izincazelo, izithombe zithunyelwa ku-Taktak. Ungavala lokhu kuzilungiselelo noma kunini.</translation>
<translation id="778331955594035129">I-Taktak idinga imvume yendawo kule sayithi</translation>
<translation id="7787950393032327779">Iphrofayela ibonakala isetshenziswa enye inqubo ye-Taktak Taktak (<ph name="PROCESS_ID" />) kwenye ikhompyutha (<ph name="HOST_NAME" />).  I-Taktak ikhiye iphrofayela ukuze ingamosheki. Uma uqinisekile ukuthi azikho ezinye izinqubo ezisebenzisa le phrofayela, ungavula iphrofayela uphinde uqalise kabusha i-Taktak.</translation>
<translation id="7801699035218095297">I-Taktak Taktak izama ukukopisha amaphasiwedi. Thayipha amaphasiwedi akho e-Windows ukuze uvumele lokhu.</translation>
<translation id="7808348361785373670">Susa kusuka ku-Taktak...</translation>
<translation id="7825851276765848807">Ukufakwa kuhlulekile ngenxa yephutha elingacacisiwe. Sicela ulande i-Taktak Taktak futhi.</translation>
<translation id="7827099906024714326">IChrome idinga ukuqinisekisa ukuthi uwena ngaphambi kokuthi idatha ethile ilondolozwe kuGoogle Account yakho futhi isetshenziswe kuwo wonke amadivayisi akho. Uma uphuma ngemvume manje, le datha izosulwa.</translation>
<translation id="7845233973568007926">Siyabonga ngokufaka. Kufanele uqalise kabusha ikhompyutha yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME" />.</translation>
<translation id="7872446069773932638">Iyadawuniloda... kusele imizuzwana engu-<ph name="SECONDS" /></translation>
<translation id="7886087451482920026">Khetha umbhalo ngeGoogle Lens</translation>
<translation id="7890208801193284374">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukene baphinde basethe i-Taktak ngendlela nje abayifunayo.</translation>
<translation id="7896673875602241923">Umuntu othile ngaphambilini ungene ngemvume ku-Taktak kule khompuyutha njengo-<ph name="ACCOUNT_EMAIL_LAST" />. Sicela udale umsebenzisi omusha we-Taktak ukuze ugcine ulwazi lwakho luhlukile.</translation>
<translation id="7917876797003313048">Ungaphatha ama-akhawunti we-Taktak wakho angene ngemvume. Ama-akhawunti wakho we-Taktak asetshenziselwe i-browser ye-Taktak, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE" /> yakho kunalokho. <ph name="LINK_BEGIN" />Funda kabanzi<ph name="LINK_END" /></translation>
<translation id="7936702483636872823">I-Taktak ivimbele lokhu kudawuniloda ngoba ifayela liyakhohlisa futhi lingase lenze izinguquko ezingalindelekile kudivayisi yakho</translation>
<translation id="7951272445806340501">I-ChromeOS Flex idinga ukuqalwa kabusha ukuze isibuyekezo sisebenze.</translation>
<translation id="7959172989483770734">Phatha Amaphrofayela e-Taktak</translation>
<translation id="7962410387636238736">Le khompuyutha ngeke isathola izibuyekezo ze-Taktak Taktak ngoba i-Windows XP ne-Windows Vista azisasekelwa</translation>
<translation id="8004582292198964060">Isiphequluli</translation>
<translation id="8005666035647241369">Ku-Taktak Password Manager ekule divayisi</translation>
<translation id="8008534537613507642">Phinda ufake i-Taktak</translation>
<translation id="8009904340233602924">Sebenzisa i-Taktak ngaphandle kwe-akhawunti</translation>
<translation id="8010081455002666927">Thola ngokuzenzakalela</translation>
<translation id="8013993649590906847">Uma isithombe singenayo incazelo ephelele, i-Taktak izozama ukukunikezela eyodwa. Ukuze udale izincazelo, izithombe zithunyelwa ku-Taktak.</translation>
<translation id="8019103195866286235">Lesi sandiso sisuswe ukushicilela ngunjiniyela waso, futhi kungenzeka sibe esingaphephile. Sisuse ku-Taktak ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="8040768861829554732">Isandiso sifuna ukuthi ungene kuChrome</translation>
<translation id="80471789339884597">Siyabonga ngokufaka. Kufanele uqalise kabusha wonke amabhrawuza akho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME" />.</translation>
<translation id="8064015586118426197">I-ChromeOS Flex</translation>
<translation id="8077579734294125741">Amanye Amaphrofayili e-Taktak</translation>
<translation id="8086881907087796310">Ukufakwa kwehlulekile ngenxa yokuthi ikhompyutha yakho ayihlangabezani nezimfuneko zenani elincane lehadiwe.</translation>
<translation id="8113883687556086139">Qinisekisa ukuthi nguwe ukuze usebenzise futhi ulondoloze idatha yeChrome ku-akhawunti yakho, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8118331347066725040">Thumela impendulo yokusesha nge-Lens</translation>
<translation id="8129812357326543296">Mayelana ne-Taktak Taktak</translation>
<translation id="813913629614996137">Iyaqalisa...</translation>
<translation id="8162006532256575008">Sebenzisa i-Taktak Ngaphandle kwe-Akhawunti</translation>
<translation id="8177472873527554730">Asikwazi ukuthola ikhontenti kuleli khasi</translation>
<translation id="8221491193165283816">Uvamise ukuvimba izaziso. Ukuze uvumele leli sayithi ukuthi likwazise, chofoza lapha.</translation>
<translation id="8255190535488645436">I-Taktak Taktak isebenzisa ikhamela yakho nemakrofoni.</translation>
<translation id="8267953129876836456">Uma ivuliwe, i-Taktak ilayisha kuqala amakhasi okwenza ukuphequlula nokusesha kusheshe.</translation>
<translation id="8286862437124483331">I-Taktak Taktak izama ukubonisa amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="829923460755755423">Engeza isinqamuleli Kumphathi Wephasiwedi Ye-Taktak</translation>
<translation id="8313851650939857356">Iphutha ekuqaliseni: <ph name="STARTUP_ERROR" />.</translation>
<translation id="8321888067342493336">Londoloza njengesithombe</translation>
<translation id="8336463659890584292">Lapho isayithi icela ukulayisha kusengaphambili ngasese amalinki ekhasini layo, i-Taktak isebenzisa amaseva e-Taktak. Lokhu kusiza umazisi wakho kusayithi elayishwe ngaphambilini, kodwa i-Taktak ifunda ukuthi yimaphi amasayithi alayishwa ngaphambilini.</translation>
<translation id="8342675569599923794">Leli fayela liyingozi, ngakho-ke i-Taktak ilivimbile.</translation>
<translation id="8349094670477064572">Uzolondoloza futhi usebenzise amaphasiwedi nokunye okwengeziwe kuGoogle Account yakho noma nini lapho ungene ngemvume kuChrome. <ph name="LEARN_MORE" /></translation>
<translation id="8362914115861174987">Humushela ku-</translation>
