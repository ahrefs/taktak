<translation id="2928420929544864228">Ukufaka kuqedile.</translation>
<translation id="2945997411976714835">Iphutha lokufaka: Inqubo yesifaki yehlulekile ukuqala.</translation>
<translation id="2969728957078202736"><ph name="PAGE_TITLE" /> - Inethiwekhi Yokungena ngemvume - i-Taktak</translation>
<translation id="2970681950995291301">Ukuze ususe i-Taktak Account yakho ku-Taktak, phuma ngemvume ku-Taktak ekhasini Lamasethingi</translation>
<translation id="2991167882679440829">Amaphasiwedi akho kanye nenye idatha yeChrome oyilondoloze kuGoogle Account yakho izosuswa kule divayisi. Ukuze uphinde uzisebenzise kuChrome, ngena ngemvume futhi.</translation>
<translation id="2994465299455873643">Inikeza amasevisi okubethela nendlela evikelekile yokuthola i-<ph name="BROWSER_NAME" /> uma iphelelwa yisikhathi. Uma le sevisi ikhutshaziwe, i-<ph name="BROWSER_NAME" /> ingalahlekelwa ukufinyelela kudatha ebethelwe, futhi i-<ph name="BROWSER_NAME" /> kungenzeka ingakwazi ukuzithola.</translation>
<translation id="3003694935412297923">Yonke imisebenzi</translation>
<translation id="3018957014024118866">Phatha amakhukhi ezinkampani zangaphandle kanye nokuvikela ukulandelela (<ph name="URL" />)</translation>
<translation id="3019382870990049182">Qalisa kabusha ukuze ubuyekeze i-&amp;ChromeOS Flex</translation>
<translation id="3037838751736561277">I-Taktak Taktak ikumodi yangemuva.</translation>
<translation id="3038232873781883849">Ilinde ukufaka...</translation>
<translation id="3045032126857188731">Ulimi oluhunyushiwe: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Vala idayalogi yempendulo</translation>
<translation id="306179102415443347">Sebenzisa isinqamuleli sakho ukuze ufike ngokushesha ku-Taktak Password Manager. Ungahambisa isinqamuleli sakho esikrinini sasekhaya sekhompyutha yakho noma isiqalisi se-app.</translation>
<translation id="3065168410429928842">Ithebhu le-Taktak</translation>
<translation id="3080151273017101988">Qhubeka nokusebenzisa izinhlelo zokusebenza zangemuva ngenkathi i-Taktak Taktak ivaliwe</translation>
<translation id="3100998948628680988">Qamba iphrofayela lakho le-Taktak</translation>
<translation id="310459126943037700">Yehlulekile ukuqeda imisebenzi.</translation>
<translation id="3112458742631356345">I-Taktak ivimbele lokhu kudawunilodwa ngoba ifayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="3114643501466072395">Ukuze uhlole ukuba amanye amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nezinye izinkinga zezokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Taktak<ph name="END_LINK" />.</translation>
<translation id="3119573284443908657">I-Taktak ivimbele lokhu kudawuniloda ngoba ifayela lengobo yomlando lihlanganisa namanye amafayela angase afihle uhlelo olungayilungele ikhompyutha</translation>
<translation id="3135560418014806498">Faka Iphrofayela yeChrome</translation>
<translation id="3137969841538672700">Hudulela oseshweni</translation>
<translation id="3140883423282498090">Izinguquko zakho zizosebenza ngesikhathi esilandelayo lapho uqalisa kabusha i-Taktak Taktak.</translation>
<translation id="3149510190863420837">Izinhlelo zokusebenza ze-Taktak</translation>
<translation id="3161522574479303604">Zonke izilimi</translation>
<translation id="319199214552513804">Ukuze uthole lesi sandiso nokuningi kuwo wonke amakhompyutha wakho, ngena ngemvume kuChrome</translation>
<translation id="3196187562065225381">I-Taktak ivimbele lokhu kudawunilodwa ngoba ifayela liyingozi</translation>
<translation id="3222857603094643834">Sesha noma yini kuleli khasi nge-Taktak Lens</translation>
<translation id="3226612997184048185">Uma futhi ulondoloza amabhukhimakhi ku-Taktak Account yakho, ungakwazi ukulandelela izintengo zomkhiqizo ku-Taktak futhi uthole isaziso uma intengo yehla.</translation>
<translation id="3242123554343253302">Faka iphrofayela yeChrome</translation>
<translation id="3245429137663807393">Uma futhi wabelana ngemibiko yokusetshenziswa kwe-Taktak, leyo mibiko ihlanganisa nama-URL owavakashelayo</translation>
<translation id="3282568296779691940">Ngena ngemvume ku-Taktak</translation>
<translation id="3286538390144397061">Qala kabusha manje</translation>
<translation id="3292333338048274092">Khona-ke kuzodingeka uqale kabusha iChrome.</translation>
<translation id="3324218984287646518">Buza iGoogle Lens ngale vidiyo</translation>
<translation id="3327226547491422998">Emva kwesikhathi, iChrome ingakubuza ukuthi uyafuna yini ukusebenzisa ulwazi olulondoloziwe ukuze ugcwalise ngokuzenzakalela amafomu</translation>
<translation id="3352986031709923790">ikhona elingaphezulu ngakwesokudla lendawo yokusesha: ngakwesokudla okungu-<ph name="RIGHT" />%, phezulu okungu-<ph name="TOP" />%</translation>
<translation id="3360895254066713204">Isisizi se-Taktak</translation>
<translation id="3379938682270551431">{0,plural, =0{I-Taktak izoqala kabusha manje}=1{I-Taktak izoqala kabusha kusekhondi elingu-1}one{I-Taktak izoqala kabusha kumasekhondi angu-#}other{I-Taktak izoqala kabusha kumasekhondi angu-#}}</translation>
<translation id="3396977131400919238">Iphutha lesistimu yokusebenza livele ngesikhathi sokufakwa. Sicela ulande i-Taktak Taktak futhi.</translation>
<translation id="3428747202529429621">Kukugcina uphephile ku-Taktak futhi kungase kusetshenziswe ukuthuthukisa ukuvikeleka kwakho kwezinye izinhlelo zokusebenza ze-Taktak lapho ungene ngemvume</translation>
<translation id="3434246496373299699">I-Taktak ingahlola amaphasiwedi akho uma ungena ngemvume nge-Akhawunti yakho ye-Taktak</translation>
<translation id="3438681572027105609">Ukuze uthole amaphasiwedi akho kanye nokwengeziwe kuwo wonke amadivayisi akho, ngena ngemvume kuChrome</translation>
<translation id="3450887623636316740">Leli fayela kungenzeka libe nobungozi<ph name="LINE_BREAK" />I-Taktak ingakuhlolela lokhu okudawunilodwayo uma unikeza iphasiwedi. Ulwazi mayelana nefayela luthunyelwa kokuthi Ukuphequlula ngokuphephile kwe-Taktak, kodwa okuqukethwe kufayela kanye nephasiwedi kusala kudivayisi yakho.</translation>
<translation id="3451115285585441894">Ingeza ku-Taktak...</translation>
<translation id="345171907106878721">Zingeze ngokwakho ku-Taktak</translation>
<translation id="3453763134178591239">Imigomo ye-ChromeOS</translation>
<translation id="3503306920980160878">I-Taktak idinga ukufinyelela kundawo yakho ukuze yabelane ngendawo yakho naleli sayithi</translation>
<translation id="3533694711092285624">Awekho amaphasiwedi alondoloziwe. I-Taktak ingahlola amaphasiwedi akho uma uwalondolozile.</translation>
<translation id="3541482654983822893">I-Taktak ayikwazi ukuhlola amaphasiwedi akho. Zama futhi emva kwamahora angu-24.</translation>
<translation id="3576528680708590453">Umlawuli wakho wesistimu ulungise i-Taktak Taktak ukuvula esinye isiphequluli ikufinyelela i-<ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="3582972582564653026">Vumelanisa uphinde wenze kube ngeyakho i-Taktak kumadivayisi akho onkana</translation>
<translation id="3583751698304738917">Usuvele ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" /> kwenye iphrofayela ye-Taktak</translation>
<translation id="358381413217813387">Sesha leli khasi ngeGoogle Lens</translation>
<translation id="3589519427766620380">Buza iGoogle Lens mayelana naleli khasi</translation>
<translation id="3595784445906693824">Ngena ngemvume ku-Taktak kuphrofayela entsha?</translation>
<translation id="3596080736082218006">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-Taktak ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-Taktak ukuze usebenzise isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-Taktak ukuze usebenzise isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-Taktak ukuze usebenzise isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3597003331831379823">Ihlulekile ukuqalisa isethaphu ngamalungelo aphakeme. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3622716124581627104">Thola izinto noma izindawo bese ukopisha noma uhumusha umbhalo. Uma usebenzisa iGoogle Lens, isithombe-skrini sekhasi sithunyelwa kuGoogle. <ph name="LEARN_MORE" /></translation>
<translation id="3622797965165704966">Manje sekulula ukusebenzisa i-Taktak nge-Akhawunti yakho ye-Taktak nakumakhompyutha abiwe.</translation>
<translation id="3635073343384702370">I-Taktak ingahlola amaphasiwedi akho uma uwalondolozile</translation>
<translation id="3667616615096815454">Ayikwazi ukufaka, uhlelo lokusebenza alwaziwa kuseva.</translation>
<translation id="3673813398384385993">I-Taktak ithole ukuthi i-"<ph name="EXTENSION_NAME" />" inohlelo olungayilungele ikhompyutha</translation>
<translation id="3697952514309507634">Amanye amaphrofayili e-Taktak</translation>
<translation id="3703994572283698466">I-ChromeOS yenziwe ukuthi isebenze ngesofthiwe yomthombo ovulekile owengeziwe<ph name="BEGIN_LINK_CROS_OSS" />isofthiwe yomthombo ovulekile<ph name="END_LINK_CROS_OSS" />, njengoba kunjalo <ph name="BEGIN_LINK_LINUX_OSS" />ngendawo yokuthuthukiswa kwe-Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="3716540481907974026">Uhlobo lwe-ChromeOS Flex</translation>
<translation id="3718181793972440140">Lokhu kuzosusa into engu-1 kusuka kule divayisi. kuze uthole idatha yakho emuva kwesikhathi, ngena ngemvume ku-Taktak njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="3723744677043446310">{NUM_EXTENSIONS,plural, =1{IChrome incoma ukuthi uyisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}one{IChrome incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}other{IChrome incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}}</translation>
<translation id="3756724684201900923">Funda kabanzi mayelana nokufaka iChrome</translation>
<translation id="3780814664026482060">I-Taktak - <ph name="PAGE_TITLE" /></translation>
<translation id="3785324443014631273">I-ChromeOS Flex ayikwazanga ukuvumelanisa idatha yakho ngenxa yephutha lokungena ngemvume.</translation>
<translation id="3795971588916395511">I-Taktak ChromeOS</translation>
<translation id="3809772425479558446">I-Taktak Taktak idinga i-Windows 7 noma ngaphezulu.</translation>
<translation id="3810973564298564668">Phatha</translation>
<translation id="383928141529488001">I-Taktak Taktak idinga ukufinyelela kwe-Bluetooth ukuze ihlole amadivayisi we-Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="386202838227397562">Sicela uvale wonke amawindi we-Taktak Taktak bese uzama futhi.</translation>
<translation id="3873044882194371212">Vula isixhumanisi kuwindi le-Taktak inco&amp;gnito</translation>
<translation id="3885770153807205175">Okokukhetha ulimi</translation>
<translation id="3889417619312448367">Khipha i-Taktak Taktak</translation>
<translation id="3892148308691398805">Kopisha umbhalo</translation>
<translation id="3941890832296813527">Iphutha lokufaka: Igama lefayela lesifaki alivumelekile noma alisekelwe.</translation>
<translation id="395904275706073188">Amakhasi avikelwe awakwazi ukufundwa. Zama ikhasi elehlukile.</translation>
<translation id="3968962723676998462">Bhala umushwana wokungena ozowusebenzisa futhi ulondoloze idatha yeChrome ku-akhawunti yakho, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="3973161977468201858">IGoogle Taktak ifuna ukusula idatha yakho Yomphathi Wephasiwedi yeGoogle. Thayipha iphasiwedi yakho yeWindows ukuze uvumele lokhu.</translation>
<translation id="400161754580828648">Ukuze wabelane ngesikrini sakho, vumela ukurekhodwa kwesikrini kweChrome Kumasethingi Ohlelo.</translation>
<translation id="4022972681110646219">Isikrini sokuhumusha</translation>
<translation id="4023601594785368013">Ulimi loqobo: <ph name="LANGUAGE" /></translation>
<translation id="4035053306113201399">I-ChromeOS idinga ukuqaliswa kabusha ukuze yenze kusebenze isibuyekezo.</translation>
<translation id="4050175100176540509">Ukuthuthukiswa kokuphepha okubalulekile nezici ezintsha kuyathokala kunguqulo yakamuva.</translation>
<translation id="4053720452172726777">Yenza ngokwezifiso futhi lawula i-Taktak Taktak</translation>
<translation id="408393047846373801">Ukuze uthole amaphasiwedi akho kanye nokwengeziwe kuwo wonke amadivayisi akho, ngena ngemvume kuChrome. Le phasiwedi izolondolozwa kuGoogle Account yakho ngemva kokungena ngemvume.</translation>
<translation id="409936259433005390">Uthuthukela kuWindows 11 maduze? Dawuniloda Isifaki SeChrome ku-OneDrive ukuze ukulungele kusukela osukwini lokuqala.</translation>
<translation id="4110895483821904099">Setha iphrofayela yakho entsha ye-Taktak</translation>
<translation id="4111566860456076004">I-Taktak ayikwazi ukuqinisekisa ukuthi lesi sandiso sivelaphi, futhi kungenzeka ukuthi asiphephile. Sisuse ku-Taktak ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lomuntu siqu.</translation>
<translation id="4128488089242627000">I-Taktak iyashesha ukuqalisa futhi izathi ezisebenzisa i-JavaScript kufanele zisebenze njengoba ziklanyiwe (okunconywayo)</translation>
<translation id="4147555960264124640">Ungena ngemvume nge-akhawunti ephethwe futhi unikeza umlawuli wayo ukulawula okungaphezulu kwephrofayela yakho ye-Taktak Taktak. Idatha yakho ye-Taktak, efana nezinhlelo zokusebenza zakho, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshezelwa ngonaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Taktak ama-Akhawunti we-Ideshibhodi, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. <ph name="LEARN_MORE" /></translation>
<translation id="4148957013307229264">Iyafaka...</translation>
<translation id="4149882025268051530">Isifaki sihlulekile ukungaminyanisi ingobo yomlando. Sicela ulande i-Taktak Taktak futhi.</translation>
<translation id="415112847282352845">Ukuze uthole amakheli akho nokwengeziwe kuwo wonke amadivayisi akho, ngena ngemvume kuChrome. Leli kheli lizolondolozwa kuGoogle Account yakho ngemva kokungena ngemvume.</translation>
<translation id="4153934450158521343">I-Taktak izovala maduzane futhi isule idatha</translation>
<translation id="4173512894976930765">Amasayithi cishe azosebenza njengokulindelwe. Uzophuma ngemvume kumasayithi amaningi uma uvala wonke amawindi e-Taktak, ngaphandle kwe-Taktak Account yakho uma ungene ngemvume ku-Taktak.</translation>
<translation id="4175922240926474352">I-Taktak ivimbele lokhu kulanda ngoba isayithi alisebenzisi uxhumano oluvikelekile futhi kungenzeka ukuthi ifayela lonaniwe.</translation>
<translation id="4191857738314598978">{0,plural, =1{Qalisa kabusha i-Taktak phakathi nosuku}one{Qalisa kabusha i-Taktak phakathi kwezinsuku ezingu-#}other{Qalisa kabusha i-Taktak phakathi kwezinsuku ezingu-#}}</translation>
<translation id="4205939740494406371">I-Taktak ayikwazi ukuhlola amaphasiwedi akho. Zama futhi ngemva kwamahora angu-24 noma <ph name="BEGIN_LINK" />hlola amaphasiwedi ku-akhawunti yakho ye-Taktak<ph name="END_LINK" />.</translation>
<translation id="4222932583846282852">Iyakhansela...</translation>
<translation id="4224210481850767180">Ukufaka kukhanseliwe.</translation>
<translation id="4230631012078055975">Thola okwengeziwe uma ungene ngemvume kuChrome</translation>
<translation id="4242034826641750751">I-Taktak idinga izimvume zekhamera nemakrofoni kule sayithi</translation>
<translation id="424864128008805179">Phuma ngemvume ku-Taktak?</translation>
<translation id="4251615635259297716">Xhumanisa idatha yakho ye-Taktak kule akhawunti?</translation>
<translation id="4281844954008187215">Imigomo yesevisi</translation>
<translation id="4293420128516039005">Ngena ngemvume ukuze uvumelanise uphinde wenze kube ngeyakho i-Taktak kuwo onke amadivayisi akho</translation>
<translation id="430327780270213103">Vumela isandiso ukuze ubonise izicelo zokufinyelela kubha yamathuluzi ye-Taktak</translation>
<translation id="4326552909330437744">{NUM_TABS,plural, =1{IChromium Incoma Ukumisa Ithebhu Enciphisa Ijubane Lebhrawuza Yakho}one{IChromium Incoma Ukumisa Amathebhu Anciphisa Ijubane Lebhrawuza Yakho}other{IChromium Incoma Ukumisa Amathebhu Anciphisa Ijubane Lebhrawuza Yakho}}</translation>
<translation id="4328355335528187361">I-Taktak Taktak Dev (mDNS-In)</translation>
<translation id="4329315893554541805">Ukuze uthole ukwenza ngokomuntu ngamunye nezinye izakhi, ezifaka i-Taktak Kumsebenzi wewebhu nowe-app nakumasevisi alinkiwe e-Taktak</translation>
<translation id="4334241893986177674">Sesha lesi sithombe-skrini</translation>
<translation id="4334294535648607276">Ukulanda kuqedile.</translation>
<translation id="4337324600316876133">Ukuze uthole izibuyekezo ezizayo zeGoogle Taktak, uzodinga i-macOS 12 noma eyakamuva. Le khompyutha isebenzisa i-macOS 11.</translation>
<translation id="4343195214584226067">I-<ph name="EXTENSION_NAME" /> ingezwe ku-Taktak</translation>
<translation id="4348548358339558429">Ukuze uthole ukwenza ngokomuntu ngamunye, okufaka i-Taktak Kumsebenzi Wewebhu nowe-App</translation>
<translation id="436060642166082913">I-Taktak ivimbele lokhu kudawuniloda ngoba ifayela lingalimaza ama-akhawunti wakho omuntu siqu nawenethiwekhi yokuxhumana nomphakathi</translation>
<translation id="4367027658822022112">Ungaphina iGoogle Lens ukuze uyifinyelele kalula; chofoza inkinobho Yokuphina phezulu kwephaneli eseceleni</translation>
<translation id="4389991535395284064">Uma ubhrawuza ngemodi ye-Incognito, i-Taktak izokuxwayisa ngaphambi kokulayisha isayithi isebenzisa uxhumo olungavikelekile.</translation>
<translation id="4427306783828095590">Isivikelo esithuthukisiwe senza okuningi ukuvimba ubugebengu bokweba imininingwane ebucayi kanye uhlelo olungayilungele ikhompyutha</translation>
