<translation id="1874309113135274312">I-beta yeGoogle Taktak (mDNS-In)</translation>
<translation id="1877026089748256423">I-Taktak ingaphandle kwedethi</translation>
<translation id="1880677175115548835">Khetha umbhalo</translation>
<translation id="1919130412786645364">Vumela ukungena ngemvume kwe-Taktak</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE" /></translation>
<translation id="2001586581944147178">Kwenze kube nzima kubantu abanokufinyelela kuthrafikhi yakho ye-inthanethi ukuze babone ukuthi imaphi amasayithi owavakashelayo. I-Taktak isebenzisa ukuxhuma okuvikelekile ukuze ibheke ikheli lasesizindeni se-inthanethi lesayithi ku-DNS (Isistimu Yokwetha Isizinda).</translation>
<translation id="2008942457798486387">{NUM_EXTENSIONS,plural, =1{Lesi sandiso asisasekelwa. IChrome incoma ukuthi usisuse.}one{Lezi zandiso azisasekelwa. IChrome incoma ukuthi uzisuse.}other{Lezi zandiso azisasekelwa. IChrome incoma ukuthi uzisuse.}}</translation>
<translation id="2018528049276128029">Iphrofayela ngalinye linolwazi lwayo lwe-Taktak njengamabhukhimakhi, umlando, amaphasiwedi, nokuningi</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="2024959665595762054">Ukuze usebenzise futhi ulondoloze idatha yeChrome kuGoogle Account yakho, qinisekisa ukuthi nguwe</translation>
<translation id="2034233344106846793">IChrome ithuthukisa ukuxhuma okungavikelekile ku-HTTPS ngokuzenzekelayo lapho kungenzeka</translation>
<translation id="207902854391093810">Lapho imizamo ivuliwe, Isilinganiso sesikhangiso sivumela amasayithi owavakashelayo ukuba acele ulwazi ku-Taktak olusiza isayithi ukukala ukusebenza kwezikhangiso zawo. Isilinganiso sesikhangiso sikhawulela ukulandelela indawo yonke ngokudlulisa ulwazi oluncane ngangokunokwenzeka phakathi kwamasayithi.</translation>
<translation id="2091012649849228750">Ukuze uthole izibuyekezo zesikhathi esizayo ze-Taktak Taktak, uzodinga i-Windows 10 noma yakamuva. Le khompyutha isebenzisa i-Windows 8.</translation>
<translation id="2094648590148273905">Imigomo ye-ChromeOS Flex</translation>
<translation id="2094919256425865063">Yekela i-Taktak yize kunjalo?</translation>
<translation id="2096213354152647998">Awukavakashi kamuva nje. IChrome isuse i-<ph name="PERMISSION" />.</translation>
<translation id="2106831557840787829">I-ChromeOS Flex yenzeka <ph name="BEGIN_LINK_CROS_OSS" />ngenxa yesofthiwe yomthombo ovulekile eyengeziwe<ph name="END_LINK_CROS_OSS" />, njengoba kunjalo <ph name="BEGIN_LINK_LINUX_OSS" />ngendawo yokuthuthukiswa kwe-Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="2108778574543343055">Vala iChrome Esebenza Ngemuva kuma-App</translation>
<translation id="2120620239521071941">Lokhu kuzosusa izinto ezingu-<ph name="ITEMS_COUNT" /> kusuka kule divayisi. kuze uthole idatha yakho emuva kwesikhathi, ngena ngemvume ku-Taktak njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="2121284319307530122">Qalisa kabusha ukuze Ubuyekeze i-&amp;Taktak</translation>
<translation id="2123055963409958220">Siza ukwenza i-Taktak ibengcono ngokubika <ph name="BEGIN_LINK" />izilungiselelo zamanje<ph name="END_LINK" /></translation>
<translation id="2126108037660393668">Ifayela elidawunilodiwe aliphumelelanga lapho liqinisekiswa.</translation>
<translation id="2128411189117340671">Phatha amaphrofayela e-Taktak</translation>
<translation id="2131230230468101642">Ukuze sivikele ubumfihlo bakho, sisula ngokuzenzakalelayo izintshisekelo zakho ezindala kunamaviki ama-4. Njengoba uqhubeka nokubhrawuza, intshisekelo ingase ivele ohlwini futhi. Noma ungasusa izithakazelo ongafuni ukuthi i-Taktak izicabangele.</translation>
<translation id="2137162749895930932">Vala isikrini sokuhumusha</translation>
<translation id="2139300032719313227">Qalisa kabusha i-ChromeOS</translation>
<translation id="2151406531797534936">Sicela uqalise kabusha -Taktak manje</translation>
<translation id="2163089732491971196">Ukuze usebenzise futhi ulondoloze idatha ye-Taktak ku-Taktak Account yakho, faka umushwana wakho wokungena</translation>
<translation id="2174917724755363426">Ukufaka akuqediwe. Uqinisekile ufuna ukukhansela?</translation>
<translation id="2186206192313702726">Taktak Lens</translation>
<translation id="2190166659037789668">Buyekeza iphutha lokuchekha: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199691482078155239">I-Taktak ikunikeza ukulawula okwengeziwe ezikhangisweni ozibonayo futhi ikhawulela lokho amasayithi angakufunda ngawe uma ekubonisa izikhangiso eziqondene nawe</translation>
<translation id="2216543877350048334">Ukuze ususe i-Taktak Account yakho ku-Taktak, phuma ngemvume</translation>
<translation id="2236949375853147973">Umsebenzi Wami</translation>
<translation id="2290014774651636340">Okhiye be-Taktak API abekho. Okunye ukusebenza kwe-Taktak Taktak kuzokhutshazwa.</translation>
<translation id="2290095356545025170">Ingabe uqinisekile ukuthi ufuna ukukhipha i-Taktak Taktak?</translation>
<translation id="2301513536169703857">Ukuze uthole amaphasiwedi akho, amabhukhimakhi, nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuChrome.</translation>
<translation id="2309047409763057870">Lokhu ukufakwa kwesibili kwe-Taktak Taktak, futhi akukwazi ukwenziwa isiphequluli sakho esizenzakalelayo.</translation>
<translation id="2345992953227471816">I-Taktak ithole ukuthi lezi zandiso zinohlelo olungayilungele ikhompyutha:</translation>
<translation id="2348335408836342058">I-Taktak idinga imvume ukuze ifinyelele kukhamera yakho nemakrofoni yaleli sayithi</translation>
<translation id="234869673307233423">I-Taktak ayikwazi ukuhlola amaphasiwedi akho. Zama futhi emuva kwesikhathi.</translation>
<translation id="2359808026110333948">Qhubeka</translation>
<translation id="2403703063067034158">Iphutha lokuqala: esinye isenzakalo sokusetha siyaqalisa okwamanje, sicela uzame futhi ngokuhamba kwesikhathi.</translation>
<translation id="2409816192575564775">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-HID ibifinyelelwa yisandiso se-Taktak esisodwa noma eziningi}=1{Idivayisi e-1 ye-HID ifinyelelwa yisandiso se-Taktak esisodwa noma eziningi}one{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-Taktak esisodwa noma eziningi}other{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-Taktak esisodwa noma eziningi}}</translation>
<translation id="2424440923901031101">Lesi sandiso sephula inqubomgomo Yesitolo sewebu se-Taktak, futhi kungenzeka singabi esiphephile. Sisuse ku-Taktak ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="2467438592969358367">I-Taktak Taktak ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="2472092250898121027">Lesi sandiso sinohlelo olungayilungele ikhompyutha futhi asiphephile. Sisuse ku-Taktak ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="2485422356828889247">Khipha</translation>
<translation id="2513154137948333830">Ukuqalisa kuyadingeka: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2534365042754120737">Ukuvikela idatha lakho vumela i-Taktak isuse izimvume kumasayithi ongakawavakasheli muva nje. Ayizimisi izaziso.</translation>
<translation id="2556847002339236023">Inhlangano yakho ivala i-Taktak uma ingasetshenziswa isikhathi eingu-<ph name="TIMEOUT_DURATION" />. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.</translation>
<translation id="2559253115192232574">Kamuva, isayithi olivakashelayo lingacela i-Taktak ukuthi ibone izintshisekelo zakho ukuze yenze izikhangiso ozibonayo ngokwezifiso zakho. I-Taktak ikwazi ukwabelana ngezintshisekelo ezifika ku-3.</translation>
<translation id="2563121210305478421">Qalisa kabusha i-Taktak?</translation>
<translation id="2569974318947988067">I-Taktak izozama ukuthuthukisa ukufuna ukuya ku-HTTPS</translation>
<translation id="2571392474191184472">Inhlangano yakho iphatha iChrome</translation>
<translation id="2574930892358684005">U-<ph name="EXISTING_USER" /> usengenile ngemvume kakade kule phrofayela ye-Taktak. Ukuze uqhubeke nokuphequlula ngokwehlukile, i-Taktak ingakwazi ukukudalela iphrofayela yakho.</translation>
<translation id="2579190314336775785">Amaphasiwedi angasulwa kuphela ngaphandle kweChrome</translation>
<translation id="2580411288591421699">Ayikwazi ukufaka inguqulo ye-Taktak Taktak efana nalena esebenza manje. Sicela uvale i-Taktak Taktak uphinde uzame futhi.</translation>
<translation id="2586406160782125153">Lokhu kuzosusa idatha yakho yokuphequlula kusukela kule divayisi. Ukuze uthole idatha yakho emuva kwesikhathi, ngena ngemvume ku-Taktak njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="259935314519650377">Yehlulekile ukufaka enqolobaneni isifaki esidawunilodiwe. Iphutha: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Isistimu</translation>
<translation id="2645435784669275700">I-ChromeOS</translation>
<translation id="2649768380733403658">I-Taktak ihlale ihlola ukuze iqinisekise ukuthi ibhrawuza inamasethingi aphephe kakhulu. Sizokwazisa uma kukhona okudinga ukubuyekezwa.</translation>
<translation id="2652691236519827073">Vula isixhumanisi ku&amp;thebhu entsha ye-Taktak</translation>
<translation id="2665296953892887393">Siza wenze i-Taktak Taktak ibe ngcono ngokuthumela imibiko yokuphahlazeka ne-<ph name="UMA_LINK" /> ku-Taktak</translation>
<translation id="2668094785979141847">Chofoza ukuze uphume ku-Taktak Lens</translation>
<translation id="2681444469812712297">Vula i-<ph name="URL" /> ethebhini entsha ye-Taktak Taktak.</translation>
<translation id="2712141162840347885">Khetha noma yini ukuze useshe ngeGoogle Lens noma ucindezele okuthi escape ukuze uphume kuGoogle Lens</translation>
<translation id="2738871930057338499">Ayikwazi ukuxhuma ku-inthanethi I-HTTP 403 Yenqatshelwe. Sicela uchekhe ukulungiselelwa kommeleli wakho.</translation>
<translation id="2742320827292110288">Isexwayiso: I-Taktak Taktak ayikwazi ukuvimbela izandiso kusukela ekurekhodeni umlando wesiphequluli sakho. Ukuze ukhubaze lesi sandiso kumodi ye-incognito, yekisa ukukhetha le nketho.</translation>
<translation id="2753623023919742414">Chofoza ukuze useshe</translation>
<translation id="2765403129283291972">I-Taktak idinga imvume ukuze ifinyelele kukhamera yakho kuleli sayithi</translation>
<translation id="2770231113462710648">Guqula isiphequluli esizenzakalelayo sibe yi-:</translation>
<translation id="2775140325783767197">I-Taktak ayikwazi ukuhlola amaphasiwedi akho. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="2797864378188255696">Uma ungena ngemvume kumasevisi eGoogle afana neGmail noma iYouTube nge-<ph name="USER_EMAIL" />, ungangena ngemvume ngokuzenzakalela kuChrome nge-akhawunti efanayo</translation>
<translation id="2799162042226656283">IChrome Yakho</translation>
<translation id="2799223571221894425">Qalisa kabusha</translation>
